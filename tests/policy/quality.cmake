# Fault prevented: policy edits, forged baselines or old waivers bypassing actual bounds.
cmake_minimum_required(VERSION 4.3)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
set(ENV{SOURCE_DATE_EPOCH} 1769904000)
string(REPEAT "a" 40 head)
string(REPEAT "b" 40 base)
set(metric [=[{"ceiling":10,"direction":"ceiling","units":"findings","producer":"judge","configuration":"fixture","availability":"required"}]=])
set(policy "{\"metrics\":{\"warnings\":${metric}}}")
set(observation "{\"units\":\"findings\",\"producer\":\"judge\",\"configuration\":\"fixture\",\"sha\":\"${head}\",\"source\":\"https://github.com/example/public/actions/runs/1\",\"status\":\"measured\",\"value\":10}")
set(observations "{\"metrics\":{\"warnings\":${observation}}}")
string(REPLACE "${head}" "${base}" baseline "${observations}")
foreach(case gate_initial gate_wrong gate_existing equal waived inherited_valid restored introduced floor floor_regression floor_loosen regression string malformed missing sha config loosen deletion advisory identity new forged expired inherited calendar lifetime future unrelated renewal conversion)
  set(p "${policy}")
  set(b "${policy}")
  set(o "${observations}")
  set(h "${baseline}")
  set(regex "quality:")
  if(case MATCHES "^gate_")
    foreach(input p b o h)
      string(REPLACE warnings gate_lines ${input} "${${input}}")
    endforeach()
    if(case STREQUAL "gate_existing")
      string(JSON p SET "${p}" metrics gate_lines ceiling 11)
      set(regex "quality: unexplained loosening")
    else()
      set(b "{\"metrics\":{}}")
      string(JSON h REMOVE "${h}" metrics gate_lines value)
      string(JSON h SET "${h}" metrics gate_lines status "\"unavailable\"")
      string(JSON h SET "${h}" metrics gate_lines reason "\"pre-policy fixture\"")
    endif()
  elseif(case MATCHES "^floor")
    foreach(input p b)
      string(JSON ${input} REMOVE "${${input}}" metrics warnings ceiling)
      string(JSON ${input} SET "${${input}}" metrics warnings floor 10)
      string(JSON ${input} SET "${${input}}" metrics warnings direction "\"floor\"")
    endforeach()
    if(case STREQUAL "floor_regression")
      string(JSON o SET "${o}" metrics warnings value 9)
      set(regex "quality: measured regression warnings")
    elseif(case STREQUAL "floor_loosen")
      string(JSON p SET "${p}" metrics warnings floor 9)
      set(regex "quality: unexplained loosening")
    endif()
  elseif(case STREQUAL "introduced")
    set(b "{\"metrics\":{}}")
  elseif(case STREQUAL "regression")
    string(JSON o SET "${o}" metrics warnings value 11)
    set(regex "quality: measured regression warnings")
  elseif(case STREQUAL "string")
    string(JSON o SET "${o}" metrics warnings value "\"10\"")
    set(regex "quality: typed NUMBER")
  elseif(case STREQUAL "malformed")
    set(o "not JSON")
    set(regex "quality: typed OBJECT")
  elseif(case STREQUAL "missing")
    string(JSON o REMOVE "${o}" metrics warnings)
  elseif(case STREQUAL "sha")
    set(o "${baseline}")
    set(regex "quality: commit or source mismatch")
  elseif(case STREQUAL "config")
    string(JSON o SET "${o}" metrics warnings configuration "\"other\"")
    set(regex "quality: observation identity")
  elseif(case STREQUAL "loosen")
    string(JSON p SET "${p}" metrics warnings ceiling 11)
    set(regex "quality: unexplained loosening")
  elseif(case STREQUAL "deletion")
    string(JSON p REMOVE "${p}" metrics warnings)
  elseif(case STREQUAL "advisory" OR case STREQUAL "identity")
    set(field availability)
    if(case STREQUAL "identity")
      set(field producer)
    endif()
    string(JSON p SET "${p}" metrics warnings ${field} "\"advisory\"")
  elseif(case STREQUAL "new" OR case STREQUAL "forged")
    set(b "{\"metrics\":{}}")
    if(case STREQUAL "new")
      string(JSON h REMOVE "${h}" metrics warnings)
    else()
      set(h "${observations}")
      set(regex "quality: commit or source mismatch")
    endif()
  elseif(NOT case STREQUAL "equal")
    set(reason [=[{"key":"warnings","from":10,"to":11,"why":"temporary regression","date":"2026-01-01","expires":"2026-01-31"}]=])
    string(JSON p SET "${p}" metrics warnings ceiling 11)
    if(case MATCHES "^(unrelated|waived|inherited_valid|restored)$")
      string(JSON reason SET "${reason}" expires "\"2026-02-15\"")
    endif()
    if(case STREQUAL "calendar")
      string(JSON reason SET "${reason}" date "\"2026-02-30\"")
      set(regex "quality: invalid calendar")
    elseif(case STREQUAL "lifetime")
      string(JSON reason SET "${reason}" expires "\"2026-04-01\"")
    elseif(case STREQUAL "future")
      string(JSON reason SET "${reason}" date "\"2026-02-02\"")
    elseif(case STREQUAL "unrelated")
      string(JSON reason SET "${reason}" to 12)
      set(regex "quality: unrelated reason")
    endif()
    string(JSON p SET "${p}" reasons "[${reason}]")
    if(case STREQUAL "inherited" OR case STREQUAL "inherited_valid" OR case STREQUAL "restored")
      set(b "${p}")
      if(case STREQUAL "restored")
        set(p "${policy}")
      endif()
    elseif(case STREQUAL "renewal" OR case STREQUAL "conversion")
      string(JSON reason SET "${reason}" expires "\"2026-02-15\"")
      string(JSON b SET "${p}" reasons "[${reason}]")
      if(case STREQUAL "renewal")
        string(JSON p SET "${b}" reasons 0 expires "\"2026-02-16\"")
        set(regex "quality: reason renewal")
      else()
        string(JSON p REMOVE "${b}" reasons)
        set(regex "quality: unexplained loosening")
      endif()
    endif()
  endif()
  foreach(input p b o h)
    file(WRITE "${WORK}/${input}.json" "${${input}}\n")
  endforeach()
  set(cmd "${CMAKE_COMMAND}" -DPOLICY=${WORK}/p.json -DBASE_POLICY=${WORK}/b.json
    -DOBSERVATIONS=${WORK}/o.json -DBASELINE=${WORK}/h.json -DEXPECTED_SHA=${head}
    -DBASE_SHA=${base} -P "${ROOT}/tests/cmake/quality.cmake")
  if(case MATCHES "^gate_")
    list(INSERT cmd 1 -DINITIAL_GATE_CEILING=10)
    if(case STREQUAL "gate_wrong")
      list(INSERT cmd 2 -DINITIAL_GATE_CEILING=9)
    endif()
  endif()
  if(case MATCHES "^(gate_initial|equal|waived|inherited_valid|restored|introduced|floor)$")
    execute_process(COMMAND ${cmd} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT rc STREQUAL "0" OR NOT out MATCHES "10 findings")
      message(FATAL_ERROR "quality assertion: valid measurement report expected, got ${rc}: ${out}")
    endif()
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1 "-DREGEX=${regex}"
      -P "${ROOT}/tests/cmake/expect_fail.cmake" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
set(cmd "${CMAKE_COMMAND}" -DROOT=${ROOT} -DBUILD=${WORK}/absent -DOUT=${WORK}/evidence.json
  -DSHA=${head} -DCONFIG=ci -P "${ROOT}/tests/cmake/quality_evidence.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1
  "-DREGEX=quality_evidence: missing junit" -P "${ROOT}/tests/cmake/expect_fail.cmake"
  COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${WORK}/absent/junit.xml" "<testsuite/>\n")
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1
  "-DREGEX=quality_evidence: built SHA mismatch" -P "${ROOT}/tests/cmake/expect_fail.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${WORK}/absent/CMakeCache.txt" "CMAKE_HOME_DIRECTORY:INTERNAL=wrong\n")
list(TRANSFORM cmd REPLACE "^-DSHA=.*" "-DSHA=${actual}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1
  "-DREGEX=quality_evidence: build configuration mismatch" -P "${ROOT}/tests/cmake/expect_fail.cmake" COMMAND_ERROR_IS_FATAL ANY)

# A smaller lane must not hide a missing/forged observation behind another lane's maximum.
string(REPLACE fixture native p "${policy}")
string(REPLACE fixture native o "${observations}")
string(JSON o SET "${o}" metrics warnings direction "\"ceiling\"")
string(REPLACE "${head}" "${base}" h "${o}")
string(JSON o SET "${o}" environment "\"same-tool-and-fixtures\"")
string(JSON h SET "${h}" environment "\"same-tool-and-fixtures\"")
file(WRITE "${WORK}/join-policy.json" "${p}")
set(dir "${WORK}/join")
set(cmd "${CMAKE_COMMAND}" -DDIRECTORY=${dir} -DOUT=${WORK}/joined -DPOLICY=${WORK}/join-policy.json
  -DBASE_POLICY=${WORK}/join-base-policy.json -DEXPECTED_SHA=${head} -DBASE_SHA=${base}
  -DSOURCE=https://github.com/example/public/actions/runs/1 -P "${ROOT}/tests/cmake/quality_join.cmake")
foreach(case equal omission forged missing base environment regression adoption)
  set(join_policy "${p}")
  set(join_base "${p}")
  set(current "${o}")
  set(prior "${h}")
  if(case STREQUAL "adoption")
    foreach(input join_policy current prior)
      string(REPLACE warnings gate_lines ${input} "${${input}}")
    endforeach()
    string(JSON join_policy SET "${join_policy}" metrics gate_lines ceiling 15153)
    set(join_base "{\"metrics\":{}}")
    string(JSON prior REMOVE "${prior}" metrics gate_lines value)
    string(JSON prior SET "${prior}" metrics gate_lines status "\"unavailable\"")
    string(JSON prior SET "${prior}" metrics gate_lines reason "\"pre-policy fixture\"")
  endif()
  file(WRITE "${WORK}/join-policy.json" "${join_policy}")
  file(WRITE "${WORK}/join-base-policy.json" "${join_base}")
  file(REMOVE_RECURSE "${dir}")
  foreach(lane asan hygiene linux-arm64 linux-x64 macos-arm64 macos-x64 windows-arm64 windows-x64)
    file(WRITE "${dir}/quality-${lane}/quality-current.json" "${current}")
    file(WRITE "${dir}/quality-${lane}/quality-base.json" "${prior}")
    file(WRITE "${dir}/quality-${lane}/quality-base-policy.json" "${join_base}")
    file(WRITE "${dir}/quality-${lane}/quality-base-sha.txt" "${base}\n")
  endforeach()
  set(changed "${current}")
  set(regex "quality: commit or source mismatch warnings;[ \r\n]+sha=${base},[ \r\n]+expected=${head}")
  if(case STREQUAL "omission")
    file(REMOVE_RECURSE "${dir}/quality-asan")
    set(regex "quality_join: exact artifact set")
  elseif(case STREQUAL "forged")
    string(JSON changed SET "${changed}" metrics warnings sha "\"${base}\"")
  elseif(case STREQUAL "missing")
    string(JSON changed REMOVE "${changed}" metrics warnings)
    set(regex "quality: typed OBJECT")
  elseif(case STREQUAL "base")
    file(WRITE "${dir}/quality-windows-x64/quality-base-sha.txt" "${head}")
    set(regex "quality_join: trusted base mismatch")
  elseif(case STREQUAL "environment")
    string(JSON changed SET "${changed}" environment "\"other-tool\"")
    set(regex "quality_join: incomparable environment")
  elseif(case STREQUAL "regression")
    string(JSON changed SET "${changed}" metrics warnings value 11)
    set(regex "quality: measured regression warnings")
  endif()
  file(WRITE "${dir}/quality-windows-x64/quality-current.json" "${changed}")
  if(case MATCHES "^(equal|adoption)$")
    execute_process(COMMAND ${cmd} COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1 "-DREGEX=${regex}"
      -P "${ROOT}/tests/cmake/expect_fail.cmake" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
