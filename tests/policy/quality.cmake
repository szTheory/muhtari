# Fault prevented: policy edits, forged baselines or old waivers bypassing actual bounds.
cmake_minimum_required(VERSION 4.3)
file(MAKE_DIRECTORY "${WORK}")
set(ENV{SOURCE_DATE_EPOCH} 1769904000)
string(REPEAT "a" 40 head)
string(REPEAT "b" 40 base)
set(metric [=[{"ceiling":10,"direction":"ceiling","units":"findings","producer":"judge","configuration":"fixture","availability":"required"}]=])
set(policy "{\"metrics\":{\"warnings\":${metric}}}")
set(observation "{\"units\":\"findings\",\"producer\":\"judge\",\"configuration\":\"fixture\",\"sha\":\"${head}\",\"source\":\"https://github.com/example/public/actions/runs/1\",\"status\":\"measured\",\"value\":10}")
set(observations "{\"metrics\":{\"warnings\":${observation}}}")
string(REPLACE "${head}" "${base}" baseline "${observations}")
foreach(case equal waived inherited_valid restored introduced floor floor_regression floor_loosen regression string malformed missing sha config loosen deletion advisory identity new forged expired inherited calendar lifetime future unrelated renewal conversion)
  set(p "${policy}")
  set(b "${policy}")
  set(o "${observations}")
  set(h "${baseline}")
  set(regex "quality:")
  if(case MATCHES "^floor")
    foreach(input p b)
      string(JSON ${input} REMOVE "${${input}}" metrics warnings ceiling)
      string(JSON ${input} SET "${${input}}" metrics warnings floor 10)
      string(JSON ${input} SET "${${input}}" metrics warnings direction "\"floor\"")
    endforeach()
    if(case STREQUAL "floor_regression")
      string(JSON o SET "${o}" metrics warnings value 9)
      set(regex "quality: measured regression warnings")
    elseif(case STREQUAL "floor_loosen")
      string(JSON p SET "${p}" metrics warnings floor 9)
      set(regex "quality: unexplained loosening")
    endif()
  elseif(case STREQUAL "introduced")
    set(b "{\"metrics\":{}}")
  elseif(case STREQUAL "regression")
    string(JSON o SET "${o}" metrics warnings value 11)
    set(regex "quality: measured regression warnings")
  elseif(case STREQUAL "string")
    string(JSON o SET "${o}" metrics warnings value "\"10\"")
    set(regex "quality: typed NUMBER")
  elseif(case STREQUAL "malformed")
    set(o "not JSON")
    set(regex "quality: typed OBJECT")
  elseif(case STREQUAL "missing")
    string(JSON o REMOVE "${o}" metrics warnings)
  elseif(case STREQUAL "sha")
    set(o "${baseline}")
    set(regex "quality: commit or source mismatch")
  elseif(case STREQUAL "config")
    string(JSON o SET "${o}" metrics warnings configuration "\"other\"")
    set(regex "quality: observation identity")
  elseif(case STREQUAL "loosen")
    string(JSON p SET "${p}" metrics warnings ceiling 11)
    set(regex "quality: unexplained loosening")
  elseif(case STREQUAL "deletion")
    string(JSON p REMOVE "${p}" metrics warnings)
  elseif(case STREQUAL "advisory" OR case STREQUAL "identity")
    set(field availability)
    if(case STREQUAL "identity")
      set(field producer)
    endif()
    string(JSON p SET "${p}" metrics warnings ${field} "\"advisory\"")
  elseif(case STREQUAL "new" OR case STREQUAL "forged")
    set(b "{\"metrics\":{}}")
    if(case STREQUAL "new")
      string(JSON h REMOVE "${h}" metrics warnings)
    else()
      set(h "${observations}")
      set(regex "quality: commit or source mismatch")
    endif()
  elseif(NOT case STREQUAL "equal")
    set(reason [=[{"key":"warnings","from":10,"to":11,"why":"temporary regression","date":"2026-01-01","expires":"2026-01-31"}]=])
    string(JSON p SET "${p}" metrics warnings ceiling 11)
    if(case MATCHES "^(unrelated|waived|inherited_valid|restored)$")
      string(JSON reason SET "${reason}" expires "\"2026-02-15\"")
    endif()
    if(case STREQUAL "calendar")
      string(JSON reason SET "${reason}" date "\"2026-02-30\"")
      set(regex "quality: invalid calendar")
    elseif(case STREQUAL "lifetime")
      string(JSON reason SET "${reason}" expires "\"2026-04-01\"")
    elseif(case STREQUAL "future")
      string(JSON reason SET "${reason}" date "\"2026-02-02\"")
    elseif(case STREQUAL "unrelated")
      string(JSON reason SET "${reason}" to 12)
      set(regex "quality: unrelated reason")
    endif()
    string(JSON p SET "${p}" reasons "[${reason}]")
    if(case STREQUAL "inherited" OR case STREQUAL "inherited_valid" OR case STREQUAL "restored")
      set(b "${p}")
      if(case STREQUAL "restored")
        set(p "${policy}")
      endif()
    elseif(case STREQUAL "renewal" OR case STREQUAL "conversion")
      string(JSON reason SET "${reason}" expires "\"2026-02-15\"")
      string(JSON b SET "${p}" reasons "[${reason}]")
      if(case STREQUAL "renewal")
        string(JSON p SET "${b}" reasons 0 expires "\"2026-02-16\"")
        set(regex "quality: reason renewal")
      else()
        string(JSON p REMOVE "${b}" reasons)
        set(regex "quality: unexplained loosening")
      endif()
    endif()
  endif()
  foreach(input p b o h)
    file(WRITE "${WORK}/${input}.json" "${${input}}\n")
  endforeach()
  set(cmd "${CMAKE_COMMAND}" -DPOLICY=${WORK}/p.json -DBASE_POLICY=${WORK}/b.json
    -DOBSERVATIONS=${WORK}/o.json -DBASELINE=${WORK}/h.json -DEXPECTED_SHA=${head}
    -DBASE_SHA=${base} -P "${ROOT}/tests/cmake/quality.cmake")
  if(case MATCHES "^(equal|waived|inherited_valid|restored|introduced|floor)$")
    execute_process(COMMAND ${cmd} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "quality assertion: bound equality expected success, got ${rc}: ${out}")
    endif()
  else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCMD=${cmd}" -DCODE=1 "-DREGEX=${regex}"
      -P "${ROOT}/tests/cmake/expect_fail.cmake" COMMAND_ERROR_IS_FATAL ANY)
  endif()
endforeach()
