    "${CMAKE_COMMAND}" -DROOT=${repo} -DBUILD=${repo}/build/ci -DOUT=${WORK}/produced.json
    -DSHA=${producer_head} -DCONFIG=ci -DSOURCE=${run} -DBUILD_BASE=ON
    -P "${ROOT}/tests/cmake/quality_evidence.cmake")
  if(case STREQUAL "forged")
    # Candidate-supplied trust inputs cannot replace independently resolved Git bytes.
    list(INSERT produce 10 -DFIXTURE_TRUSTED=${repo}/tests/roms/manifest.txt -Dfixture=${digest})
  elseif(case MATCHES "^sample_forged4?$")
    list(INSERT produce 10 -DSAMPLE_TRUSTED=${repo}/tests/built/expected.txt -Dsamples=${digest})
  endif()
  if(NOT case MATCHES "^(unchanged|additions|push|dispatch|later_base|compiler|platform|producer_base|producer_run|producer_identity|samples|sample_revision|sample_next|sample_equal4)$")
    quality_expect_failure("${regex}" ${produce})
    continue()
  endif()
  # Only the preceding owned base worktree needs retiring before recursion;
  # fail-fast input controls require neither pruning nor reconfiguration.
  if(EXISTS "${repo}/build/ci/quality-base")
    file(REMOVE_RECURSE "${repo}/build/ci/quality-base")
    execute_process(COMMAND git -C "${repo}" worktree prune COMMAND_ERROR_IS_FATAL ANY)
  endif()
  execute_process(COMMAND ${produce} COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
  file(READ "${WORK}/produced.json" produced)
  file(READ "${repo}/build/ci/quality-base.json" produced_base)
  string(JSON value GET "${produced}" metrics archive_bytes value)
  string(JSON tests GET "${produced}" metrics tests.native value)
  string(JSON zero GET "${produced}" metrics warnings value)
  execute_process(COMMAND git -C "${repo}" show "${event_base}:tests/roms/manifest.txt" OUTPUT_VARIABLE original COMMAND_ERROR_IS_FATAL ANY)
  string(SHA256 identity "${original}")
  string(JSON environment GET "${produced}" environment)
  execute_process(COMMAND git -C "${repo}" show "${event_base}:tests/built/expected.txt"
    OUTPUT_VARIABLE original_samples COMMAND_ERROR_IS_FATAL ANY)
  string(SHA256 sample_identity "${original_samples}")
  if(NOT value EQUAL 90 OR NOT tests EQUAL 3 OR NOT zero EQUAL 0 OR
      NOT environment STREQUAL "Controlled-1-ControlledOS-controlled;${identity};${sample_identity}")
    message(FATAL_ERROR "quality assertion: producer metrics or trusted environment lost: ${produced}")
  endif()
  if(case MATCHES "^(compiler|platform|samples)$")
    if(case STREQUAL "samples")
      file(APPEND "${repo}/tests/built/expected.txt" "changed\n")
    else()
      set(changed_file "${repo}/build/ci/CMakeFiles/${CMAKE_VERSION}/CMakeCCompiler.cmake")
      if(case STREQUAL "platform")
        set(changed_file "${repo}/build/ci/CMakeFiles/${CMAKE_VERSION}/CMakeSystem.cmake")
      endif()
      file(READ "${changed_file}" original_configuration)
      if(case STREQUAL "compiler")
        file(APPEND "${changed_file}" "set(CMAKE_C_COMPILER_VERSION 2)\n")
      else()
        file(APPEND "${changed_file}" "set(CMAKE_SYSTEM_PROCESSOR other)\n")
      endif()
    endif()
    set(single "${produce}")
    list(REMOVE_ITEM single -DBUILD_BASE=ON)
    if(case STREQUAL "samples")
      quality_expect_failure("quality: invalid sample revision transition" ${single})
      continue()
    endif()
    execute_process(COMMAND ${single} COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
    file(READ "${WORK}/produced.json" produced)
    file(WRITE "${changed_file}" "${original_configuration}")
    file(WRITE "${repo}/tests/built/expected.txt" "${candidate_samples}")
  endif()
  set(join "${WORK}/producer-join")
  file(REMOVE_RECURSE "${join}")
  foreach(lane asan hygiene linux-arm64 linux-x64 macos-arm64 macos-x64 windows-arm64 windows-x64)
    file(WRITE "${join}/quality-${lane}/quality-current.json" "${produced}")
    file(WRITE "${join}/quality-${lane}/quality-base.json" "${produced_base}")
    file(COPY "${repo}/build/ci/quality-base-policy.json" "${repo}/build/ci/quality-base-sha.txt" DESTINATION "${join}/quality-${lane}")
  endforeach()
  set(consume "${CMAKE_COMMAND}" -DDIRECTORY=${join} -DOUT=${WORK}/producer-joined
    -DPOLICY=${repo}/quality.json -DBASE_POLICY=${repo}/build/ci/quality-base-policy.json
    -DEXPECTED_SHA=${producer_head} -DBASE_SHA=${event_base} -DSOURCE=${run}
    -P "${ROOT}/tests/cmake/quality_join.cmake")
  if(case STREQUAL "producer_base")
    file(WRITE "${join}/quality-windows-x64/quality-base-sha.txt" "${producer_head}\n")
    quality_expect_failure("quality_join: trusted base mismatch" ${consume})
  elseif(case MATCHES "^(producer_run|producer_identity)$")
    if(case STREQUAL "producer_run")
      string(JSON produced SET "${produced}" metrics warnings source "\"https://github.com/example/public/actions/runs/2\"")
    else()
      string(JSON produced SET "${produced}" metrics warnings sha "\"${event_base}\"")
    endif()
    file(WRITE "${join}/quality-windows-x64/quality-current.json" "${produced}")
    quality_expect_failure("quality: commit or source mismatch" ${consume})
  elseif(case MATCHES "^(compiler|platform|samples)$")
    quality_expect_failure("quality_join: incomparable environment" ${consume})
  else()
    execute_process(COMMAND ${consume} COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
    file(READ "${WORK}/producer-joined/current.json" joined)
    string(JSON zero GET "${joined}" metrics warnings value)
    if(NOT zero EQUAL 0)
      message(FATAL_ERROR "quality assertion: surviving producer metric lost in join")
    endif()
  endif()
endforeach()
set(cmd "${CMAKE_COMMAND}" -DROOT=${ROOT} -DBUILD=${WORK}/absent -DOUT=${WORK}/evidence.json
  -DSHA=${head} -DCONFIG=ci -P "${ROOT}/tests/cmake/quality_evidence.cmake")
quality_expect_failure("quality_evidence: missing junit" ${cmd})
file(WRITE "${WORK}/absent/junit.xml" "<testsuite/>\n")
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
quality_expect_failure("quality_evidence: built SHA mismatch" ${cmd})
file(WRITE "${WORK}/absent/CMakeCache.txt" "CMAKE_HOME_DIRECTORY:INTERNAL=wrong\n")
list(TRANSFORM cmd REPLACE "^-DSHA=.*" "-DSHA=${actual}")
quality_expect_failure("quality_evidence: build configuration mismatch" ${cmd})

# A smaller lane must not hide a missing/forged observation behind another lane's maximum.
string(REPLACE fixture native p "${policy}")
string(REPLACE fixture native o "${observations}")
string(JSON o SET "${o}" metrics warnings direction "\"ceiling\"")
string(REPLACE "${head}" "${base}" h "${o}")
string(JSON o SET "${o}" environment "\"same-tool-and-fixtures\"")
string(JSON h SET "${h}" environment "\"same-tool-and-fixtures\"")
file(WRITE "${WORK}/join-policy.json" "${p}")
set(dir "${WORK}/join")
set(cmd "${CMAKE_COMMAND}" -DDIRECTORY=${dir} -DOUT=${WORK}/joined -DPOLICY=${WORK}/join-policy.json
  -DBASE_POLICY=${WORK}/join-base-policy.json -DEXPECTED_SHA=${head} -DBASE_SHA=${base}
  -DSOURCE=https://github.com/example/public/actions/runs/1 -P "${ROOT}/tests/cmake/quality_join.cmake")
foreach(case equal retirement omission extra forged missing unavailable string source config base raw_policy environment regression worst adoption)
  set(join_policy "${p}")
  set(join_base "${p}")
  set(current "${o}")
  set(prior "${h}")
  if(case STREQUAL "retirement")
    string(JSON join_base SET "${join_base}" metrics gate_lines "${metric}")
  elseif(case STREQUAL "adoption")
    foreach(input join_policy current prior)
      string(REPLACE warnings gate_lines ${input} "${${input}}")
    endforeach()
    string(JSON join_policy SET "${join_policy}" metrics gate_lines ceiling 15287)
    set(join_base "{\"metrics\":{}}")
    string(JSON prior REMOVE "${prior}" metrics gate_lines value)
    string(JSON prior SET "${prior}" metrics gate_lines status "\"unavailable\"")
    string(JSON prior SET "${prior}" metrics gate_lines reason "\"pre-policy fixture\"")
  endif()
  file(WRITE "${WORK}/join-policy.json" "${join_policy}")
  file(WRITE "${WORK}/join-base-policy.json" "${join_base}")
  file(REMOVE_RECURSE "${dir}")
  foreach(lane asan hygiene linux-arm64 linux-x64 macos-arm64 macos-x64 windows-arm64 windows-x64)
    file(WRITE "${dir}/quality-${lane}/quality-current.json" "${current}")
    file(WRITE "${dir}/quality-${lane}/quality-base.json" "${prior}")
    file(WRITE "${dir}/quality-${lane}/quality-base-policy.json" "${join_base}")
    file(WRITE "${dir}/quality-${lane}/quality-base-sha.txt" "${base}\n")
  endforeach()
  set(changed "${current}")
  if(case MATCHES "^(forged|source|config)$")
    string(JSON changed SET "${changed}" metrics warnings value 9)
  endif()
  set(regex "quality: commit or source mismatch warnings;[ \r\n]+sha=${base},[ \r\n]+expected=${head}")
  if(case STREQUAL "omission")
    file(REMOVE_RECURSE "${dir}/quality-asan")
    set(regex "quality_join: exact artifact set")
  elseif(case STREQUAL "extra")
    file(MAKE_DIRECTORY "${dir}/quality-extra")
    set(regex "quality_join: exact artifact set")
  elseif(case STREQUAL "forged")
    string(JSON changed SET "${changed}" metrics warnings sha "\"${base}\"")
  elseif(case STREQUAL "missing")
    string(JSON changed REMOVE "${changed}" metrics warnings)
    set(regex "quality: typed OBJECT")
  elseif(case STREQUAL "unavailable")
    string(JSON changed SET "${changed}" metrics warnings status "\"unavailable\"")
    set(regex "quality_join: required evidence")
  elseif(case STREQUAL "string")
    string(JSON changed SET "${changed}" metrics warnings value "\"9\"")
    set(regex "quality: typed NUMBER")
  elseif(case STREQUAL "source" OR case STREQUAL "config")
    if(case STREQUAL "source")
      string(JSON changed SET "${changed}" metrics warnings source "\"https://github.com/example/public/actions/runs/2\"")
      set(regex "quality: commit or source mismatch")
    else()
      string(JSON changed SET "${changed}" metrics warnings configuration "\"other\"")
      set(regex "quality: observation identity")
    endif()
  elseif(case STREQUAL "base")
    file(WRITE "${dir}/quality-windows-x64/quality-base-sha.txt" "${head}")
    set(regex "quality_join: trusted base mismatch")
  elseif(case STREQUAL "environment")
    string(JSON changed SET "${changed}" environment "\"other-tool\"")
    set(regex "quality_join: incomparable environment")
  elseif(case STREQUAL "raw_policy")
    file(APPEND "${dir}/quality-windows-x64/quality-base-policy.json" " ")
    set(regex "quality_join: trusted base mismatch")
  elseif(case STREQUAL "regression")
    string(JSON changed SET "${changed}" metrics warnings value 11)
    set(regex "quality: measured regression warnings")
  elseif(case STREQUAL "worst")
    string(JSON changed SET "${changed}" metrics warnings value 9)
  elseif(case STREQUAL "adoption")
    set(regex "quality_join: required evidence")
  endif()
  file(WRITE "${dir}/quality-windows-x64/quality-current.json" "${changed}")
  if(case MATCHES "^(equal|retirement|worst)$")
    execute_process(COMMAND ${cmd} COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET)
    file(READ "${WORK}/joined/current.json" joined)
    string(JSON value GET "${joined}" metrics warnings value)
    if(NOT value EQUAL 10)
      message(FATAL_ERROR "quality assertion: worst lane expected10, got ${value}")
    endif()
  else()
    quality_expect_failure("${regex}" ${cmd})
  endif()
endforeach()
