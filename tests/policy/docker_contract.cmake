function(run_contract name mode json should_pass expected_text)
  set(input "${test_work}/${name}.json")
  set(output "${test_work}/${name}.normalized.json")
  file(REMOVE "${output}")
  file(WRITE "${input}" "${json}\n")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DMODE=${mode}" "-DINPUT=${input}" "-DOUTPUT=${output}"
      ${ARGN} -P "${consumer}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  set(diagnostic "${stdout}${stderr}")
  if(should_pass)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} should pass, got ${result}: ${diagnostic}")
    endif()
    if(NOT EXISTS "${output}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} passed without normalized output")
    endif()
  else()
    if(result EQUAL 0)
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} fault was accepted")
    endif()
    if(NOT diagnostic MATCHES "${expected_text}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} failed without its named diagnostic '${expected_text}': ${diagnostic}")
    endif()
    if(EXISTS "${output}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} wrote normalized output after refusing admission")
    endif()
  endif()
  math(EXPR case_count "${case_count} + 1")
  set(case_count "${case_count}" PARENT_SCOPE)
endfunction()

