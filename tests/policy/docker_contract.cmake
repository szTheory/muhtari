function(run_owner_case name json should_pass expected_text id_path owner_path)
  set(input "${test_work}/${name}.json")
  set(output "${test_work}/${name}.normalized.json")
  set(validated_id_output "${test_work}/${name}.validated-id")
  file(REMOVE "${output}")
  file(REMOVE "${validated_id_output}")
  file(WRITE "${input}" "${json}\n")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DMODE=ownership" "-DINPUT=${input}" "-DOUTPUT=${output}"
      "-DID_FILE=${id_path}" "-DOWNER_FILE=${owner_path}"
      "-DVALIDATED_ID_OUTPUT=${validated_id_output}" -P "${consumer}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  set(diagnostic "${stdout}${stderr}")
  if(should_pass)
    if(NOT "${result}" STREQUAL "0" OR NOT EXISTS "${validated_id_output}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} did not write the validated full ID (exit ${result}): ${diagnostic}")
    endif()
    file(READ "${validated_id_output}" validated_id)
    string(STRIP "${validated_id}" validated_id)
    if(NOT "${validated_id}" STREQUAL "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} did not return the exact validated full ID")
    endif()
  else()
    if(result EQUAL 0 OR NOT diagnostic MATCHES "${expected_text}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} was not refused with ${expected_text}: ${diagnostic}")
    endif()
    if(EXISTS "${output}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} wrote normalized output after refusing ownership")
    endif()
    if(EXISTS "${validated_id_output}")
      message(FATAL_ERROR "policy.docker_contract.controls: ${name} wrote a validated ID after refusing ownership")
    endif()
  endif()
endfunction()
