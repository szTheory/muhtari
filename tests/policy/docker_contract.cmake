function(fixture_mode path output_var)
  execute_process(COMMAND stat -f %Lp "${path}"
    RESULT_VARIABLE stat_result OUTPUT_VARIABLE mode ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT stat_result EQUAL 0)
    execute_process(COMMAND stat -c %a "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE mode ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
  if(NOT stat_result EQUAL 0 OR mode STREQUAL "")
    message(FATAL_ERROR "policy.docker_contract.controls: cannot capture fixture mode for ${path}")
  endif()
  set(${output_var} "${mode}" PARENT_SCOPE)
endfunction()

function(fixture_record root relative output_var)
  set(path "${root}/${relative}")
  fixture_mode("${path}" mode)
  file(SHA256 "${path}" digest)
  string(JSON record SET "{}" path "\"${relative}\"")
  string(JSON record SET "${record}" type "\"file\"")
  string(JSON record SET "${record}" mode "\"${mode}\"")
  string(JSON record SET "${record}" sha256 "\"${digest}\"")
  set(${output_var} "${record}" PARENT_SCOPE)
endfunction()

function(make_fixture_manifest root output_var)
  execute_process(COMMAND git -C "${root}" rev-parse HEAD
    RESULT_VARIABLE git_result OUTPUT_VARIABLE start_head OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT git_result EQUAL 0)
    message(FATAL_ERROR "policy.docker_contract.controls: cannot capture fixture HEAD")
  endif()
  set(tracked_json "[]")
  set(index 0)
  foreach(path IN ITEMS .gitignore tracked.txt)
    fixture_record("${root}" "${path}" record)
    string(JSON tracked_json SET "${tracked_json}" ${index} "${record}")
    math(EXPR index "${index} + 1")
  endforeach()
  set(roots_json "[]")
  set(index 0)
  foreach(root_name IN ITEMS gap19 gap20 gap21 gap22 gap23)
    set(relative_root "build/phase14-${root_name}-evidence")
    set(abs_root "${root}/${relative_root}")
    string(JSON root_item SET "{}" path "\"${relative_root}\"")
    if(EXISTS "${abs_root}")
      string(JSON root_item SET "${root_item}" present true)
      file(GLOB_RECURSE history_entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${abs_root}/*")
      list(SORT history_entries)
      set(entries_json "[]")
      set(entry_index 0)
      foreach(entry_path IN LISTS history_entries)
        if(IS_DIRECTORY "${root}/${entry_path}")
          continue()
        endif()
        fixture_record("${root}" "${entry_path}" record)
        string(JSON entries_json SET "${entries_json}" ${entry_index} "${record}")
        math(EXPR entry_index "${entry_index} + 1")
      endforeach()
      string(JSON root_item SET "${root_item}" entries "${entries_json}")
    else()
      string(JSON root_item SET "${root_item}" present false)
      string(JSON root_item SET "${root_item}" entries "[]")
    endif()
    string(JSON roots_json SET "${roots_json}" ${index} "${root_item}")
    math(EXPR index "${index} + 1")
  endforeach()
  string(JSON manifest SET "{}" head "\"${start_head}\"")
  string(JSON manifest SET "${manifest}" starting_status "\"\"")
  string(JSON manifest SET "${manifest}" tracked "${tracked_json}")
  string(JSON manifest SET "${manifest}" history_roots "${roots_json}")
  set(manifest_path "${root}/build/preservation.json")
  file(WRITE "${manifest_path}" "${manifest}\n")
  file(SHA256 "${manifest_path}" manifest_sha)
  set(${output_var} "${manifest_path};${manifest_sha}" PARENT_SCOPE)
endfunction()

function(run_preservation_case name should_pass expected_text manifest_path manifest_sha)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DROOT=${preservation_root}" "-DMODE=check"
      "-DMANIFEST=${manifest_path}" "-DMANIFEST_SHA=${manifest_sha}"
      -P "${ROOT}/tests/cmake/check_diagnostic_preservation.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  set(diagnostic "${stdout}${stderr}")
  if(should_pass)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "policy.docker_contract.controls: preservation ${name} should pass: ${diagnostic}")
    endif()
  else()
    if(result EQUAL 0 OR NOT diagnostic MATCHES "${expected_text}")
      message(FATAL_ERROR "policy.docker_contract.controls: preservation ${name} did not fail with '${expected_text}': ${diagnostic}")
    endif()
  endif()
endfunction()

