# Fault prevented: a run audit ignoring another failed job or accepting the
# wrong source, an incomplete run or an absent/unsuccessful required check.
cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${WORK}")
string(REPEAT "a" 40 head)
string(REPEAT "b" 40 other)
set(valid [=[{"headSha":"HEAD","attempt":1,"status":"completed","conclusion":"success","url":"https://github.com/example/public/actions/runs/1","jobs":[{"name":"retroarch","status":"completed","conclusion":"success"},{"name":"quality","status":"completed","conclusion":"success"},{"name":"CI required","status":"completed","conclusion":"success"}]}]=])
string(REPLACE HEAD "${head}" valid "${valid}")
set(CMD "${CMAKE_COMMAND}" -DINPUT=${WORK}/run.json -DEXPECTED_SHA=${head}
  -P "${ROOT}/tools/check_ci_run.cmake")
foreach(case pass skips advisory_failures multiple_failures wrong_source incomplete
    missing_required duplicate_required skipped_required malformed malformed_jobs
    malformed_status malformed_source malformed_job_status nonterminal_job
    missing_job_conclusion missing_run_conclusion invalid_url missing_attempt invalid_attempt malformed_attempt empty_jobs)
  set(run "${valid}")
  set(regex "ci_run:")
  set(want 1)
  if(case STREQUAL "pass")
    set(want 0)
  elseif(case STREQUAL "skips")
    string(JSON run SET "${run}" jobs 0 name "\"title\"")
    string(JSON run SET "${run}" jobs 0 conclusion "\"skipped\"")
    set(want 0)
  elseif(case STREQUAL "advisory_failures")
    string(JSON run SET "${run}" conclusion "\"failure\"")
    string(JSON run SET "${run}" jobs 0 name "\"library\"")
    string(JSON run SET "${run}" jobs 0 conclusion "\"failure\"")
    string(JSON run SET "${run}" jobs 1 name "\"wasm32\"")
    string(JSON run SET "${run}" jobs 1 conclusion "\"failure\"")
    set(want 0)
  elseif(case STREQUAL "multiple_failures")
    string(JSON run SET "${run}" conclusion "\"failure\"")
    foreach(i RANGE 0 2)
      string(JSON run SET "${run}" jobs ${i} conclusion "\"failure\"")
    endforeach()
    set(regex "required aggregate is not completed/success")
  elseif(case STREQUAL "wrong_source")
    string(JSON run SET "${run}" headSha "\"${other}\"")
    set(regex "source mismatch")
  elseif(case STREQUAL "incomplete")
    string(JSON run SET "${run}" status "\"in_progress\"")
    string(JSON run SET "${run}" conclusion null)
    set(regex "run is not completed")
  elseif(case STREQUAL "missing_required")
    string(JSON run REMOVE "${run}" jobs 2)
    set(regex "expected exactly one CI required job, got 0")
  elseif(case STREQUAL "duplicate_required")
    string(JSON required GET "${run}" jobs 2)
    string(JSON run SET "${run}" jobs 3 "${required}")
    set(regex "expected exactly one CI required job, got 2")
  elseif(case STREQUAL "skipped_required")
    string(JSON run SET "${run}" jobs 2 conclusion "\"skipped\"")
    set(regex "required aggregate is not completed/success")
  elseif(case STREQUAL "malformed")
    set(run "not JSON")
    set(regex "headSha must be STRING")
  elseif(case STREQUAL "malformed_jobs")
    string(JSON run SET "${run}" jobs "{}")
    set(regex "jobs must be ARRAY")
  elseif(case STREQUAL "malformed_status")
    string(JSON run SET "${run}" status 1)
    set(regex "status must be STRING")
  elseif(case STREQUAL "malformed_source")
    string(JSON run SET "${run}" headSha 1)
    set(regex "headSha must be STRING")
  elseif(case STREQUAL "malformed_job_status")
    string(JSON run SET "${run}" jobs 0 status "\"unknown\"")
    set(regex "invalid job status for retroarch")
  elseif(case STREQUAL "nonterminal_job")
    string(JSON run SET "${run}" jobs 0 status "\"queued\"")
    string(JSON run SET "${run}" jobs 0 conclusion null)
    set(regex "nonterminal job retroarch")
  elseif(case STREQUAL "missing_job_conclusion")
    string(JSON run SET "${run}" jobs 0 conclusion null)
    set(regex "completed job retroarch has no conclusion")
  elseif(case STREQUAL "missing_run_conclusion")
    string(JSON run SET "${run}" conclusion null)
    set(regex "completed run has no conclusion")
  elseif(case STREQUAL "missing_attempt")
    string(JSON run REMOVE "${run}" attempt)
    set(regex "attempt must be NUMBER")
  elseif(case STREQUAL "invalid_attempt")
    string(JSON run SET "${run}" attempt 0)
    set(regex "attempt must be a positive integer")
  elseif(case STREQUAL "malformed_attempt")
    string(JSON run SET "${run}" attempt "\"1\"")
    set(regex "attempt must be NUMBER")
  elseif(case STREQUAL "empty_jobs")
    string(JSON run SET "${run}" jobs "[]")
    set(regex "expected exactly one CI required job, got 0")
  elseif(case STREQUAL "invalid_url")
    string(JSON run SET "${run}" url "\"not a run\"")
    set(regex "invalid run URL")
  endif()
  file(WRITE "${WORK}/run.json" "${run}\n")
  if(want EQUAL 0)
    execute_process(COMMAND ${CMD} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
    if(NOT rc STREQUAL "0" OR NOT out MATCHES "required checks passed")
      message(FATAL_ERROR "ci_run assertion: ${case}: exit ${rc}: ${out}")
    endif()
  else()
    set(CODE 1)
    set(REGEX "${regex}")
    include("${ROOT}/tests/cmake/expect_fail.cmake")
  endif()
  if(case STREQUAL "multiple_failures" OR case STREQUAL "advisory_failures")
    if(case STREQUAL "multiple_failures")
      set(reported retroarch quality "CI required")
    else()
      set(reported library wasm32)
    endif()
    foreach(name IN LISTS reported)
      if(NOT out MATCHES "ci_run: job ${name}: completed/failure")
        message(FATAL_ERROR "ci_run assertion: ${case} omitted ${name}: ${out}")
      endif()
    endforeach()
  elseif(case STREQUAL "skips" AND NOT out MATCHES "ci_run: job title: completed/skipped")
    message(FATAL_ERROR "ci_run assertion: skipped job omitted: ${out}")
  endif()
endforeach()
message(STATUS "ci_run controls: 22 pass/fault cases")
