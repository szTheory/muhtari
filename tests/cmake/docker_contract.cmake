cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED MODE OR NOT DEFINED INPUT OR NOT EXISTS "${INPUT}")
  message(FATAL_ERROR "docker_contract: MODE and an existing INPUT are required")
endif()
file(READ "${INPUT}" raw_json)
string(JSON root_type ERROR_VARIABLE json_error TYPE "${raw_json}")
if(json_error)
  message(FATAL_ERROR "docker_contract: invalid inspect JSON: ${json_error}")
endif()
if(root_type STREQUAL "ARRAY")
  string(JSON item_count ERROR_VARIABLE json_error LENGTH "${raw_json}")
  if(json_error OR NOT item_count EQUAL 1)
    message(FATAL_ERROR "docker_contract: inspect array must contain exactly one object")
  endif()
  string(JSON normalized ERROR_VARIABLE json_error GET "${raw_json}" 0)
  if(json_error)
    message(FATAL_ERROR "docker_contract: inspect array item is invalid: ${json_error}")
  endif()
elseif(root_type STREQUAL "OBJECT")
  message(FATAL_ERROR "docker_contract: object inspect shape unsupported by initial array reader")
else()
  message(FATAL_ERROR "docker_contract: inspect JSON root must be an object or singleton array")
endif()
string(JSON normalized_type ERROR_VARIABLE json_error TYPE "${normalized}")
if(json_error OR NOT normalized_type STREQUAL "OBJECT")
  message(FATAL_ERROR "docker_contract: normalized inspect item must be an object")
endif()
if(NOT DEFINED OUTPUT OR "${OUTPUT}" STREQUAL "")
  message(FATAL_ERROR "docker_contract: OUTPUT is required")
endif()
file(WRITE "${OUTPUT}" "${normalized}\n")
