cmake_minimum_required(VERSION 3.25)

function(contract_fail reason)
  message(FATAL_ERROR "docker_contract: ${reason}")
endfunction()

function(normalize_inspect raw out_var)
  string(JSON root_type ERROR_VARIABLE json_error TYPE "${raw}")
  if(json_error)
    contract_fail("invalid inspect JSON: ${json_error}")
  endif()
  if(root_type STREQUAL "OBJECT")
    set(normalized "${raw}")
  elseif(root_type STREQUAL "ARRAY")
    string(JSON item_count ERROR_VARIABLE json_error LENGTH "${raw}")
    if(json_error OR NOT item_count EQUAL 1)
      contract_fail("inspect array must contain exactly one object")
    endif()
    string(JSON normalized ERROR_VARIABLE json_error GET "${raw}" 0)
    if(json_error)
      contract_fail("inspect array item is invalid: ${json_error}")
    endif()
    string(JSON item_type ERROR_VARIABLE json_error TYPE "${normalized}")
    if(json_error OR NOT item_type STREQUAL "OBJECT")
      contract_fail("inspect array item must be an object")
    endif()
  else()
    contract_fail("inspect JSON root must be an object or singleton array")
  endif()
  set(${out_var} "${normalized}" PARENT_SCOPE)
endfunction()

function(json_type json out_var error_var)
  string(JSON type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  set(${out_var} "${type}" PARENT_SCOPE)
  set(${error_var} "${error}" PARENT_SCOPE)
endfunction()

function(require_field json expected_type field)
  json_type("${json}" actual_type type_error ${field})
  if(type_error)
    contract_fail("required ${field} field is missing or invalid")
  endif()
  if(NOT actual_type STREQUAL expected_type)
    contract_fail("${field} must be ${expected_type}, got ${actual_type}")
  endif()
endfunction()

function(require_string json field expected)
  require_field("${json}" STRING "${field}")
  string(JSON actual GET "${json}" ${field})
  if(NOT actual STREQUAL expected)
    contract_fail("${field} mismatch")
  endif()
endfunction()

function(require_number json field expected)
  require_field("${json}" NUMBER "${field}")
  string(JSON actual GET "${json}" ${field})
  if(NOT actual EQUAL expected)
    contract_fail("${field} mismatch")
  endif()
endfunction()

function(require_boolean json field expected)
  require_field("${json}" BOOLEAN "${field}")
  string(JSON actual GET "${json}" ${field})
  set(actual_value false)
  set(expected_value false)
  if(actual)
    set(actual_value true)
  endif()
  if(expected)
    set(expected_value true)
  endif()
  if(NOT "${actual_value}" STREQUAL "${expected_value}")
    contract_fail("${field} mismatch: got ${actual_value}, expected ${expected_value}")
  endif()
endfunction()

function(array_contains json path expected)
  string(JSON count ERROR_VARIABLE array_error LENGTH "${json}" ${path})
  if(array_error)
    contract_fail("${path} must be an array")
  endif()
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON value ERROR_VARIABLE item_error GET "${json}" ${path} ${index})
      if(NOT item_error AND value STREQUAL expected)
        return()
      endif()
    endforeach()
  endif()
  contract_fail("${path} does not contain the required value")
endfunction()

function(validate_optional_empty_object json path)
  json_type("${json}" field_type field_error ${path})
  if(field_error)
    return()
  endif()
  if(field_type STREQUAL "NULL")
    return()
  endif()
  if(NOT field_type STREQUAL "OBJECT")
    contract_fail("${path} must be absent, null or an empty object")
  endif()
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" ${path})
  if(count_error OR NOT count EQUAL 0)
    contract_fail("${path} must be absent, null or an empty object")
  endif()
endfunction()

function(validate_optional_empty_array json path)
  json_type("${json}" field_type field_error ${path})
  if(field_error OR field_type STREQUAL "NULL")
    return()
  endif()
  if(NOT field_type STREQUAL "ARRAY")
    contract_fail("${path} must be absent, null or an empty array")
  endif()
  string(JSON count ERROR_VARIABLE count_error LENGTH "${json}" ${path})
  if(count_error OR NOT count EQUAL 0)
    contract_fail("${path} must be absent, null or an empty array")
  endif()
endfunction()

function(validate_full_id value field_name)
  if(NOT value MATCHES "^sha256:[0-9a-f]+$")
    contract_fail("${field_name} must be a full sha256 ID")
  endif()
  string(LENGTH "${value}" id_length)
  if(NOT id_length EQUAL 71)
    contract_fail("${field_name} must be a full sha256 ID")
  endif()
endfunction()

function(validate_image doc)
  set(expected_id "sha256:10ca2cfc3a29b70e13fe0a2a9244fe7e5d24fbd7350ac4205028335c9541f926")
  set(expected_digest "catthehacker/ubuntu@sha256:c58e2b364da03b0c804c7d660f2ecbedf2f221a382b9baa0b344b0144780ff43")
  require_string("${doc}" Id "${expected_id}")
  validate_full_id("${expected_id}" Id)
  require_string("${doc}" Os linux)
  require_string("${doc}" Architecture arm64)
  require_field("${doc}" ARRAY RepoDigests)
  array_contains("${doc}" RepoDigests "${expected_digest}")
  require_field("${doc}" OBJECT Config)
  string(JSON config GET "${doc}" Config)
  require_field("${config}" OBJECT Labels)
  string(JSON labels GET "${config}" Labels)
  require_string("${labels}" org.opencontainers.image.source "https://github.com/catthehacker/catthehacker/docker_images")
  require_string("${labels}" org.opencontainers.image.revision e2f8efe464c82732f78e967ee709c00b6af53643)
  validate_optional_empty_object("${config}" Volumes)
endfunction()

function(validate_tmpfs value)
  set(expected "rw,nosuid,nodev,exec,size=2147483648,uid=1000,gid=1000,mode=0700")
  if(NOT value STREQUAL expected)
    contract_fail("HostConfig.Tmpfs /work mismatch")
  endif()
endfunction()

function(validate_mounts doc)
  require_field("${doc}" ARRAY Mounts)
  string(JSON count LENGTH "${doc}" Mounts)
  set(work_count 0)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON mount_type ERROR_VARIABLE mount_error TYPE "${doc}" Mounts ${index})
      if(mount_error OR NOT mount_type STREQUAL "OBJECT")
        contract_fail("Mounts entry must be an object")
      endif()
      string(JSON destination_type ERROR_VARIABLE destination_error TYPE "${doc}" Mounts ${index} Destination)
      if(destination_error OR NOT destination_type STREQUAL "STRING")
        contract_fail("Mounts entry has no string Destination")
      endif()
      string(JSON destination GET "${doc}" Mounts ${index} Destination)
      if(destination STREQUAL "/work")
        math(EXPR work_count "${work_count} + 1")
        string(JSON type GET "${doc}" Mounts ${index} Type)
        if(NOT type STREQUAL "tmpfs")
          contract_fail("/work mount must be tmpfs")
        endif()
        string(JSON rw GET "${doc}" Mounts ${index} RW)
        if(NOT rw)
          contract_fail("/work tmpfs must be writable")
        endif()
      elseif(destination STREQUAL "/etc/hosts" OR destination STREQUAL "/etc/hostname" OR destination STREQUAL "/etc/resolv.conf")
        string(JSON type GET "${doc}" Mounts ${index} Type)
        if(NOT type STREQUAL "bind")
          contract_fail("Docker system mount type is unexpected")
        endif()
      else()
        contract_fail("Mounts contains a prohibited destination")
      endif()
    endforeach()
  endif()
  if(NOT work_count EQUAL 1)
    contract_fail("Mounts must contain exactly one private /work tmpfs")
  endif()
endfunction()

function(validate_container doc expected_name expected_owner)
  string(JSON actual_id ERROR_VARIABLE id_error GET "${doc}" Id)
  if(id_error)
    contract_fail("required Id field is missing")
  endif()
  validate_full_id("${actual_id}" Id)
  if(DEFINED EXPECTED_ID AND NOT EXPECTED_ID STREQUAL "" AND NOT actual_id STREQUAL EXPECTED_ID)
    contract_fail("container Id does not match the expected full ID")
  endif()
  require_string("${doc}" Name "/${expected_name}")
  require_field("${doc}" OBJECT Config)
  string(JSON config GET "${doc}" Config)
  require_string("${config}" User "1000:1000")
  require_field("${config}" OBJECT Labels)
  string(JSON labels GET "${config}" Labels)
  require_string("${labels}" org.muhtari.gap24.owner "${expected_owner}")
  validate_optional_empty_object("${config}" Volumes)

  require_field("${doc}" OBJECT HostConfig)
  string(JSON host GET "${doc}" HostConfig)
  require_boolean("${host}" Privileged false)
  require_boolean("${host}" ReadonlyRootfs true)
  require_string("${host}" NetworkMode none)
  require_string("${host}" IpcMode private)
  require_string("${host}" CgroupnsMode private)
  require_number("${host}" CpuPeriod 100000)
  require_number("${host}" CpuQuota 200000)
  require_number("${host}" Memory 2147483648)
  require_number("${host}" MemorySwap 2147483648)
  require_number("${host}" PidsLimit 256)
  require_field("${host}" ARRAY CapDrop)
  array_contains("${host}" CapDrop ALL)
  require_field("${host}" ARRAY SecurityOpt)
  array_contains("${host}" SecurityOpt no-new-privileges:true)
  require_field("${host}" OBJECT Tmpfs)
  string(JSON tmpfs_count LENGTH "${host}" Tmpfs)
  if(NOT tmpfs_count EQUAL 1)
    contract_fail("HostConfig.Tmpfs must contain only /work")
  endif()
  string(JSON tmpfs_type TYPE "${host}" Tmpfs /work)
  if(NOT tmpfs_type STREQUAL "STRING")
    contract_fail("HostConfig.Tmpfs /work must be a string")
  endif()
  string(JSON tmpfs_value GET "${host}" Tmpfs /work)
  validate_tmpfs("${tmpfs_value}")
  validate_optional_empty_array("${host}" Binds)
  validate_optional_empty_object("${host}" PortBindings)
  foreach(field IN ITEMS CapAdd Devices VolumesFrom)
    validate_optional_empty_array("${host}" ${field})
  endforeach()
  validate_optional_empty_array("${host}" Mounts)
  foreach(field IN ITEMS PidMode UTSMode)
    json_type("${host}" field_type field_error ${field})
    if(NOT field_error)
      if(field_type STREQUAL "STRING")
        string(JSON value GET "${host}" ${field})
        if(NOT value STREQUAL "")
          contract_fail("HostConfig.${field} must use Docker's private default")
        endif()
      elseif(NOT field_type STREQUAL "NULL")
        contract_fail("HostConfig.${field} must use Docker's private default")
      endif()
    endif()
  endforeach()
  validate_mounts("${doc}")
endfunction()

function(read_single_line file_path label out_var)
  if(NOT EXISTS "${file_path}" OR IS_DIRECTORY "${file_path}")
    contract_fail("${label} file is missing")
  endif()
  file(READ "${file_path}" contents)
  if(contents STREQUAL "")
    contract_fail("${label} file is empty")
  endif()
  string(REGEX REPLACE "\n$" "" contents "${contents}")
  if(contents STREQUAL "" OR contents MATCHES "[\r\n]" OR contents MATCHES "[ \t]")
    contract_fail("${label} file must contain exactly one unpadded line")
  endif()
  set(${out_var} "${contents}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED MODE)
  contract_fail("MODE is required")
endif()
if(MODE STREQUAL "identity")
  if(NOT DEFINED ID_FILE OR NOT DEFINED OWNER_FILE OR NOT DEFINED VALIDATED_ID_OUTPUT OR VALIDATED_ID_OUTPUT STREQUAL "")
    contract_fail("identity mode requires ID_FILE, OWNER_FILE and VALIDATED_ID_OUTPUT")
  endif()
  read_single_line("${ID_FILE}" ID id_value)
  read_single_line("${OWNER_FILE}" "owner label" owner_value)
  validate_full_id("${id_value}" ID)
  if(NOT owner_value MATCHES "^muhtari-gap24-[a-z0-9-]+$")
    contract_fail("owner label file has malformed content")
  endif()
  file(WRITE "${VALIDATED_ID_OUTPUT}" "${id_value}\n")
  return()
endif()
if(NOT DEFINED INPUT OR NOT EXISTS "${INPUT}")
  contract_fail("an existing INPUT is required")
endif()
if(NOT DEFINED OUTPUT OR "${OUTPUT}" STREQUAL "")
  contract_fail("OUTPUT is required")
endif()
file(READ "${INPUT}" raw_json)
normalize_inspect("${raw_json}" inspect)

if(MODE STREQUAL "image")
  validate_image("${inspect}")
elseif(MODE STREQUAL "container")
  if(NOT DEFINED EXPECTED_NAME OR EXPECTED_NAME STREQUAL "" OR
      NOT DEFINED EXPECTED_OWNER OR EXPECTED_OWNER STREQUAL "")
    contract_fail("container mode requires EXPECTED_NAME and EXPECTED_OWNER")
  endif()
  validate_container("${inspect}" "${EXPECTED_NAME}" "${EXPECTED_OWNER}")
elseif(MODE STREQUAL "ownership")
  if(NOT DEFINED ID_FILE OR NOT DEFINED OWNER_FILE OR NOT DEFINED VALIDATED_ID_OUTPUT OR VALIDATED_ID_OUTPUT STREQUAL "")
    contract_fail("ownership mode requires ID_FILE, OWNER_FILE and VALIDATED_ID_OUTPUT")
  endif()
  read_single_line("${ID_FILE}" ID id_value)
  read_single_line("${OWNER_FILE}" "owner label" owner_value)
  validate_full_id("${id_value}" ID)
  if(NOT owner_value MATCHES "^muhtari-gap24-[a-z0-9-]+$")
    contract_fail("owner label file has malformed content")
  endif()
  string(JSON actual_id ERROR_VARIABLE id_error GET "${inspect}" Id)
  if(id_error OR NOT actual_id STREQUAL id_value)
    contract_fail("live container Id does not match the saved full ID")
  endif()
  require_field("${inspect}" OBJECT Config)
  string(JSON config GET "${inspect}" Config)
  require_field("${config}" OBJECT Labels)
  string(JSON labels GET "${config}" Labels)
  require_string("${labels}" org.muhtari.gap24.owner "${owner_value}")
else()
  contract_fail("unsupported MODE ${MODE}")
endif()

file(WRITE "${OUTPUT}" "${inspect}\n")
if(MODE STREQUAL "ownership")
  file(WRITE "${VALIDATED_ID_OUTPUT}" "${id_value}\n")
endif()
