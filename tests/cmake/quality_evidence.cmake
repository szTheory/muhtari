# Fault prevented: missing, failed or unrelated producer outputs becoming numeric passes.
# ROOT/BUILD/OUT/SHA/CONFIG adapt completed workflow outputs; SOURCE identifies its run.
cmake_minimum_required(VERSION 4.3)
if(NOT EXISTS "${BUILD}/junit.xml")
  message(FATAL_ERROR "quality_evidence: missing junit")
endif()
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${BUILD}" BUILD)
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE built
  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT built STREQUAL SHA)
  message(FATAL_ERROR "quality_evidence: built SHA mismatch")
endif()
file(READ "${BUILD}/CMakeCache.txt" cache)
string(FIND "${cache}" "CMAKE_HOME_DIRECTORY:INTERNAL=${ROOT}\n" home)
if(home EQUAL -1)
  message(FATAL_ERROR "quality_evidence: build configuration mismatch")
endif()
if(NOT SOURCE)
  set(SOURCE local)
endif()
set(report "{\"metrics\":{}}")
include("${BUILD}/CMakeFiles/${CMAKE_VERSION}/CMakeCCompiler.cmake")
include("${BUILD}/CMakeFiles/${CMAKE_VERSION}/CMakeSystem.cmake")
file(SHA256 "${ROOT}/tests/roms/manifest.txt" fixture)
file(SHA256 "${ROOT}/tests/built/expected.txt" samples)
set(environment "${CMAKE_C_COMPILER_ID}-${CMAKE_C_COMPILER_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR};${fixture};${samples}")
string(JSON encoded STRING_ENCODE "${environment}")
string(JSON report SET "${report}" environment "${encoded}")
function(observe key units value)
  set(item "{}")
  foreach(field units producer configuration sha source status direction)
    set(producer "tests/cmake/quality_evidence.cmake")
    set(configuration "${CONFIG}")
    if(CONFIG MATCHES "^ci(-msvc)?$")
      set(configuration native)
    endif()
    if(key STREQUAL "gate_lines")
      set(producer "tests/cmake/gate_count.cmake")
      set(configuration "tests/policy/gate-lines.txt")
    endif()
    set(sha "${SHA}")
    set(source "${SOURCE}")
    set(status measured)
    set(direction floor)
    if(key MATCHES "^(warnings|.*findings|archive_bytes|gate_lines)$")
      set(direction ceiling)
    endif()
    string(JSON encoded STRING_ENCODE "${${field}}")
    string(JSON item SET "${item}" ${field} "${encoded}")
  endforeach()
  if(value STREQUAL "unavailable")
    string(JSON item SET "${item}" status "\"unavailable\"")
    string(JSON encoded STRING_ENCODE "${ARGN}")
    string(JSON item SET "${item}" reason "${encoded}")
  else()
    string(JSON item SET "${item}" value "${value}")
  endif()
  string(JSON report SET "${report}" metrics "${key}" "${item}")
  set(report "${report}" PARENT_SCOPE)
endfunction()
set(JUNIT "${BUILD}/junit.xml")
set(INVENTORY "${ROOT}/tests/inventory/${CONFIG}.txt")
set(EXCLUDE release)
if(CONFIG STREQUAL "ci-msvc" OR CONFIG STREQUAL "asan")
  set(INVENTORY "${ROOT}/tests/inventory/ci.txt")
endif()
if(CONFIG STREQUAL "asan")
  set(EXCLUDE "abi|release")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/check_junit.cmake")
set(lane "${CONFIG}")
if(CONFIG MATCHES "^ci(-msvc)?$")
  set(lane native)
endif()
observe("tests.${lane}" count "${selected}")
if(CONFIG STREQUAL "hygiene")
  if(NOT "hygiene.analyzer" IN_LIST ran)
    message(FATAL_ERROR "quality_evidence: missing analyzer judge")
  endif()
  observe(analyzer_findings findings 0)
elseif(CONFIG STREQUAL "asan")
  if(NOT cache MATCHES "fsanitize=address,undefined")
    message(FATAL_ERROR "quality_evidence: sanitizer configuration")
  endif()
  observe(sanitizer_findings findings 0)
elseif(CONFIG MATCHES "^ci(-msvc)?$")
  if(NOT cache MATCHES "CMAKE_COMPILE_WARNING_AS_ERROR:[^=]+=ON")
    message(FATAL_ERROR "quality_evidence: warnings were not fatal")
  endif()
  foreach(kind abi fuzz title)
    list(FILTER ran INCLUDE REGEX "^${kind}[.]")
    list(LENGTH ran count)
    if(count LESS 1)
      message(FATAL_ERROR "quality_evidence: missing ${kind} judge")
    endif()
    observe("${kind}_tests" count "${count}")
    # check_junit verifies the entire output again and restores the full name set.
    include("${CMAKE_CURRENT_LIST_DIR}/check_junit.cmake")
  endforeach()
  observe(warnings findings 0)
  observe(abi_findings findings 0)
  set(JUNIT "${BUILD}/junit-release.xml")
  set(EXCLUDE "")
  set(LABELS release)
  include("${CMAKE_CURRENT_LIST_DIR}/check_junit.cmake")
  file(GLOB archives "${BUILD}/muhtari-*.zip")
  list(LENGTH archives count)
  if(NOT count EQUAL 3 OR NOT "release.archive_contents" IN_LIST ran)
    message(FATAL_ERROR "quality_evidence: missing archive producer")
  endif()
  set(bytes 0)
  foreach(archive IN LISTS archives)
    file(SIZE "${archive}" size)
    math(EXPR bytes "${bytes}+${size}")
  endforeach()
  observe(archive_bytes bytes "${bytes}")
  if(EXISTS "${ROOT}/tests/policy/gate-lines.txt")
    execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${ROOT} -DINVENTORY=tests/policy/gate-lines.txt
      -DOUT=${BUILD}/gate-count.json -P "${CMAKE_CURRENT_LIST_DIR}/gate_count.cmake" COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${BUILD}/gate-count.json" count)
    string(JSON value GET "${count}" gate_lines)
    observe(gate_lines "physical lines including comments and blanks" "${value}")
  else()
    observe(gate_lines "physical lines including comments and blanks" unavailable "pre-policy tree has no audited inventory")
  endif()
endif()
foreach(gap coverage open_crashes backlog duration ir_per_frame library wasm32 property)
  observe("gap.${gap}" unavailable unavailable "no fresh comparable producer in this invocation")
endforeach()
file(WRITE "${OUT}" "${report}\n")
if(BUILD_BASE)
  # Resolve from event metadata, never a candidate-supplied baseline override.
  file(READ "$ENV{GITHUB_EVENT_PATH}" event)
  string(JSON base ERROR_VARIABLE absent GET "${event}" pull_request base sha)
  if(absent)
    string(JSON base ERROR_VARIABLE absent GET "${event}" before)
  endif()
  if(absent AND "$ENV{GITHUB_EVENT_NAME}" STREQUAL "workflow_dispatch")
    execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD^1 OUTPUT_VARIABLE base
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(absent "")
  endif()
  if(absent OR NOT base MATCHES "^[0-9a-f]+$" OR base STREQUAL SHA)
    message(FATAL_ERROR "quality_evidence: independent trusted event base required")
  endif()
  execute_process(COMMAND git -C "${ROOT}" cat-file -e "${base}^{commit}" COMMAND_ERROR_IS_FATAL ANY)
  set(tree "${BUILD}/quality-base")
  execute_process(COMMAND git -C "${ROOT}" worktree add --detach "${tree}" "${base}" COMMAND_ERROR_IS_FATAL ANY)
  file(COPY "${ROOT}/build/pins" DESTINATION "${tree}/build")
  execute_process(COMMAND "${CMAKE_COMMAND}" --workflow --preset "${CONFIG}"
    WORKING_DIRECTORY "${tree}" RESULT_VARIABLE base_rc)
  if(NOT base_rc STREQUAL "0")
    if(WIN32)
      # Temporary bounded diagnosis; a failed trusted workflow remains fatal.
      set(consumer "${tree}/build/${CONFIG}/consumer_dll_crt/consumer.exe")
      execute_process(COMMAND "${consumer}" WORKING_DIRECTORY "${tree}"
        RESULT_VARIABLE consumer_rc OUTPUT_VARIABLE consumer_out ERROR_VARIABLE consumer_err TIMEOUT 15)
      message(STATUS "trusted-base consumer exit=${consumer_rc}; stdout=${consumer_out}; stderr=${consumer_err}")
      execute_process(COMMAND dumpbin /dependents "${consumer}" TIMEOUT 15)
    endif()
    message(FATAL_ERROR "quality_evidence: trusted base workflow failed: ${base_rc}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${tree} -DBUILD=${tree}/build/${CONFIG}
    -DOUT=${BUILD}/quality-base.json -DSHA=${base} -DCONFIG=${CONFIG} -DSOURCE=${SOURCE}
    -P "${CMAKE_CURRENT_LIST_FILE}" COMMAND_ERROR_IS_FATAL ANY)
  file(READ "${BUILD}/quality-base.json" independent)
  string(JSON previous GET "${independent}" environment)
  if(NOT previous STREQUAL environment)
    message(FATAL_ERROR "quality_evidence: incomparable base toolchain or fixtures")
  endif()
  execute_process(COMMAND git -C "${ROOT}" ls-tree --name-only "${base}" quality.json
    OUTPUT_VARIABLE present COMMAND_ERROR_IS_FATAL ANY)
  if(present STREQUAL "")
    file(WRITE "${BUILD}/quality-base-policy.json" "{\"metrics\":{}}\n")
  else()
    execute_process(COMMAND git -C "${ROOT}" show "${base}:quality.json"
      OUTPUT_FILE "${BUILD}/quality-base-policy.json" COMMAND_ERROR_IS_FATAL ANY)
  endif()
  file(WRITE "${BUILD}/quality-base-sha.txt" "${base}\n")
endif()
