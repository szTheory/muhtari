include("${CMAKE_CURRENT_LIST_DIR}/quality.cmake")
# Resolve before producing either side. The recursive current-script invocation
# reads the same event and Git object; no candidate-supplied digest is accepted.
if(BUILD_BASE OR EXISTS "$ENV{GITHUB_EVENT_PATH}")
  file(READ "$ENV{GITHUB_EVENT_PATH}" event)
  string(JSON base ERROR_VARIABLE absent GET "${event}" pull_request base sha)
  if(absent)
    string(JSON base ERROR_VARIABLE absent GET "${event}" before)
  endif()
  if(absent AND "$ENV{GITHUB_EVENT_NAME}" STREQUAL "workflow_dispatch")
    execute_process(COMMAND git -C "${ROOT}" rev-parse "$ENV{GITHUB_SHA}^1" OUTPUT_VARIABLE base
      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(absent "")
  endif()
  string(LENGTH "${base}" length)
  if(absent OR NOT length EQUAL 40 OR NOT base MATCHES "^[0-9a-f]+$" OR
      (BUILD_BASE AND base STREQUAL SHA))
    message(FATAL_ERROR "quality_evidence: independent trusted event base required")
  endif()
  execute_process(COMMAND git -C "${ROOT}" cat-file -e "${base}^{commit}" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND git -C "${ROOT}" show "${base}:tests/roms/manifest.txt"
    OUTPUT_FILE "${BUILD}/quality-trusted-manifest.txt" COMMAND_ERROR_IS_FATAL ANY)
  quality_fixture_identity(fixture "${ROOT}/tests/roms/manifest.txt" "${BUILD}/quality-trusted-manifest.txt")
  execute_process(COMMAND git -C "${ROOT}" show "${base}:tests/built/expected.txt"
    OUTPUT_FILE "${BUILD}/quality-trusted-samples.txt" COMMAND_ERROR_IS_FATAL ANY)
  quality_sample_identity(samples "${ROOT}/tests/built/expected.txt" "${BUILD}/quality-trusted-samples.txt")
else()
  file(SHA256 "${ROOT}/tests/roms/manifest.txt" fixture)
  file(SHA256 "${ROOT}/tests/built/expected.txt" samples)
endif()
include("${BUILD}/CMakeFiles/${CMAKE_VERSION}/CMakeCCompiler.cmake")
include("${BUILD}/CMakeFiles/${CMAKE_VERSION}/CMakeSystem.cmake")
set(environment "${CMAKE_C_COMPILER_ID}-${CMAKE_C_COMPILER_VERSION}-${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR};${fixture};${samples}")
string(JSON encoded STRING_ENCODE "${environment}")
string(JSON report SET "${report}" environment "${encoded}")
function(observe key units value)
  set(item "{}")
  foreach(field units producer configuration sha source status direction)
    set(producer "tests/cmake/quality_evidence.cmake")
    set(configuration "${CONFIG}")
    if(CONFIG MATCHES "^ci(-msvc)?$")
      set(configuration native)
    endif()
    set(sha "${SHA}")
    set(source "${SOURCE}")
    set(status measured)
    set(direction floor)
    if(key MATCHES "^(warnings|.*findings|archive_bytes)$")
      set(direction ceiling)
    endif()
    string(JSON encoded STRING_ENCODE "${${field}}")
    string(JSON item SET "${item}" ${field} "${encoded}")
  endforeach()
  if(value STREQUAL "unavailable")
    string(JSON item SET "${item}" status "\"unavailable\"")
    string(JSON encoded STRING_ENCODE "${ARGN}")
    string(JSON item SET "${item}" reason "${encoded}")
  else()
    string(JSON item SET "${item}" value "${value}")
  endif()
  string(JSON report SET "${report}" metrics "${key}" "${item}")
  set(report "${report}" PARENT_SCOPE)
endfunction()
set(JUNIT "${BUILD}/junit.xml")
set(INVENTORY "${ROOT}/tests/inventory/${CONFIG}.txt")
set(EXCLUDE release)
