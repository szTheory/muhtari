cmake_minimum_required(VERSION 3.25)

function(preservation_fail reason)
  message(FATAL_ERROR "diagnostic_preservation: ${reason}")
endfunction()

function(read_mode path output_var)
  if(IS_SYMLINK "${path}")
    set(${output_var} "SYMLINK" PARENT_SCOPE)
    return()
  endif()
  execute_process(COMMAND stat -f %Lp "${path}"
    RESULT_VARIABLE stat_result OUTPUT_VARIABLE mode ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT stat_result EQUAL 0)
    execute_process(COMMAND stat -c %a "${path}"
      RESULT_VARIABLE stat_result OUTPUT_VARIABLE mode ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  endif()
  if(NOT stat_result EQUAL 0 OR mode STREQUAL "")
    preservation_fail("cannot read file mode for ${path}")
  endif()
  set(${output_var} "${mode}" PARENT_SCOPE)
endfunction()

function(collect_tree abs_dir rel_dir output_var)
  file(GLOB children LIST_DIRECTORIES TRUE "${abs_dir}/*" "${abs_dir}/.*")
  set(entries)
  foreach(child IN LISTS children)
    get_filename_component(name "${child}" NAME)
    if(name STREQUAL "." OR name STREQUAL "..")
      continue()
    endif()
    set(relative "${rel_dir}/${name}")
    list(APPEND entries "${relative}")
    if(IS_DIRECTORY "${child}" AND NOT IS_SYMLINK "${child}")
      collect_tree("${child}" "${relative}" nested)
      list(APPEND entries ${nested})
    endif()
  endforeach()
  list(SORT entries)
  set(${output_var} "${entries}" PARENT_SCOPE)
endfunction()

function(compare_record root record context)
  string(JSON relative GET "${record}" path)
  string(JSON expected_type GET "${record}" type)
  string(JSON expected_mode GET "${record}" mode)
  string(JSON expected_hash GET "${record}" sha256)
  set(path "${root}/${relative}")
  if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)[.][.](/|$)")
    preservation_fail("manifest path escapes its root: ${relative}")
  endif()
  if(NOT EXISTS "${path}" AND NOT IS_SYMLINK "${path}")
    preservation_fail("historical path is missing: ${relative}")
  endif()
  if(IS_SYMLINK "${path}")
    set(actual_type symlink)
    file(READ_SYMLINK "${path}" actual_target)
    string(SHA256 actual_hash "${actual_target}")
  elseif(IS_DIRECTORY "${path}")
    set(actual_type directory)
    set(actual_target "")
    set(actual_hash "")
  else()
    set(actual_type file)
    set(actual_target "")
    file(SHA256 "${path}" actual_hash)
  endif()
  read_mode("${path}" actual_mode)
  if(NOT actual_type STREQUAL expected_type OR NOT actual_mode STREQUAL expected_mode OR NOT actual_hash STREQUAL expected_hash)
    preservation_fail("${context} path type, mode or content changed: ${relative}")
  endif()
  if(expected_type STREQUAL "symlink")
    string(JSON expected_target GET "${record}" target)
    if(NOT actual_target STREQUAL expected_target)
      preservation_fail("historical symlink target changed: ${relative}")
    endif()
  endif()
endfunction()

function(run_git root output_var error_var result_var)
  execute_process(COMMAND git -C "${root}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  set(${output_var} "${output}" PARENT_SCOPE)
  set(${error_var} "${error}" PARENT_SCOPE)
  set(${result_var} "${result}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ROOT OR NOT DEFINED MANIFEST OR NOT DEFINED MANIFEST_SHA OR NOT DEFINED MODE)
  preservation_fail("ROOT, MANIFEST, MANIFEST_SHA and MODE are required")
endif()
if(NOT MODE STREQUAL "check")
  preservation_fail("unsupported MODE ${MODE}")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
get_filename_component(MANIFEST "${MANIFEST}" ABSOLUTE BASE_DIR "${ROOT}")
if(NOT IS_DIRECTORY "${ROOT}" OR NOT EXISTS "${MANIFEST}")
  preservation_fail("ROOT or MANIFEST is missing")
endif()
cmake_path(IS_PREFIX ROOT "${MANIFEST}" NORMALIZE manifest_inside_root)
if(NOT manifest_inside_root)
  preservation_fail("MANIFEST must stay inside ROOT")
endif()
file(SHA256 "${MANIFEST}" actual_manifest_sha)
if(NOT actual_manifest_sha STREQUAL MANIFEST_SHA)
  preservation_fail("saved manifest SHA-256 mismatch")
endif()
file(READ "${MANIFEST}" manifest)
string(JSON head ERROR_VARIABLE json_error GET "${manifest}" head)
if(json_error OR NOT head MATCHES "^[0-9a-f]+$")
  preservation_fail("manifest has no valid execution-start HEAD")
endif()
string(LENGTH "${head}" head_length)
if(NOT head_length EQUAL 40)
  preservation_fail("manifest execution-start HEAD is not a full commit ID")
endif()
string(JSON starting_status GET "${manifest}" starting_status)
if(NOT starting_status STREQUAL "")
  preservation_fail("starting owner changes are present; checker requires their exact byte identity before subtracting them")
endif()

string(JSON tracked_count ERROR_VARIABLE json_error LENGTH "${manifest}" tracked)
if(json_error)
  preservation_fail("manifest tracked inventory is invalid")
endif()
if(tracked_count GREATER 0)
  math(EXPR tracked_last "${tracked_count} - 1")
  foreach(index RANGE 0 ${tracked_last})
    string(JSON item GET "${manifest}" tracked ${index})
    compare_record("${ROOT}" "${item}" tracked)
  endforeach()
endif()

string(JSON root_count ERROR_VARIABLE json_error LENGTH "${manifest}" history_roots)
if(json_error OR NOT root_count EQUAL 5)
  preservation_fail("manifest must record all five historical ignored roots")
endif()
set(expected_roots
  build/phase14-gap19-evidence
  build/phase14-gap20-evidence
  build/phase14-gap21-evidence
  build/phase14-gap22-evidence
  build/phase14-gap23-evidence)
foreach(index RANGE 0 4)
  string(JSON root_item GET "${manifest}" history_roots ${index})
  string(JSON relative_root GET "${root_item}" path)
  list(GET expected_roots ${index} expected_root)
  if(NOT relative_root STREQUAL expected_root)
    preservation_fail("historical root order or identity changed: ${relative_root}")
  endif()
  string(JSON expected_present GET "${root_item}" present)
  if(expected_present)
    set(expected_present true)
  else()
    set(expected_present false)
  endif()
  set(abs_root "${ROOT}/${relative_root}")
  if(EXISTS "${abs_root}")
    set(actual_present true)
  else()
    set(actual_present false)
  endif()
  if(NOT "${actual_present}" STREQUAL "${expected_present}")
    preservation_fail("historical root presence changed: ${relative_root}")
  endif()
  string(JSON entry_count ERROR_VARIABLE entry_error LENGTH "${root_item}" entries)
  if(entry_error)
    preservation_fail("historical root inventory is invalid: ${relative_root}")
  endif()
  set(expected_entries)
  if(entry_count GREATER 0)
    math(EXPR entry_last "${entry_count} - 1")
    foreach(entry_index RANGE 0 ${entry_last})
      string(JSON record GET "${root_item}" entries ${entry_index})
      string(JSON entry_path GET "${record}" path)
      list(APPEND expected_entries "${entry_path}")
      compare_record("${ROOT}" "${record}" historical)
    endforeach()
  endif()
  if(actual_present)
    collect_tree("${abs_root}" "${relative_root}" actual_entries)
  else()
    set(actual_entries)
  endif()
  list(SORT expected_entries)
  if(NOT "${actual_entries}" STREQUAL "${expected_entries}")
    preservation_fail("historical directory membership changed: ${relative_root}")
  endif()
endforeach()

run_git("${ROOT}" diff_output diff_error diff_result diff --name-only --no-renames "${head}" --)
if(NOT diff_result EQUAL 0)
  preservation_fail("cannot compare task-stage changes to execution-start HEAD: ${diff_error}")
endif()
run_git("${ROOT}" untracked_output untracked_error untracked_result ls-files --others --exclude-standard)
if(NOT untracked_result EQUAL 0)
  preservation_fail("cannot list new task-stage paths: ${untracked_error}")
endif()
string(REPLACE "\n" ";" changed_paths "${diff_output}")
string(REPLACE "\n" ";" untracked_paths "${untracked_output}")
list(APPEND changed_paths ${untracked_paths})
list(FILTER changed_paths EXCLUDE REGEX "^$")
list(REMOVE_DUPLICATES changed_paths)
list(SORT changed_paths)
set(allowed_paths
  tests/cmake/docker_contract.cmake
  tests/cmake/check_diagnostic_preservation.cmake
  tests/policy/docker_contract.cmake
  tests/policy/tests.cmake
  tests/inventory/ci.txt
  .planning/phases/14-proven-frontend-states-and-responsive-play/14-24-EVIDENCE.md)
list(SORT allowed_paths)
if(NOT changed_paths STREQUAL allowed_paths)
  set(missing_paths ${allowed_paths})
  foreach(path IN LISTS changed_paths)
    list(REMOVE_ITEM missing_paths "${path}")
  endforeach()
  set(extra_paths ${changed_paths})
  foreach(path IN LISTS allowed_paths)
    list(REMOVE_ITEM extra_paths "${path}")
  endforeach()
  preservation_fail("task-stage path set mismatch; missing=[${missing_paths}] extra=[${extra_paths}]")
endif()
message(STATUS "diagnostic_preservation: historical manifest and exact six-path task-stage set match")
