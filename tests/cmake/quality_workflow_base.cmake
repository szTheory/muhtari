# Fault prevented: release workflow quality producers and their aggregator using different bases.
cmake_minimum_required(VERSION 4.3)
if(NOT DEFINED WORKFLOW OR NOT EXISTS "${WORKFLOW}")
  message(FATAL_ERROR "quality_workflow_base: workflow file required")
endif()
file(READ "${WORKFLOW}" workflow)
function(quality_workflow_require_count needle expected description)
  string(REPLACE "${needle}" "" remainder "${workflow}")
  string(LENGTH "${workflow}" original_length)
  string(LENGTH "${remainder}" remainder_length)
  string(LENGTH "${needle}" needle_length)
  math(EXPR count "(${original_length}-${remainder_length})/${needle_length}")
  if(NOT count EQUAL expected)
    message(FATAL_ERROR "quality_workflow_base: expected ${expected} ${description}, found ${count}")
  endif()
endfunction()
quality_workflow_require_count("printf '{}\\n' > \"$RUNNER_TEMP/quality-event.json\"" 3 "dispatch event resets")
quality_workflow_require_count("GITHUB_EVENT_PATH=\"$RUNNER_TEMP/quality-event.json\" GITHUB_SHA=\"$(git rev-parse HEAD)\" cmake \"$@\"" 3 "producer checkout SHA overrides")
quality_workflow_require_count("base=$(git rev-parse HEAD^1)" 1 "aggregator target-parent selections")
quality_workflow_require_count("base=$(jq -r '.pull_request.base.sha // .before // empty' \"$GITHUB_EVENT_PATH\")" 1 "non-dispatch event selections")
