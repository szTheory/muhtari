# The compatibility ledger's ratchet, run as cmake -DLEDGER=<ledger.csv>
#   -DRESULTS=<results.csv> [-DALLOW=<allow.txt> -DBASE=<commit>] -P compat_ratchet.cmake
# Fault prevented: a ledger that claims what the core no longer does or hides
# what it now does, and a pull request that lowers a passing row unannounced
# (CONFORMANCE section 5). Fresh results equal the ledger's evaluated rows (tier
# pr, neither unsupported nor skipped) by status and evidence, both ways. With
# BASE, a row (id, predicate) that was pass there is pass now unless ALLOW has
# "<id> <predicate> <expiry YYYY-MM-DD> <reason>" expiring from today (UTC, or
# SOURCE_DATE_EPOCH) through 60 days on; unknown to anything and fail to pass
# need nothing. A row with a field count other than the header's, a quote or a CR fails.
cmake_minimum_required(VERSION 3.25)

# Sets rows to the text in var's rows, ";" kept as <semicolon>; checks fields.
macro(ratchet_rows label var want)
  if("${${var}}" MATCHES "[\"\r]")
    list(APPEND bad "${label} holds a quote or a carriage return")
  endif()
  string(REPLACE ";" "<semicolon>" rows "${${var}}")
  string(REGEX REPLACE "\n$" "" rows "${rows}")
  string(REPLACE "\n" ";" rows "${rows}")
  list(POP_FRONT rows)
  foreach(row IN LISTS rows)
    string(REPLACE "," ";" f "${row}")
    list(LENGTH f count)
    if(NOT count EQUAL ${want})
      list(APPEND bad "${label} row '${row}' has ${count} fields, not ${want}")
    endif()
  endforeach()
endmacro()
file(READ "${LEDGER}" text)
ratchet_rows("${LEDGER}" text 16)
foreach(row IN LISTS rows)
  string(REPLACE "," ";" f "${row}")
  list(GET f 0 9 10 11 13 g)
  list(POP_FRONT g id predicate status tier evidence)
  set("now ${id} ${predicate}" ${status})
  if(tier STREQUAL "pr" AND NOT status MATCHES "^(unsupported|skipped)$")
    set("ledger ${id} ${predicate}" "${status} ${evidence}")
    list(APPEND keys "${id} ${predicate}")
  endif()
endforeach()
file(READ "${RESULTS}" text)
ratchet_rows("${RESULTS}" text 4)
foreach(row IN LISTS rows)
  string(REPLACE "," ";" f "${row}")
  list(POP_FRONT f id predicate status evidence)
  set(name "ledger ${id} ${predicate}")
  if(NOT DEFINED "${name}")
    list(APPEND bad "${id} ${predicate}: a result, but no evaluated ledger row")
  elseif(NOT "${${name}}" STREQUAL "${status} ${evidence}")
    list(APPEND bad "${id} ${predicate}: ledger ${${name}}, results ${status} ${evidence}")
  endif()
  list(REMOVE_ITEM keys "${id} ${predicate}")
endforeach()
foreach(key IN LISTS keys)
  list(APPEND bad "${key}: an evaluated ledger row, but no result")
endforeach()
if(NOT "${BASE}" STREQUAL "")
  # Today and the last expiry allowed: the UTC dates of now and 60 days on.
  string(TIMESTAMP now "%s" UTC)
  string(TIMESTAMP today "%Y-%m-%d" UTC)
  math(EXPR later "${now} + 60 * 86400")
  set(ENV{SOURCE_DATE_EPOCH} ${later})
  string(TIMESTAMP limit "%Y-%m-%d" UTC)
  file(READ "${ALLOW}" text)
  string(REPLACE ";" "<semicolon>" text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  foreach(line IN LISTS lines)
    if(line MATCHES "^([^# ][^ ]* [^ ]+) ([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) [^ ]")
      if(NOT CMAKE_MATCH_2 STRLESS today AND NOT CMAKE_MATCH_2 STRGREATER limit)
        list(APPEND allowed "${CMAKE_MATCH_1}")
      endif()
    elseif(NOT line MATCHES "^(#|$)")
      list(APPEND bad "${ALLOW}: malformed line '${line}'")
    endif()
  endforeach()
  # The base must be in the clone; git show fails only before the ledger existed.
  find_program(GIT git REQUIRED)
  get_filename_component(dir "${LEDGER}" DIRECTORY)
  execute_process(COMMAND ${GIT} -C ${dir} cat-file -e ${BASE}^{commit} COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND ${GIT} -C ${dir} show ${BASE}:tests/compat/ledger.csv
    OUTPUT_VARIABLE text ERROR_QUIET)
  ratchet_rows("${BASE}:tests/compat/ledger.csv" text 16)
  foreach(row IN LISTS rows)
    string(REPLACE "," ";" f "${row}")
    list(GET f 0 9 10 g)
    list(POP_FRONT g id predicate status)
    set(name "now ${id} ${predicate}")
    if(status STREQUAL "pass" AND NOT "${${name}}" STREQUAL "pass"
       AND NOT "${id} ${predicate}" IN_LIST allowed)
      list(APPEND bad "${id} ${predicate}: pass at ${BASE}, now '${${name}}' with no allow line")
    endif()
  endforeach()
endif()
if(bad)
  list(JOIN bad "\n  " bad)
  string(REPLACE "<semicolon>" ";" bad "${bad}")
  message(FATAL_ERROR "ratchet:\n  ${bad}")
endif()
message(STATUS "ratchet: results equal the ledger")
