# Fault prevented: omitted lanes, mixed commits/runs or forged baselines passing the aggregate.
cmake_minimum_required(VERSION 4.3)
set(QUALITY_FUNCTIONS_ONLY ON)
include("${CMAKE_CURRENT_LIST_DIR}/quality.cmake")
file(REAL_PATH "${DIRECTORY}" DIRECTORY)
file(READ "${POLICY}" policy)
file(READ "${BASE_POLICY}" trusted)
set(lanes asan hygiene linux-arm64 linux-x64 macos-arm64 macos-x64 windows-arm64 windows-x64)
set(expected "")
foreach(lane IN LISTS lanes)
  list(APPEND expected "quality-${lane}")
endforeach()
if(PERF_REQUIRED)
  list(APPEND expected quality-perf)
endif()
file(GLOB actual RELATIVE "${DIRECTORY}" "${DIRECTORY}/*")
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "quality_join: exact artifact set required")
endif()
set(joined_current "{\"metrics\":{}}")
set(joined_base "{\"metrics\":{}}")
string(JSON count LENGTH "${policy}" metrics)
math(EXPR last "${count}-1")
foreach(lane IN LISTS lanes)
  set(dir "${DIRECTORY}/quality-${lane}")
  file(GLOB files "${dir}/*")
  list(LENGTH files count)
  file(READ "${dir}/quality-base-sha.txt" sha)
  string(STRIP "${sha}" sha)
  file(READ "${dir}/quality-base-policy.json" prior)
  if(NOT count EQUAL 4 OR NOT sha STREQUAL BASE_SHA OR NOT prior STREQUAL trusted)
    message(FATAL_ERROR "quality_join: trusted base mismatch ${lane}")
  endif()
  file(READ "${dir}/quality-current.json" current)
  file(READ "${dir}/quality-base.json" base)
  quality_get(a "${current}" STRING environment)
  quality_get(b "${base}" STRING environment)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "quality_join: incomparable environment ${lane}")
  endif()
  set(configuration native)
  if(lane STREQUAL "asan" OR lane STREQUAL "hygiene")
    set(configuration "${lane}")
  endif()
  foreach(i RANGE ${last})
    string(JSON key MEMBER "${policy}" metrics ${i})
    quality_get(config "${policy}" STRING metrics "${key}" configuration)
    quality_get(direction "${policy}" STRING metrics "${key}" direction)
    if(NOT config STREQUAL configuration AND NOT (configuration STREQUAL "native" AND key STREQUAL "gate_lines"))
      continue()
    endif()
    foreach(side current base)
      set(expected_sha "${EXPECTED_SHA}")
      if(side STREQUAL "base")
        set(expected_sha "${BASE_SHA}")
      endif()
      quality_get(item "${${side}}" OBJECT metrics "${key}")
      foreach(field sha source units producer configuration direction)
        quality_get(a "${item}" STRING "${field}")
        set(b "${expected_sha}")
        if(field STREQUAL "source")
          set(b "${SOURCE}")
        elseif(NOT field STREQUAL "sha")
          quality_get(b "${policy}" STRING metrics "${key}" "${field}")
        endif()
        if(NOT a STREQUAL b)
          message(FATAL_ERROR "quality_join: identity ${lane}.${key}.${field}")
        endif()
      endforeach()
      quality_get(status "${item}" STRING status)
      if(status STREQUAL "measured")
        quality_get(value "${item}" NUMBER value)
        string(JSON old ERROR_VARIABLE missing GET "${joined_${side}}" metrics "${key}" value)
        # Preserve the worst actual value; the existing judge owns all threshold decisions.
        if(NOT missing AND ((direction STREQUAL "ceiling" AND value LESS old) OR (direction STREQUAL "floor" AND value GREATER old)))
          continue()
        endif()
      elseif(NOT side STREQUAL "base" OR NOT key STREQUAL "gate_lines" OR NOT status STREQUAL "unavailable")
        message(FATAL_ERROR "quality_join: required evidence ${lane}.${key}")
      endif()
      string(JSON joined_${side} SET "${joined_${side}}" metrics "${key}" "${item}")
    endforeach()
  endforeach()
endforeach()
foreach(side current base)
  file(WRITE "${OUT}/${side}.json" "${joined_${side}}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -DPOLICY=${POLICY} -DBASE_POLICY=${BASE_POLICY}
  -DOBSERVATIONS=${OUT}/current.json -DBASELINE=${OUT}/base.json -DEXPECTED_SHA=${EXPECTED_SHA}
  -DBASE_SHA=${BASE_SHA} -DINITIAL_GATE_CEILING=14853 -P "${CMAKE_CURRENT_LIST_DIR}/quality.cmake"
  COMMAND_ERROR_IS_FATAL ANY)
if(PERF_REQUIRED)
  file(READ "${DIRECTORY}/quality-perf/quality-perf.json" perf)
  quality_get(value "${perf}" NUMBER value)
  foreach(field tools units producer configuration status availability direction)
    quality_get(value "${perf}" STRING "${field}")
  endforeach()
  foreach(field sha base_sha source)
    quality_get(value "${perf}" STRING "${field}")
    string(TOUPPER "${field}" variable)
    if(field STREQUAL "sha")
      set(variable EXPECTED_SHA)
    endif()
    if(NOT value STREQUAL "${${variable}}")
      message(FATAL_ERROR "quality_join: perf provenance ${field}")
    endif()
  endforeach()
  message(STATUS "quality: advisory testcard Ir ${perf}")
else()
  message(STATUS "quality: testcard Ir unavailable; comparable perf not requested")
endif()
message(STATUS "quality: unavailable coverage, open_crashes, backlog, duration; library/wasm32/property advisory")
