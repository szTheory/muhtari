# Firmware and known-ROM scan, run as
#   cmake -DZIPS=<zip, glob or list> -DFIRMWARE=<list> -DEXPECTED=<list>
#         -DCARTDB=<cartdb.c> -P firmware_scan.cmake
#   cmake -DTRACKED=1 -DROOT=<tree> [-DGIT=<git>] -DFIRMWARE=... -P firmware_scan.cmake
# Fault prevented: firmware, a built sample or a known ROM shipping inside a
# release zip or entering the tree (ASSET_POLICY.md sections 1 and 5). Each
# member of each zip, or each file git tracks under ROOT, is hashed with SHA-1
# and SHA-256 whole and, when bytes 1-9 are ATARI7800 (the A78 header,
# ASSET_POLICY.md [AP.06]), again without its first 128 bytes. A digest in
# FIRMWARE, a SHA-256 in EXPECTED, a 7800 SHA-1 in CARTDB or a SHA-1 whose
# first 8 bytes are a CARTDB 2600 prefix fails, naming the file and the entry.
# Zips are extracted outside their own directories, and a zip that yields no
# member fails, so an empty or truncated release cannot pass.
cmake_minimum_required(VERSION 3.25)
foreach(var FIRMWARE EXPECTED CARTDB)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "firmware_scan: -D${var} is required")
  endif()
endforeach()

# Every list becomes one variable per digest, fw_<hex>, holding its name.
file(STRINGS "${FIRMWARE}" rows REGEX "^[^#]")
foreach(row IN LISTS rows)
  if(NOT row MATCHES "^(sha1|sha256) ([0-9a-f]+) (.+)$")
    message(FATAL_ERROR "firmware_scan: ${FIRMWARE}: bad row: ${row}")
  endif()
  string(LENGTH "${CMAKE_MATCH_2}" len)
  if(NOT (CMAKE_MATCH_1 STREQUAL "sha1" AND len EQUAL 40)
      AND NOT (CMAKE_MATCH_1 STREQUAL "sha256" AND len EQUAL 64))
    message(FATAL_ERROR "firmware_scan: ${FIRMWARE}: bad digest: ${row}")
  endif()
  set(fw_${CMAKE_MATCH_2} "${CMAKE_MATCH_3}")
endforeach()

file(STRINGS "${EXPECTED}" rows REGEX "^[^#]")
foreach(row IN LISTS rows)
  string(REGEX MATCHALL "[^ \t]+" fields "${row}")
  list(GET fields 0 sample)
  foreach(field IN LISTS fields)
    string(LENGTH "${field}" len)
    if(len EQUAL 64 AND field MATCHES "^[0-9a-f]+$")
      set(fw_${field} "built sample ${sample}")
    endif()
  endforeach()
endforeach()

# cartdb.c holds one key per line: {{0x..,...},entry,layout} inside the 7800
# keys array and {0x..,...} inside the 2600 prefix array.
file(STRINGS "${CARTDB}" lines)
set(section "")
set(n7800 0)
set(n2600 0)
foreach(line IN LISTS lines)
  if(line MATCHES "muhtari__cartdb_7800_keys\\[\\] = {")
    set(section 7800)
  elseif(line MATCHES "muhtari__cartdb_2600_prefix\\[\\]\\[8\\] = {")
    set(section 2600)
  elseif(line MATCHES "^}")
    set(section "")
  elseif(line MATCHES "muhtari__cartdb_7800_key_count = ([0-9]+)")
    set(declared7800 ${CMAKE_MATCH_1})
  elseif(line MATCHES "muhtari__cartdb_2600_prefix_count = ([0-9]+)")
    set(declared2600 ${CMAKE_MATCH_1})
  elseif(section STREQUAL "7800" AND line MATCHES "^{{(0x[0-9a-f][0-9a-f](,0x[0-9a-f][0-9a-f])*)}")
    string(REPLACE "0x" "" hex "${CMAKE_MATCH_1}")
    string(REPLACE "," "" hex "${hex}")
    set(fw_${hex} "cartdb.c 7800 key")
    math(EXPR n7800 "${n7800} + 1")
  elseif(section STREQUAL "2600" AND line MATCHES "^{(0x[0-9a-f][0-9a-f](,0x[0-9a-f][0-9a-f])*)}")
    string(REPLACE "0x" "" hex "${CMAKE_MATCH_1}")
    string(REPLACE "," "" hex "${hex}")
    set(fw_${hex} "cartdb.c 2600 prefix ${hex}")
    math(EXPR n2600 "${n2600} + 1")
  endif()
endforeach()
foreach(pair "7800;7800 keys" "2600;2600 prefixes")
  list(GET pair 0 sys)
  list(GET pair 1 what)
  if(n${sys} EQUAL 0 OR NOT "${n${sys}}" STREQUAL "${declared${sys}}")
    message(FATAL_ERROR "firmware_scan: cartdb.c: parsed ${n${sys}} ${what}, declared ${declared${sys}}")
  endif()
endforeach()
message(STATUS "firmware_scan: ${n7800} 7800 keys, ${n2600} 2600 prefixes loaded")

# A fresh directory under the system's temporary directory.
set(tmp "$ENV{RUNNER_TEMP}")
foreach(env TMPDIR TEMP TMP)
  if(tmp STREQUAL "" AND NOT "$ENV{${env}}" STREQUAL "")
    set(tmp "$ENV{${env}}")
  endif()
endforeach()
if(tmp STREQUAL "")
  set(tmp /tmp)
endif()
file(TO_CMAKE_PATH "${tmp}" tmp)
string(REGEX REPLACE "(.)/+$" "\\1" tmp "${tmp}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(work "${tmp}/muhtari-firmware-scan-${id}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")

macro(scan_fail text)
  file(REMOVE_RECURSE "${work}")
  message(FATAL_ERROR "${text}")
endmacro()

# Appends "<label>: matches <name>" to found for every listed digest of file.
set(found "")
function(scan_file file label)
  file(SHA1 "${file}" s1)
  file(SHA256 "${file}" s256)
  set(digests "${s1}" "${s256}")
  file(SIZE "${file}" size)
  if(size GREATER 128)
    file(READ "${file}" magic OFFSET 1 LIMIT 9)
    if(magic STREQUAL "ATARI7800")
      # file(DOWNLOAD) of a file:// URL is the one CMake call that copies a
      # byte range, NULs included.
      set(url "${work}/stripped.input")
      file(COPY_FILE "${file}" "${url}")
      if(NOT url MATCHES "^/")
        set(url "/${url}")
      endif()
      string(REPLACE "%" "%25" url "${url}")
      string(REPLACE " " "%20" url "${url}")
      file(DOWNLOAD "file://${url}" "${work}/stripped" RANGE_START 128 STATUS st)
      list(GET st 0 rc)
      if(NOT rc EQUAL 0)
        scan_fail("firmware_scan: ${label}: cannot strip its header: ${st}")
      endif()
      file(SHA1 "${work}/stripped" h1)
      file(SHA256 "${work}/stripped" h256)
      list(APPEND digests "${h1} (header stripped)" "${h256} (header stripped)")
    endif()
  endif()
  foreach(entry IN LISTS digests)
    string(REGEX MATCH "^[0-9a-f]+" hex "${entry}")
    string(REPLACE "${hex}" "" note "${entry}")
    set(keys "${hex}")
    string(LENGTH "${hex}" len)
    if(len EQUAL 40)
      string(SUBSTRING "${hex}" 0 16 prefix)
      list(APPEND keys "${prefix}")
    endif()
    foreach(key IN LISTS keys)
      if(DEFINED fw_${key})
        list(APPEND found "${label}: matches ${fw_${key}}${note}")
      endif()
    endforeach()
  endforeach()
  set(found "${found}" PARENT_SCOPE)
endfunction()

set(count 0)
if(TRACKED)
  if("${ROOT}" STREQUAL "")
    scan_fail("firmware_scan: -DROOT is required with -DTRACKED=1")
  endif()
  find_program(GIT git REQUIRED)
  execute_process(COMMAND "${GIT}" -c core.quotePath=false ls-files
    WORKING_DIRECTORY "${ROOT}" RESULT_VARIABLE rc OUTPUT_VARIABLE out)
  if(NOT rc EQUAL 0)
    scan_fail("firmware_scan: git ls-files failed in ${ROOT}")
  endif()
  string(REPLACE "\n" ";" files "${out}")
  foreach(rel IN LISTS files)
    if(NOT rel STREQUAL "" AND EXISTS "${ROOT}/${rel}" AND NOT IS_DIRECTORY "${ROOT}/${rel}")
      scan_file("${ROOT}/${rel}" "${rel}")
      math(EXPR count "${count} + 1")
    endif()
  endforeach()
  set(what "${count} tracked files")
else()
  set(zips "")
  foreach(item IN LISTS ZIPS)
    if(item MATCHES "[*?]")
      file(GLOB matched LIST_DIRECTORIES false "${item}")
      list(APPEND zips ${matched})
    else()
      list(APPEND zips "${item}")
    endif()
  endforeach()
  if(zips STREQUAL "")
    scan_fail("firmware_scan: no zip matches -DZIPS=${ZIPS}")
  endif()
  set(i 0)
  foreach(zip IN LISTS zips)
    get_filename_component(zip "${zip}" ABSOLUTE)
    get_filename_component(name "${zip}" NAME)
    get_filename_component(dir "${zip}" DIRECTORY)
    cmake_path(IS_PREFIX dir "${work}" NORMALIZE inside)
    if(inside)
      scan_fail("firmware_scan: ${work} is inside ${dir}")
    endif()
    math(EXPR i "${i} + 1")
    set(out "${work}/${i}")
    file(MAKE_DIRECTORY "${out}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${zip}"
      WORKING_DIRECTORY "${out}" RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE log)
    if(NOT rc EQUAL 0)
      scan_fail("firmware_scan: ${name}: cannot extract: ${log}")
    endif()
    file(GLOB_RECURSE members LIST_DIRECTORIES false RELATIVE "${out}" "${out}/*")
    if(members STREQUAL "")
      scan_fail("firmware_scan: ${name} yields no member")
    endif()
    foreach(member IN LISTS members)
      scan_file("${out}/${member}" "${name}/${member}")
      math(EXPR count "${count} + 1")
    endforeach()
    file(REMOVE_RECURSE "${out}")
  endforeach()
  list(LENGTH zips nzips)
  set(what "${count} members of ${nzips} zips")
endif()

file(REMOVE_RECURSE "${work}")
if(NOT found STREQUAL "")
  list(LENGTH found n)
  list(JOIN found "\n  " text)
  message(FATAL_ERROR "firmware_scan: ${n} listed digests found in ${what}\n  ${text}")
endif()
message(STATUS "firmware_scan: ${what}, none listed")
