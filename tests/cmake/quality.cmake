# Fault prevented: a policy edit or untrusted observation concealing a regression.
# POLICY/BASE_POLICY and OBSERVATIONS/BASELINE are separate, metadata-bound inputs.
cmake_minimum_required(VERSION 4.3)
function(quality_get out json type)
  string(JSON actual ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error OR NOT actual STREQUAL type)
    message(FATAL_ERROR "quality: typed ${type} required at ${ARGN}")
  endif()
  string(JSON value GET "${json}" ${ARGN})
  if((type STREQUAL "STRING" AND NOT value MATCHES "[^ \t\r\n]") OR
      (type STREQUAL "NUMBER" AND NOT value MATCHES "^[0-9]+$"))
    message(FATAL_ERROR "quality: nonempty string or nonnegative integer required at ${ARGN}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(quality_date out date)
  if(NOT date MATCHES "^([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])$")
    message(FATAL_ERROR "quality: invalid calendar date ${date}")
  endif()
  math(EXPR y "1${CMAKE_MATCH_1} - 10000")
  math(EXPR m "1${CMAKE_MATCH_2} - 100")
  math(EXPR d "1${CMAKE_MATCH_3} - 100")
  # CMake math has no comparisons; use normal conditions for calendar arithmetic.
  set(leap 0)
  math(EXPR r4 "${y}%4")
  math(EXPR r100 "${y}%100")
  math(EXPR r400 "${y}%400")
  if(r4 EQUAL 0 AND (NOT r100 EQUAL 0 OR r400 EQUAL 0))
    set(leap 1)
  endif()
  set(days 31 28 31 30 31 30 31 31 30 31 30 31)
  if(y LESS 1970 OR m LESS 1 OR m GREATER 12 OR d LESS 1)
    message(FATAL_ERROR "quality: invalid calendar date ${date}")
  endif()
  math(EXPR index "${m}-1")
  list(GET days ${index} limit)
  if(m EQUAL 2)
    math(EXPR limit "${limit}+${leap}")
  endif()
  if(d GREATER limit)
    message(FATAL_ERROR "quality: invalid calendar date ${date}")
  endif()
  math(EXPR prior "${y}-1")
  math(EXPR ordinal "${prior}*365+${prior}/4-${prior}/100+${prior}/400+${d}")
  while(index GREATER 0)
    math(EXPR index "${index}-1")
    list(GET days ${index} count)
    math(EXPR ordinal "${ordinal}+${count}")
  endwhile()
  if(m GREATER 2)
    math(EXPR ordinal "${ordinal}+${leap}")
  endif()
  set(${out} "${ordinal}" PARENT_SCOPE)
endfunction()

function(quality_reasons json prefix)
  string(JSON type ERROR_VARIABLE error TYPE "${json}" reasons)
  if(error)
    set(${prefix}_keys "" PARENT_SCOPE)
    return()
  endif()
  quality_get(reasons "${json}" ARRAY reasons)
  string(JSON count LENGTH "${reasons}")
  set(keys "")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE ${last})
      quality_get(reason "${reasons}" OBJECT ${i})
      foreach(field key why date expires)
        quality_get(${field} "${reason}" STRING ${field})
      endforeach()
      foreach(field from to)
        quality_get(${field} "${reason}" NUMBER ${field})
      endforeach()
      quality_get(metric "${json}" OBJECT metrics "${key}")
      quality_get(direction "${metric}" STRING direction)
      quality_get(bound "${metric}" NUMBER "${direction}")
      quality_date(grant "${date}")
      quality_date(expiry "${expires}")
      math(EXPR lifetime "${expiry}-${grant}")
      if(key IN_LIST keys OR grant GREATER today OR expiry LESS today OR lifetime LESS 0 OR lifetime GREATER 60)
        message(FATAL_ERROR "quality: expired, duplicate or invalid lifetime reason ${key}")
      endif()
      if(NOT bound EQUAL to OR (direction STREQUAL "ceiling" AND NOT to GREATER from) OR
          (direction STREQUAL "floor" AND NOT to LESS from))
        message(FATAL_ERROR "quality: unrelated reason ${key}")
      endif()
      if(key STREQUAL "gate_lines")
        quality_get(exit "${reason}" STRING exit)
      endif()
      list(APPEND keys "${key}")
      set(${prefix}_${key} "${reason}" PARENT_SCOPE)
    endforeach()
  endif()
  set(${prefix}_keys "${keys}" PARENT_SCOPE)
endfunction()

# Validate the original observation before callers reduce or judge its value.
macro(quality_observation json sha fields expected_source)
  quality_get(observation "${json}" OBJECT metrics "${key}")
  quality_get(built "${observation}" STRING sha)
  quality_get(source "${observation}" STRING source)
  if(NOT built STREQUAL "${sha}" OR NOT source MATCHES "^https://github[.]com/[^/]+/[^/]+/actions/runs/[0-9]+$" OR
      (NOT "${expected_source}" STREQUAL "" AND NOT source STREQUAL "${expected_source}"))
    message(FATAL_ERROR "quality: commit or source mismatch ${key}; sha=${built}, expected=${sha}")
  endif()
  foreach(field ${fields})
    quality_get(a "${metric}" STRING "${field}")
    quality_get(b "${observation}" STRING "${field}")
    if(NOT a STREQUAL b)
      message(FATAL_ERROR "quality: observation identity ${key}.${field}")
    endif()
  endforeach()
  quality_get(status "${observation}" STRING status)
endmacro()

if(QUALITY_FUNCTIONS_ONLY)
  return()
endif()
foreach(input POLICY BASE_POLICY OBSERVATIONS BASELINE)
  if(NOT EXISTS "${${input}}")
    message(FATAL_ERROR "quality: missing ${input}")
  endif()
  file(READ "${${input}}" ${input})
  quality_get(unused "${${input}}" OBJECT metrics)
endforeach()
foreach(sha EXPECTED_SHA BASE_SHA)
  string(LENGTH "${${sha}}" length)
  if(NOT length EQUAL 40 OR NOT "${${sha}}" MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "quality: invalid ${sha}")
  endif()
endforeach()
if(EXPECTED_SHA STREQUAL BASE_SHA)
  message(FATAL_ERROR "quality: independent baseline SHA required")
endif()
string(TIMESTAMP date "%Y-%m-%d" UTC)
quality_date(today "${date}")
quality_reasons("${BASE_POLICY}" old)
quality_reasons("${POLICY}" new)
foreach(key IN LISTS old_keys)
  if(key IN_LIST new_keys AND NOT "${old_${key}}" STREQUAL "${new_${key}}")
    message(FATAL_ERROR "quality: reason renewal ${key}")
  endif()
endforeach()
string(JSON count LENGTH "${BASE_POLICY}" metrics)
if(count GREATER 0)
  math(EXPR last "${count}-1")
  foreach(i RANGE ${last})
    string(JSON key MEMBER "${BASE_POLICY}" metrics ${i})
    quality_get(unused "${POLICY}" OBJECT metrics "${key}")
  endforeach()
endif()
string(JSON count LENGTH "${POLICY}" metrics)
if(count LESS 1)
  message(FATAL_ERROR "quality: empty policy")
endif()
math(EXPR last "${count}-1")
foreach(i RANGE ${last})
  string(JSON key MEMBER "${POLICY}" metrics ${i})
  quality_get(metric "${POLICY}" OBJECT metrics "${key}")
  quality_get(direction "${metric}" STRING direction)
  if(NOT direction MATCHES "^(floor|ceiling)$")
    message(FATAL_ERROR "quality: invalid direction ${key}")
  endif()
  quality_get(bound "${metric}" NUMBER "${direction}")
  quality_get(units "${metric}" STRING units)
  string(JSON prior ERROR_VARIABLE absent GET "${BASE_POLICY}" metrics "${key}")
  if(NOT absent)
    foreach(field direction units producer configuration)
      quality_get(a "${metric}" STRING ${field})
      quality_get(b "${prior}" STRING ${field})
      if(NOT a STREQUAL b)
        message(FATAL_ERROR "quality: identity changed ${key}.${field}")
      endif()
    endforeach()
    string(JSON availability ERROR_VARIABLE legacy GET "${prior}" availability)
    if(legacy)
      set(availability required)
    endif()
    quality_get(current "${metric}" STRING availability)
    if(NOT current STREQUAL availability)
      message(FATAL_ERROR "quality: availability changed ${key}")
    endif()
    quality_get(previous "${prior}" NUMBER "${direction}")
    if(key IN_LIST old_keys)
      quality_get(previous "${old_${key}}" NUMBER from)
    endif()
  else()
    if(key STREQUAL "gate_lines" AND DEFINED INITIAL_GATE_CEILING AND bound EQUAL INITIAL_GATE_CEILING)
      # The caller verifies the reviewed structural allocation before this one adoption.
      set(previous "${bound}")
    else()
      quality_get(previous "${BASELINE}" NUMBER metrics "${key}" value)
    endif()
  endif()
  if((direction STREQUAL "ceiling" AND bound GREATER previous) OR
      (direction STREQUAL "floor" AND bound LESS previous))
    if(NOT key IN_LIST new_keys)
      message(FATAL_ERROR "quality: unexplained loosening ${key}")
    endif()
    quality_get(from "${new_${key}}" NUMBER from)
    if(NOT from EQUAL previous)
      message(FATAL_ERROR "quality: unrelated from ${key}")
    endif()
  endif()
  quality_get(availability "${metric}" STRING availability)
  if(NOT availability MATCHES "^(required|advisory)$")
    message(FATAL_ERROR "quality: invalid availability ${key}")
  endif()
  foreach(input OBSERVATIONS BASELINE)
    set(sha "${EXPECTED_SHA}")
    if(input STREQUAL "BASELINE")
      set(sha "${BASE_SHA}")
    endif()
    quality_observation("${${input}}" "${sha}" "units;producer;configuration" "")
    if(input STREQUAL "BASELINE" AND absent AND key STREQUAL "gate_lines" AND
        DEFINED INITIAL_GATE_CEILING AND bound EQUAL INITIAL_GATE_CEILING AND status STREQUAL "unavailable")
      message(STATUS "quality: gate_lines structural initialization ${bound}; pre-policy base")
      continue()
    endif()
    if(status STREQUAL "unavailable" AND availability STREQUAL "advisory")
      quality_get(gap "${observation}" STRING reason)
      message(STATUS "quality: ${key} unavailable (${gap})")
      continue()
    elseif(NOT status STREQUAL "measured")
      message(FATAL_ERROR "quality: required evidence ${key}")
    endif()
    quality_get(value "${observation}" NUMBER value)
    if(input STREQUAL "OBSERVATIONS" AND ((direction STREQUAL "ceiling" AND value GREATER bound) OR
        (direction STREQUAL "floor" AND value LESS bound)))
      message(FATAL_ERROR "quality: measured regression ${key}: ${value}, ${direction} ${bound}")
    endif()
    message(STATUS "quality: ${key} ${input} ${value} ${units}; ${direction} ${bound}; ${availability}; ${source}; reason=${new_${key}}")
  endforeach()
endforeach()
