# The hashes every lane prints, and their comparison across lanes, run as
#   cmake -DMODE=write -DRUN=<muhtari-run> -DDRIVER=<muhtari-test-diag>
#     -DDIAG=<tests/diag> [-DEMULATOR=<list>] -DOUT=<dir> -P hashes.cmake
#   cmake -DMODE=compare -DFILES=<list> -DCOUNT=<n> -P hashes.cmake

# Declared bounded workload, never inferred from files a producer happened to emit.
function(hashes_memory_cases result)
  set(cases "")
  foreach(case 32n 32s 32h 48n 52n 128n 128s 128h 256n 256s 256h 512n 512s 512h 32h-pal 512s-pal)
    list(APPEND cases "bankset.${case}")
  endforeach()
  foreach(page RANGE 0 7)
    list(APPEND cases "expansion.1-${page}-0-0-0-2-pages")
  endforeach()
  foreach(page RANGE 0 15)
    foreach(window 0 1)
      list(APPEND cases "expansion.2-${page}-${window}-0-0-2-pages")
    endforeach()
  endforeach()
  foreach(profile 1 2)
    foreach(pal 0 1)
      foreach(dual 0 1)
        foreach(gate 0 1 2)
          list(APPEND cases "expansion.${profile}-3-0-${pal}-${dual}-${gate}-gates")
        endforeach()
      endforeach()
    endforeach()
    list(APPEND cases "expansion.${profile}-3-0-0-2-2-undeclared")
  endforeach()
  set(${result} "${cases}" PARENT_SCOPE)
endfunction()

function(hashes_memory_identity family result)
  set(diag "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../diag")
  file(STRINGS "${diag}/../roms/manifest.txt" row REGEX "^tests/diag/${family}[.]a78\t")
  string(REPLACE "\t" ";" fields "${row}")
  list(LENGTH fields count)
  if(NOT count EQUAL 6)
    message(FATAL_ERROR "hashes: ${family} missing admitted identity")
  endif()
  list(GET fields 2 source)
  list(GET fields 4 template)
  file(SHA256 "${diag}/${family}.s" source_hash)
  file(SHA256 "${diag}/${family}.cfg" config_hash)
  file(SHA256 "${diag}/${family}.a78" actual)
  if(NOT actual STREQUAL template)
    message(FATAL_ERROR "hashes: ${family} template identity mismatch")
  endif()
  set(${result} "source_commit ${source}\nsource_sha256 ${source_hash}\nconfig_sha256 ${config_hash}\ntemplate_sha256 ${template}\n" PARENT_SCOPE)
endfunction()

# The real script has already judged pages, storage, raw sources and PCM. Judge
# the submitted mailbox again here before allowing any canonical report rows.
function(hashes_memory_report prefix scenario image reference observed result)
  string(REGEX MATCH "^[^.]+" family "${prefix}")
  hashes_memory_cases(cases)
  if(NOT prefix IN_LIST cases)
    message(FATAL_ERROR "hashes: undeclared memory scenario ${prefix}")
  endif()
  string(REGEX MATCHALL "[^\n]+" lines "${observed}")
  list(LENGTH lines count)
  if(NOT count EQUAL 21 OR NOT observed MATCHES "\n$" OR observed MATCHES "\r|^\n|\n\n")
    message(FATAL_ERROR "hashes: ${prefix} expected complete twenty-one-field memory report")
  endif()
  set(patterns "")
  foreach(frame RANGE 1 12)
    list(APPEND patterns "^frame ${frame} sha256 ([0-9a-f]+)$")
  endforeach()
  if(family STREQUAL bankset)
    string(REGEX REPLACE "^bankset[.]([0-9]+[nsh])(-pal)?$" "bankset\\1" expected_scenario "${prefix}")
  else()
    string(REGEX MATCH "^expansion[.]([12])-([0-9]+)-" parsed "${prefix}")
    set(profile "${CMAKE_MATCH_1}")
    set(page "${CMAKE_MATCH_2}")
    set(letter x)
    if(profile EQUAL 2)
      set(letter m)
    endif()
    set(expected_scenario "expansion-${letter}${page}")
  endif()
  if(NOT scenario STREQUAL expected_scenario)
    message(FATAL_ERROR "hashes: ${prefix} wrong memory scenario identity ${scenario}")
  endif()
  set(samples 8861)
  if(prefix MATCHES "-pal$|^expansion[.][12]-[0-9]+-[01]-1-")
    set(samples 11537)
  endif()
  list(APPEND patterns "^lag_frames (0|[1-9]|1[0-2])$" "^audio_transitions_sha256 ([0-9a-f]+)$"
    "^audio_pcm_sha256 ([0-9a-f]+)$" "^audio_frames 12$" "^audio_samples ${samples}$"
    "^audio_rate 48000/1$" "^audio_behaviour_revision 6$"
    "^audio_synthesis exact-q23-16x64-dc20$" "^diagnostic ([0-9a-f]+)$")
  set(content "")
  foreach(i RANGE 0 20)
    list(GET lines ${i} line)
    list(GET patterns ${i} pattern)
    if(NOT line MATCHES "${pattern}")
      message(FATAL_ERROR "hashes: ${prefix} malformed memory field ${i}: ${line}")
    endif()
    if(i LESS 12 OR i EQUAL 13 OR i EQUAL 14 OR i EQUAL 20)
      string(LENGTH "${CMAKE_MATCH_1}" length)
      set(want 64)
      if(i EQUAL 20)
        set(want 512)
      endif()
      if(NOT length EQUAL want)
        message(FATAL_ERROR "hashes: ${prefix} malformed memory digest length")
      endif()
    endif()
    string(REGEX REPLACE "^frame ([0-9]+) sha256 " "frame\\1 " row "${line}")
    string(APPEND content "${prefix}.${row}\n")
  endforeach()
  file(MAKE_DIRECTORY "${OUT}")
  file(CONFIGURE OUTPUT "${OUT}/hashes-memory-mailbox.txt" CONTENT "${line}\n" @ONLY NEWLINE_STYLE UNIX)
  execute_process(COMMAND ${EMULATOR} "${DRIVER}" --mailbox "${OUT}/hashes-memory-mailbox.txt"
    "${scenario}" "${DIAG}/expected.csv" RESULT_VARIABLE rc OUTPUT_VARIABLE verdict ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "hashes: ${prefix} memory numeric judgment failed: ${rc} ${verdict}${err}")
  endif()
  file(STRINGS "${reference}" evidence)
  list(LENGTH evidence count)
  if(NOT count EQUAL 16)
    message(FATAL_ERROR "hashes: ${prefix} incomplete independently judged reference")
  endif()
  foreach(i RANGE 0 15)
    list(GET evidence ${i} expected)
    set(j ${i})
    if(i GREATER_EQUAL 12)
      math(EXPR j "${i}+1")
    endif()
    list(GET lines ${j} actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "hashes: ${prefix} differs from independently judged reference field ${i}")
    endif()
  endforeach()
  hashes_memory_identity("${family}" identity)
  string(REGEX REPLACE "([^\n]+)\n" "${prefix}.\\1\n" identity "${identity}")
  file(SHA256 "${image}" variant)
  string(APPEND content "${identity}${prefix}.variant_sha256 ${variant}\n")
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

# Both artifact consumers bind configuration and fixture bytes to the requested
# Git object, rather than trusting two matching candidate-supplied identities.
function(hashes_lane_identity sha result)
  string(LENGTH "${sha}" length)
  if(NOT length EQUAL 40 OR NOT sha MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "hashes: artifact commit must be an immutable SHA")
  endif()
  execute_process(COMMAND git -C "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ls-tree -r "${sha}" --
    pins.txt tests/roms tests/built tests/diag include/muhtari.h version.txt CMakePresets.json CMakeLists.txt
    RESULT_VARIABLE rc OUTPUT_VARIABLE identity ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR identity STREQUAL "")
    message(FATAL_ERROR "hashes: artifact source identity unavailable: ${rc} ${err}")
  endif()
  string(APPEND identity "Release warnings=error tests=ON libretro=ON short_runs=OFF inventory=ci normal+release\n")
  set(${result} "${identity}" PARENT_SCOPE)
endfunction()

function(hashes_native_artifacts directory sha result)
  set(lanes linux-arm64 linux-x64 macos-arm64 macos-x64 windows-arm64 windows-x64)
  set(want "")
  foreach(lane IN LISTS lanes)
    list(APPEND want "hashes-${lane}")
  endforeach()
  file(GLOB got RELATIVE "${directory}" "${directory}/*")
  list(SORT got)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "hashes: exact six native artifacts required: ${got}")
  endif()
  hashes_lane_identity("${sha}" identity)
  set(files "")
  foreach(lane IN LISTS want)
    set(dir "${directory}/${lane}")
    file(GLOB members RELATIVE "${dir}" "${dir}/*")
    list(SORT members)
    if(NOT members STREQUAL "commit.txt;hashes.txt;identity.txt")
      message(FATAL_ERROR "hashes: artifact members ${lane}: ${members}")
    endif()
    file(READ "${dir}/commit.txt" commit)
    file(READ "${dir}/identity.txt" actual)
    if(NOT commit STREQUAL "${sha}\n" OR NOT actual STREQUAL identity)
      message(FATAL_ERROR "hashes: artifact source/configuration/fixture mismatch ${lane}")
    endif()
    list(APPEND files "${dir}/hashes.txt")
  endforeach()
  set(${result} "${files}" PARENT_SCOPE)
endfunction()

# Fault prevented: a board hash without its actual numeric mailbox, or a
# partial frame/audio report, silently joining cross-platform equality.
function(hashes_diagnostic name prefix frames battery_count observed result)
  string(REGEX MATCHALL "[^\n]+" lines "${observed}")
  list(LENGTH lines count)
  if(NOT count EQUAL 10 OR NOT observed MATCHES "\n$"
      OR observed MATCHES "\r|^\n|\n\n")
    message(FATAL_ERROR "hashes: ${name} expected complete ten-field diagnostic report: ${rc} ${err}")
  endif()
  set(patterns "^frame 1 sha256 ([0-9a-f]+)$" "^frame ${frames} sha256 ([0-9a-f]+)$"
    "^audio_transitions_sha256 ([0-9a-f]+)$" "^audio_pcm_sha256 ([0-9a-f]+)$"
    "^audio_frames ${frames}$" "^audio_samples [1-9][0-9]*$" "^audio_rate 48000/1$"
    "^audio_behaviour_revision 6$" "^audio_synthesis exact-q23-16x64-dc20$"
    "^diagnostic ([0-9a-f]+)$")
  set(content "")
  foreach(i RANGE 0 9)
    list(GET lines ${i} line)
    list(GET patterns ${i} pattern)
    if(NOT line MATCHES "${pattern}")
      message(FATAL_ERROR "hashes: ${name} malformed diagnostic field ${i}: ${line}")
    endif()
    if(i LESS 4 OR i EQUAL 9)
      string(LENGTH "${CMAKE_MATCH_1}" length)
      set(want 64)
      if(i EQUAL 9)
        set(want 512)
      endif()
      if(NOT length EQUAL want)
        message(FATAL_ERROR "hashes: ${name} diagnostic field ${i} length ${length}")
      endif()
    endif()
    string(REGEX REPLACE "^frame (1|${frames}) sha256 " "frame\\1 " row "${line}")
    string(APPEND content "${prefix}.${row}\n")
  endforeach()
  file(MAKE_DIRECTORY "${OUT}")
  set(report "${OUT}/hashes-${prefix}-mailbox.txt")
  file(CONFIGURE OUTPUT "${report}" CONTENT "${line}\n" @ONLY NEWLINE_STYLE UNIX)
  set(options "")
  if(battery_count)
    set(options --battery-count ${battery_count})
  endif()
  execute_process(COMMAND ${EMULATOR} "${DRIVER}" ${options} --mailbox "${report}" "${name}"
      "${DIAG}/expected.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE verdict ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "hashes: ${name} numeric diagnostic failed: ${rc} ${verdict} ${err}")
  endif()
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

function(hashes_board name result)
  set(rom "${DIAG}/${name}.a78")
  if(NOT EXISTS "${rom}" OR NOT EXISTS "${DIAG}/expected.csv")
    message(FATAL_ERROR "hashes: missing ${name} diagnostic fixture or expectations")
  endif()
  execute_process(COMMAND ${EMULATOR} "${RUN}" --probe "${rom}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE probe ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0" OR NOT probe MATCHES "\nboard ${name}\n")
    message(FATAL_ERROR "hashes: ${name} diagnostic board mismatch: ${rc} ${probe} ${err}")
  endif()
  execute_process(COMMAND ${EMULATOR} "${RUN}" --frames 600 --hash-frame 1 --hash-frame 600
      --hash-audio --diagnostic "${rom}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE observed ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "hashes: ${name} runner failed: ${rc} ${err}")
  endif()
  hashes_diagnostic("${name}" "${name}" 600 0 "${observed}" content)
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

# Both independent counters and every saved byte must pass before hashing.
function(hashes_battery result)
  set(work "${OUT}/hashes-battery")
  file(REMOVE_RECURSE "${work}")
  file(MAKE_DIRECTORY "${work}/save")
  set(content "")
  set(count 0)
  foreach(launch first second)
    math(EXPR count "${count}+1")
    execute_process(COMMAND ${EMULATOR} "${RUN}" --frames 120 --hash-frame 1 --hash-frame 120
        --hash-audio --diagnostic --save-dir "${work}/save" "${DIAG}/battery.a78"
      RESULT_VARIABLE rc OUTPUT_VARIABLE observed ERROR_VARIABLE err TIMEOUT 30)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "hashes: battery ${launch} runner failed: ${rc} ${err}")
    endif()
    hashes_diagnostic(battery "battery.${launch}" 120 ${count} "${observed}" rows)
    set(snapshot "${work}/${launch}.sav")
    file(COPY_FILE "${work}/save/battery.sav" "${snapshot}")
    execute_process(COMMAND ${EMULATOR} "${DRIVER}" --battery-media "${snapshot}" ${count}
      RESULT_VARIABLE rc OUTPUT_VARIABLE verdict ERROR_VARIABLE err TIMEOUT 30)
    if(NOT rc STREQUAL "0")
      message(FATAL_ERROR "hashes: battery ${launch} media failed: ${rc} ${verdict} ${err}")
    endif()
    file(SHA256 "${snapshot}" digest)
    string(APPEND content "${rows}battery.${launch}.save_sha256 ${digest}\n")
  endforeach()
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

# Complete actual-runner reports only. The diagnostic owner supplies the
# stimulus and independently judges both connectors before calling this.
function(hashes_controller_report prefix scenario observed result)
  string(REGEX MATCHALL "[^\n]+" lines "${observed}")
  list(LENGTH lines count)
  if(NOT count EQUAL 21 OR NOT observed MATCHES "\n$" OR observed MATCHES "\r|^\n|\n\n")
    message(FATAL_ERROR "hashes: ${prefix} expected complete twenty-one-field controller report")
  endif()
  set(patterns "")
  foreach(frame RANGE 1 12)
    list(APPEND patterns "^frame ${frame} sha256 ([0-9a-f]+)$")
  endforeach()
  list(APPEND patterns "^lag_frames (0|[1-9]|1[0-2])$"
    "^audio_transitions_sha256 ([0-9a-f]+)$"
    "^audio_pcm_sha256 ([0-9a-f]+)$" "^audio_frames 12$"
    "^audio_samples [1-9][0-9]*$" "^audio_rate 48000/1$"
    "^audio_behaviour_revision 6$" "^audio_synthesis exact-q23-16x64-dc20$"
    "^diagnostic ([0-9a-f]+)$")
  set(content "")
  foreach(i RANGE 0 20)
    list(GET lines ${i} line)
    list(GET patterns ${i} pattern)
    if(NOT line MATCHES "${pattern}")
      message(FATAL_ERROR "hashes: ${prefix} malformed controller field ${i}: ${line}")
    endif()
    if(i LESS 12 OR i EQUAL 13 OR i EQUAL 14 OR i EQUAL 20)
      string(LENGTH "${CMAKE_MATCH_1}" length)
      set(want 64)
      if(i EQUAL 20)
        set(want 512)
      endif()
      if(NOT length EQUAL want)
        message(FATAL_ERROR "hashes: ${prefix} controller field ${i} length ${length}")
      endif()
    endif()
    string(REGEX REPLACE "^frame ([0-9]+) sha256 " "frame\\1 " row "${line}")
    string(APPEND content "${prefix}.${row}\n")
  endforeach()
  set(report "${OUT}/hashes-mailbox.txt")
  file(CONFIGURE OUTPUT "${report}" CONTENT "${line}\n" @ONLY NEWLINE_STYLE UNIX)
  execute_process(COMMAND ${EMULATOR} "${DRIVER}" --mailbox "${report}" "${scenario}"
      "${DIAG}/expected.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE verdict ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "hashes: ${prefix} controller numeric judgment failed: ${rc} ${verdict}${err}")
  endif()
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

# Numeric startup/full-frame judgment precedes PAL equality, including when
# this writer is called directly by a portability lane outside CTest.
function(hashes_pal_report report result)
  execute_process(COMMAND ${EMULATOR} "${DRIVER}" --pal-report "${report}" "${DIAG}/expected.csv"
    RESULT_VARIABLE rc OUTPUT_VARIABLE verdict ERROR_VARIABLE err TIMEOUT 60)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "hashes: PAL numeric report failed: ${rc} ${verdict}${err}")
  endif()
  file(STRINGS "${report}" lines)
  set(content "")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "^frame ([0-9]+) sha256 " "frame\\1 " row "${line}")
    string(APPEND content "pal.${row}\n")
  endforeach()
  string(APPEND content "pal.full_frames 600\npal.startup_samples 960\npal.startup_remainder 336960\n"
    "pal.final_remainder 47029\npal.final_tick 85543176\n")
  set(${result} "${content}" PARENT_SCOPE)
endfunction()

# Fault prevented: all lanes agree on a duplicated or omitted observation.
function(hashes_validate content)
  set(want frame1 frame600 png)
  foreach(name soundtest pokey)
    foreach(field transitions_sha256 pcm_sha256 frames samples rate behaviour_revision synthesis)
      list(APPEND want "${name}.audio_${field}")
    endforeach()
  endforeach()
  foreach(name activision absolute fractalus battery.first battery.second)
    set(last 600)
    if(name MATCHES "^battery[.]")
      set(last 120)
    endif()
    list(APPEND want "${name}.frame1" "${name}.frame${last}")
    foreach(field transitions_sha256 pcm_sha256 frames samples rate behaviour_revision synthesis)
      list(APPEND want "${name}.audio_${field}")
    endforeach()
    list(APPEND want "${name}.diagnostic")
    if(last EQUAL 120)
      list(APPEND want "${name}.save_sha256")
    endif()
  endforeach()
  foreach(scenario motion.driving light.lightgun analog.paddle analog.keypad
      motion.trakball motion.st-mouse motion.amiga-mouse
      motion.snes2atari.group0 motion.snes2atari.group1 motion.snes2atari.group2
      motion.mega7800.group0 motion.mega7800.group1 motion.mega7800.group2)
    set(prefix "controller.${scenario}.both")
    foreach(frame RANGE 1 12)
      list(APPEND want "${prefix}.frame${frame}")
    endforeach()
    list(APPEND want "${prefix}.lag_frames")
    foreach(field transitions_sha256 pcm_sha256 frames samples rate behaviour_revision synthesis)
      list(APPEND want "${prefix}.audio_${field}")
    endforeach()
    list(APPEND want "${prefix}.diagnostic")
  endforeach()
  foreach(frame RANGE 1 601)
    list(APPEND want "pal.frame${frame}")
  endforeach()
  foreach(field transitions_sha256 pcm_sha256 frames samples rate behaviour_revision synthesis)
    list(APPEND want "pal.audio_${field}")
  endforeach()
  list(APPEND want pal.diagnostic pal.full_frames pal.startup_samples pal.startup_remainder
    pal.final_remainder pal.final_tick)
  hashes_memory_cases(memory_cases)
  foreach(prefix IN LISTS memory_cases)
    foreach(frame RANGE 1 12)
      list(APPEND want "${prefix}.frame${frame}")
    endforeach()
    list(APPEND want "${prefix}.lag_frames")
    foreach(field transitions_sha256 pcm_sha256 frames samples rate behaviour_revision synthesis)
      list(APPEND want "${prefix}.audio_${field}")
    endforeach()
    foreach(field diagnostic source_commit source_sha256 config_sha256 template_sha256 variant_sha256)
      list(APPEND want "${prefix}.${field}")
    endforeach()
  endforeach()
  string(REGEX MATCHALL "[^\n]+" rows "${content}")
  set(got "")
  foreach(row IN LISTS rows)
    if(NOT row MATCHES "^([^ ]+) [^\r\n]+$")
      message(FATAL_ERROR "hashes: malformed observation row")
    endif()
    list(APPEND got "${CMAKE_MATCH_1}")
    if(row MATCHES "^(bankset|expansion)[.]")
      if(row MATCHES "^((bankset|expansion)[.][^.]+)[.](source_commit|source_sha256|config_sha256|template_sha256) ([^ ]+)$")
        set(prefix "${CMAKE_MATCH_1}")
        set(family "${CMAKE_MATCH_2}")
        set(field "${CMAKE_MATCH_3}")
        set(value "${CMAKE_MATCH_4}")
        hashes_memory_identity("${family}" identity)
        string(FIND "${identity}" "${field} ${value}\n" at)
        if(at EQUAL -1)
          message(FATAL_ERROR "hashes: ${prefix} memory identity mismatch ${field}")
        endif()
      elseif(row MATCHES "[.](frame[0-9]+|audio_transitions_sha256|audio_pcm_sha256|diagnostic|variant_sha256) ([0-9a-f]+)$")
        string(LENGTH "${CMAKE_MATCH_2}" length)
        set(want_length 64)
        if(CMAKE_MATCH_1 STREQUAL diagnostic)
          set(want_length 512)
        endif()
        if(NOT length EQUAL want_length)
          message(FATAL_ERROR "hashes: malformed memory digest length")
        endif()
      else()
        set(samples 8861)
        if(row MATCHES "^bankset[.][^.]+-pal[.]|^expansion[.][12]-[0-9]+-[01]-1-")
          set(samples 11537)
        endif()
        if(NOT row MATCHES "[.]audio_(frames 12|samples ${samples}|rate 48000/1|behaviour_revision 6|synthesis exact-q23-16x64-dc20)$"
            AND NOT row MATCHES "[.]lag_frames (0|[1-9]|1[0-2])$")
          message(FATAL_ERROR "hashes: malformed memory observation value")
        endif()
      endif()
    elseif(row MATCHES "^pal[.]")
      if(row MATCHES "^pal[.](frame[0-9]+|audio_transitions_sha256|audio_pcm_sha256|diagnostic) ([0-9a-f]+)$")
        string(LENGTH "${CMAKE_MATCH_2}" length)
        set(want_length 64)
        if(CMAKE_MATCH_1 STREQUAL diagnostic)
          set(want_length 512)
        endif()
        if(NOT length EQUAL want_length)
          message(FATAL_ERROR "hashes: malformed PAL digest length")
        endif()
      elseif(NOT row MATCHES "^pal[.]audio_(frames 601|samples 577879|rate 48000/1|behaviour_revision 6|synthesis exact-q23-16x64-dc20)$"
          AND NOT row MATCHES "^pal[.](full_frames 600|startup_samples 960|startup_remainder 336960|final_remainder 47029|final_tick 85543176)$")
        message(FATAL_ERROR "hashes: malformed PAL observation value")
      endif()
    elseif(row MATCHES "^controller[.]")
      if(row MATCHES "[.](frame[0-9]+|audio_transitions_sha256|audio_pcm_sha256|diagnostic) ([0-9a-f]+)$")
        string(LENGTH "${CMAKE_MATCH_2}" length)
        set(want_length 64)
        if(CMAKE_MATCH_1 STREQUAL diagnostic)
          set(want_length 512)
        endif()
        if(NOT length EQUAL want_length)
          message(FATAL_ERROR "hashes: malformed controller digest length")
        endif()
      elseif(NOT row MATCHES "[.]audio_(frames 12|samples [1-9][0-9]*|rate 48000/1|behaviour_revision 6|synthesis exact-q23-16x64-dc20)$"
          AND NOT row MATCHES "[.]lag_frames (0|[1-9]|1[0-2])$")
        message(FATAL_ERROR "hashes: malformed controller observation value")
      endif()
    endif()
  endforeach()
  if(NOT got STREQUAL want OR NOT content MATCHES "\n$" OR content MATCHES "^\n|\n\n")
    message(FATAL_ERROR "hashes: missing duplicate or reordered observation rows")
  endif()
endfunction()
if(HASHES_FUNCTIONS_ONLY)
  return()
endif()
if(MODE STREQUAL "write")
  # Fault prevented: a lane's output silently not compared. Writes
  # <OUT>/hashes.txt with the frame 1 and frame 600 hashes and the SHA-256 of
  # the frame 1 PNG, the file CI collects from every lane.
  set(png "${OUT}/hashes-card.png")
  file(REMOVE "${png}")
  execute_process(COMMAND ${EMULATOR} "${RUN}" --frames 600 --hash-frame 1 --hash-frame 600
      --dump-frame "1:${png}"
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  if(NOT rc STREQUAL "0"
      OR NOT out MATCHES "^frame 1 sha256 ([0-9a-f]+)\nframe 600 sha256 ([0-9a-f]+)\n$")
    message(FATAL_ERROR "muhtari-run: expected exit 0 and two hash lines, got exit ${rc}\n${out}${err}")
  endif()
  set(frame1 ${CMAKE_MATCH_1})
  set(frame600 ${CMAKE_MATCH_2})
  file(SHA256 "${png}" png_sha256)
  set(content "frame1 ${frame1}\nframe600 ${frame600}\npng ${png_sha256}\n")
  string(REPEAT "|....12|......|...BB|\n" 60 input)
  string(REPEAT "|......|......|...BB|\n" 540 released)
  file(WRITE "${OUT}/hashes-audio.movie" "muhtari-movie 1\nport1 proline\nport2 proline\n${input}${released}")
  foreach(name soundtest pokey)
    string(TOUPPER "${name}" key)
    if(NOT EXISTS "${${key}}")
      message(FATAL_ERROR "hashes: missing ${name} built audio fixture")
    endif()
    execute_process(COMMAND ${EMULATOR} "${RUN}" --movie "${OUT}/hashes-audio.movie"
        --hash-audio "${${key}}"
      OUTPUT_VARIABLE audio ERROR_VARIABLE err RESULT_VARIABLE rc)
    if(NOT rc STREQUAL "0" OR NOT audio MATCHES "audio_frames 600\n"
        OR audio MATCHES "audio_transitions_sha256 e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
      message(FATAL_ERROR "hashes: ${name} audio failed: ${rc} ${audio} ${err}")
    endif()
    string(REGEX MATCHALL "audio_[^\n]+" lines "${audio}")
    list(LENGTH lines audio_fields)
    if(NOT audio_fields EQUAL 7)
      message(FATAL_ERROR "hashes: ${name} expected seven audio fields")
    endif()
    foreach(line IN LISTS lines)
      string(APPEND content "${name}.${line}\n")
    endforeach()
  endforeach()
  foreach(name activision absolute fractalus)
    hashes_board("${name}" board)
    string(APPEND content "${board}")
  endforeach()
  hashes_battery(battery)
  string(APPEND content "${battery}")
  set(DIAG_CONTROLLERS_RUN TRUE)
  set(HASHES_CONTROLLER_ROWS "")
  set(ROOT "${DIAG}/../..")
  set(RUNNER "${RUN}")
  set(EXPECTED "${DIAG}/expected.csv")
  set(hash_out "${OUT}")
  set(OUT "${OUT}/hashes-controllers")
  include("${DIAG}/tests.cmake")
  set(OUT "${hash_out}")
  string(APPEND content "${HASHES_CONTROLLER_ROWS}")
  set(DIAG_CONTROLLERS_RUN FALSE)
  set(DIAG_PAL_RUN TRUE)
  set(HASHES_PAL_ROWS "")
  set(OUT "${hash_out}/hashes-pal")
  set(MODULE "")
  set(PAL_TIMEOUT 60)
  include("${DIAG}/tests.cmake")
  set(OUT "${hash_out}")
  string(APPEND content "${HASHES_PAL_ROWS}")
  set(DIAG_PAL_RUN FALSE)
  set(DIAG_BANKSET_RUN TRUE)
  set(BANKSET_EXPANDED TRUE)
  set(HASHES_BANKSET_ROWS "")
  set(OUT "${hash_out}/hashes-bankset")
  include("${DIAG}/tests.cmake")
  string(APPEND content "${HASHES_BANKSET_ROWS}")
  set(DIAG_BANKSET_RUN FALSE)
  set(DIAG_EXPANSION_RUN TRUE)
  set(HASHES_EXPANSION_ROWS "")
  set(OUT "${hash_out}/hashes-expansion")
  include("${DIAG}/tests.cmake")
  string(APPEND content "${HASHES_EXPANSION_ROWS}")
  set(OUT "${hash_out}")
  hashes_validate("${content}")
  # Unix newlines on every host: file(WRITE) writes CRLF on Windows.
  file(CONFIGURE OUTPUT "${OUT}/hashes.txt" NEWLINE_STYLE UNIX
    CONTENT "${content}")
elseif(MODE STREQUAL "compare")
  if(DEFINED DIRECTORY)
    hashes_native_artifacts("${DIRECTORY}" "${EXPECTED_SHA}" FILES)
    set(COUNT 6)
  endif()
  # Fault prevented: lanes that disagree, or a lane that stops uploading and
  # silently drops out. Passes only for exactly COUNT existing files that are
  # byte-identical.
  list(LENGTH FILES n)
  if(NOT n EQUAL COUNT)
    message(FATAL_ERROR "hashes: expected ${COUNT} files, got ${n}: ${FILES}")
  endif()
  list(GET FILES 0 first)
  set(seen "")
  foreach(file IN LISTS FILES)
    if(NOT EXISTS "${file}")
      message(FATAL_ERROR "hashes: ${file} does not exist")
    endif()
    file(REAL_PATH "${file}" canonical)
    if(canonical IN_LIST seen)
      message(FATAL_ERROR "hashes: duplicate lane file ${file}")
    endif()
    list(APPEND seen "${canonical}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${first}" "${file}"
      RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
    if(NOT rc EQUAL 0)
      file(READ "${first}" want)
      file(READ "${file}" got)
      message(FATAL_ERROR "hashes: ${file} differs from ${first}\n${first}:\n${want}${file}:\n${got}")
    endif()
  endforeach()
  file(READ "${first}" content)
  hashes_validate("${content}")
  message(STATUS "hashes: ${n} identical files")
else()
  message(FATAL_ERROR "hashes: -DMODE=write or -DMODE=compare is required")
endif()
