# Runs the README's RetroArch install line for Apple Silicon, as
#   cmake -DREADME=<README.md> -DBASE_URL=<url ending in />
#         [-DHOME_DIR=<empty scratch dir>] -P install_line.cmake
# Fault prevented: the README's install line no longer installs the core.
# The one README line beginning "mkdir -p ~/Library/Application" runs
# verbatim under sh with HOME set to a scratch directory; only its release
# download base is replaced by BASE_URL, a file:// directory URL for a local
# build or the release URL after publishing. The core and its information
# file must then exist under the RetroArch directory. macOS only: the line
# relies on macOS's tar, which reads a zip on standard input.
foreach(var README BASE_URL)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "install_line: -D${var}=... is required")
  endif()
endforeach()
if(NOT DEFINED HOME_DIR)
  set(HOME_DIR "$ENV{TMPDIR}")
  if(HOME_DIR STREQUAL "")
    set(HOME_DIR /tmp)
  endif()
  set(HOME_DIR "${HOME_DIR}/muhtari-install-line")
endif()

set(portable_url "https://github.com/szTheory/muhtari/releases/latest/download/muhtari-libretro-emscripten.zip")
set(portable_guide "docs/libretro.md#portable-emscripten-bundle")
file(READ "${README}" readme_text)
string(FIND "${readme_text}" "The architecture-independent Emscripten libretro ZIP" portable_start)
if(portable_start EQUAL -1)
  message(FATAL_ERROR "install_line: README is missing the portable bundle section")
endif()
string(SUBSTRING "${readme_text}" ${portable_start} -1 portable_section)
string(FIND "${portable_section}" "\n## " portable_end)
if(NOT portable_end EQUAL -1)
  string(SUBSTRING "${portable_section}" 0 ${portable_end} portable_section)
endif()

# Ignore fenced examples so a displayed Markdown link cannot satisfy the
# user-facing contract. This small fence remover is scoped to this section.
set(portable_scan "${portable_section}")
set(portable_text "")
while(TRUE)
  string(FIND "${portable_scan}" "```" fence_open)
  if(fence_open EQUAL -1)
    string(APPEND portable_text "${portable_scan}")
    break()
  endif()
  string(SUBSTRING "${portable_scan}" 0 ${fence_open} before_fence)
  string(APPEND portable_text "${before_fence}")
  math(EXPR after_open "${fence_open} + 3")
  string(SUBSTRING "${portable_scan}" ${after_open} -1 fence_body)
  string(FIND "${fence_body}" "```" fence_close)
  if(fence_close EQUAL -1)
    message(FATAL_ERROR "install_line: unterminated Markdown fence in portable section")
  endif()
  math(EXPR after_close "${fence_close} + 3")
  string(SUBSTRING "${fence_body}" ${after_close} -1 portable_scan)
endwhile()

set(portable_asset_link "[version-free download URL](${portable_url})")
string(FIND "${portable_text}" "${portable_asset_link}" portable_asset_at)
if(portable_asset_at EQUAL -1)
  set(asset_label "[version-free download URL](")
  string(FIND "${portable_text}" "${asset_label}" asset_label_at)
  if(NOT asset_label_at EQUAL -1)
    string(LENGTH "${asset_label}" label_length)
    math(EXPR target_start "${asset_label_at} + ${label_length}")
    string(SUBSTRING "${portable_text}" ${target_start} -1 target_tail)
    string(FIND "${target_tail}" ")" target_end)
    if(NOT target_end EQUAL -1)
      string(SUBSTRING "${target_tail}" 0 ${target_end} wrong_portable_url)
      message(FATAL_ERROR "install_line: portable archive link must target muhtari-libretro-emscripten.zip; found ${wrong_portable_url}")
    endif()
  endif()
  string(FIND "${portable_text}" "${portable_url}" portable_plain_url_at)
  if(NOT portable_plain_url_at EQUAL -1)
    message(FATAL_ERROR "install_line: portable archive URL must be a clickable Markdown link")
  endif()
  message(FATAL_ERROR "install_line: README is missing the clickable portable archive link ${portable_url}")
endif()

set(portable_guide_link "[portable host instructions](${portable_guide})")
string(FIND "${portable_text}" "${portable_guide_link}" portable_guide_at)
if(portable_guide_at EQUAL -1)
  string(FIND "${portable_text}" "${portable_guide}" portable_plain_guide_at)
  if(NOT portable_plain_guide_at EQUAL -1)
    message(FATAL_ERROR "install_line: integrator guide path must be a clickable Markdown link")
  endif()
  message(FATAL_ERROR "install_line: README is missing the clickable integrator guide link ${portable_guide}")
endif()
if(PORTABLE_LINK_CHECK_ONLY)
  message(STATUS "install_line: portable archive and integrator links ok")
  return()
endif()
if(NOT CMAKE_HOST_APPLE)
  message(FATAL_ERROR "install_line: runs on macOS only, whose tar reads a zip on stdin")
endif()

file(STRINGS "${README}" lines REGEX "^mkdir -p ~/Library/Application")
list(LENGTH lines count)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "install_line: ${count} lines in ${README} begin "
    "'mkdir -p ~/Library/Application', expected 1")
endif()
set(release_base "https://github.com/szTheory/muhtari/releases/latest/download/")
string(FIND "${lines}" "${release_base}" at)
if(at EQUAL -1)
  message(FATAL_ERROR "install_line: the line does not download from ${release_base}:\n${lines}")
endif()
string(REPLACE "${release_base}" "${BASE_URL}" line "${lines}")

file(REMOVE_RECURSE "${HOME_DIR}")
file(MAKE_DIRECTORY "${HOME_DIR}")
execute_process(COMMAND ${CMAKE_COMMAND} -E env "HOME=${HOME_DIR}" sh -c "${line}"
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE out)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "install_line: exit ${rc} from\n  ${line}\n${out}")
endif()
foreach(want cores/muhtari_libretro.dylib info/muhtari_libretro.info)
  set(path "Library/Application Support/RetroArch/${want}")
  if(NOT EXISTS "${HOME_DIR}/${path}")
    message(FATAL_ERROR "install_line: the line did not install ~/${path}")
  endif()
  message(STATUS "install_line: installed ~/${path}")
endforeach()
file(REMOVE_RECURSE "${HOME_DIR}")
