# Fixture manifest coverage, run as
#   cmake -DROOT=<repository root> -DMANIFEST=<manifest.txt> -P rom_hash_coverage.cmake
# Fault prevented: a committed fixture that no longer matches its manifest row
# (so the row's source, pin and licence describe other bytes), a fixture with
# no row, or the fuzz corpus growing past 512 KiB. Every row's file must exist
# under ROOT with the row's SHA-256; every file under tests/roms/ and under a
# regress directory in tests/fuzz/ must have a row; tests/fuzz/ must hold at
# most 524,288 bytes. The manifest's format is in its own header.
cmake_minimum_required(VERSION 3.25)
foreach(var ROOT MANIFEST)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "rom_hash_coverage: -D${var} is required")
  endif()
endforeach()

set(errors "")
set(listed "")
file(STRINGS "${MANIFEST}" rows)
foreach(row IN LISTS rows)
  if(row STREQUAL "" OR row MATCHES "^#")
    continue()
  endif()
  string(REPLACE "\t" ";" fields "${row}")
  list(LENGTH fields count)
  list(GET fields 0 path)
  if(NOT count EQUAL 6)
    string(APPEND errors "\n  ${path}: ${count} fields, not 6")
    continue()
  endif()
  list(GET fields 4 want)
  if(path IN_LIST listed)
    string(APPEND errors "\n  ${path}: listed twice")
  endif()
  list(APPEND listed "${path}")
  if(NOT want MATCHES "^[0-9a-f]+$")
    string(APPEND errors "\n  ${path}: sha256 field '${want}' is not lowercase hex")
  elseif(NOT EXISTS "${ROOT}/${path}" OR IS_DIRECTORY "${ROOT}/${path}")
    string(APPEND errors "\n  ${path}: listed but missing")
  else()
    file(SHA256 "${ROOT}/${path}" got)
    if(NOT got STREQUAL want)
      string(APPEND errors "\n  ${path}: sha256 is ${got}, the manifest says ${want}")
    endif()
  endif()
endforeach()

# The manifest itself is the one file under tests/roms/ that needs no row.
file(GLOB_RECURSE roms RELATIVE "${ROOT}" "${ROOT}/tests/roms/*")
file(GLOB_RECURSE fuzz RELATIVE "${ROOT}" "${ROOT}/tests/fuzz/*")
set(fuzz_bytes 0)
foreach(path IN LISTS fuzz)
  file(SIZE "${ROOT}/${path}" size)
  math(EXPR fuzz_bytes "${fuzz_bytes} + ${size}")
endforeach()
list(FILTER fuzz INCLUDE REGEX "/regress/")
foreach(path IN LISTS roms fuzz)
  if(NOT path STREQUAL "tests/roms/manifest.txt" AND NOT path IN_LIST listed)
    string(APPEND errors "\n  ${path}: no manifest row")
  endif()
endforeach()
if(fuzz_bytes GREATER 524288)
  string(APPEND errors "\n  tests/fuzz: ${fuzz_bytes} bytes, more than 524288")
endif()

if(NOT errors STREQUAL "")
  message(FATAL_ERROR "rom_hash_coverage: ${MANIFEST}:${errors}")
endif()
list(LENGTH listed count)
message(STATUS "rom_hash_coverage: ${count} rows match their files")
