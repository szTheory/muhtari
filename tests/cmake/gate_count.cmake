# Physical maintenance-line observation, including this counter and its inventory.
# Fault prevented: omitted or double-counted enforcement appearing within budget.
# Usage: cmake -DROOT=. -DINVENTORY=tests/policy/gate-lines.txt -DOUT=report.json -P this-file
# Inventory rows are repository-relative whole files or path:first:last inclusions.
cmake_minimum_required(VERSION 4.3)
foreach(var ROOT INVENTORY OUT)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "gate_count: -D${var} is required")
  endif()
endforeach()
file(REAL_PATH "${ROOT}" ROOT)
cmake_path(ABSOLUTE_PATH INVENTORY BASE_DIRECTORY "${ROOT}" NORMALIZE)
file(RELATIVE_PATH inventory_path "${ROOT}" "${INVENTORY}")
if(NOT EXISTS "${INVENTORY}")
  message(FATAL_ERROR "gate_count: missing inventory")
endif()

function(physical_lines path result)
  file(READ "${path}" text)
  string(REGEX MATCHALL "\n" newlines "${text}")
  list(LENGTH newlines count)
  if(NOT text STREQUAL "" AND NOT text MATCHES "\n$")
    math(EXPR count "${count} + 1")
  endif()
  set(${result} "${count}" PARENT_SCOPE)
endfunction()

file(STRINGS "${INVENTORY}" rows)
set(total 0)
set(inclusions "")
set(whole "")
set(configuration "")
foreach(row IN LISTS rows)
  if(row STREQUAL "" OR row MATCHES "^#")
    continue()
  endif()
  if(NOT row MATCHES "^([^:]+)(:([1-9][0-9]*):([1-9][0-9]*))?$")
    message(FATAL_ERROR "gate_count: malformed inventory row ${row}")
  endif()
  set(path "${CMAKE_MATCH_1}")
  set(first "${CMAKE_MATCH_3}")
  set(last "${CMAKE_MATCH_4}")
  file(REAL_PATH "${ROOT}/${path}" absolute)
  cmake_path(IS_PREFIX ROOT "${absolute}" NORMALIZE contained)
  if(IS_ABSOLUTE "${path}" OR NOT contained OR path MATCHES "(^|/)[.][.](/|$)")
    message(FATAL_ERROR "gate_count: path outside root ${path}")
  endif()
  if(NOT EXISTS "${absolute}" OR IS_DIRECTORY "${absolute}")
    message(FATAL_ERROR "gate_count: missing file ${path}")
  endif()
  file(RELATIVE_PATH path "${ROOT}" "${absolute}")
  physical_lines("${absolute}" count)
  if(path IN_LIST whole)
    message(FATAL_ERROR "gate_count: overlapping ranges ${path}")
  endif()
  if(first STREQUAL "")
    set(first 1)
    set(last "${count}")
    list(APPEND whole "${path}")
  elseif(first GREATER last OR last GREATER count)
    message(FATAL_ERROR "gate_count: invalid endpoints ${row}")
  endif()
  foreach(previous IN LISTS inclusions)
    string(REPLACE ":" ";" fields "${previous}")
    list(GET fields 0 previous_path)
    list(GET fields 1 previous_first)
    list(GET fields 2 previous_last)
    if(path STREQUAL previous_path AND first LESS_EQUAL previous_last AND last GREATER_EQUAL previous_first)
      message(FATAL_ERROR "gate_count: overlapping ranges ${path}")
    endif()
  endforeach()
  list(APPEND inclusions "${path}:${first}:${last}")
  math(EXPR total "${total} + ${last} - ${first} + 1")
  string(APPEND configuration "${row}\n")
endforeach()
if(NOT inclusions)
  message(FATAL_ERROR "gate_count: empty inventory")
endif()
if(NOT "tests/cmake/gate_count.cmake" IN_LIST whole OR NOT inventory_path IN_LIST whole)
  message(FATAL_ERROR "gate_count: counter/inventory must be whole files")
endif()

file(GLOB_RECURSE sources RELATIVE "${ROOT}" "${ROOT}/src/*.c" "${ROOT}/src/*.h")
set(full_source 0)
set(authored_source 0)
foreach(path IN LISTS sources)
  physical_lines("${ROOT}/${path}" count)
  math(EXPR full_source "${full_source} + ${count}")
  if(NOT path STREQUAL "src/cartdb.c")
    math(EXPR authored_source "${authored_source} + ${count}")
  endif()
endforeach()
# Fixed-point millionths keep the observation integer-only and diagnostic.
foreach(kind full authored)
  if(${kind}_source EQUAL 0)
    set(${kind}_ratio null)
  else()
    math(EXPR ${kind}_ratio "${total} * 1000000 / ${${kind}_source}")
  endif()
endforeach()
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE sha
  OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_rc ERROR_QUIET)
if(NOT git_rc STREQUAL "0")
  set(sha unavailable)
endif()
string(SHA256 digest "${configuration}")
set(report "{}")
foreach(field gate_lines full_source authored_source full_ratio authored_ratio)
  set(value "${${field}}")
  if(field STREQUAL "gate_lines")
    set(value "${total}")
  endif()
  string(JSON report SET "${report}" "${field}" "${value}")
endforeach()
string(JSON report SET "${report}" sha "\"${sha}\"")
string(JSON report SET "${report}" configuration "\"${digest}\"")
string(JSON report SET "${report}" ratio_units "\"millionths, advisory\"")
file(WRITE "${OUT}" "${report}\n")
message(STATUS "gate_count: ${total} physical lines; source ${full_source}/${authored_source}")
