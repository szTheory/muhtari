# Fault prevented: empty, duplicate or unrelated artifacts claiming equality.
cmake_minimum_required(VERSION 3.25)
string(LENGTH "${EXPECTED_SHA}" sha_length)
if(NOT sha_length EQUAL 40 OR NOT EXPECTED_SHA MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "lane_equality: commit must be an immutable SHA")
endif()
file(REAL_PATH "${NATIVE}" NATIVE)
file(REAL_PATH "${BE}" BE)
if(NATIVE STREQUAL BE)
  message(FATAL_ERROR "lane_equality: duplicate lane directory")
endif()
foreach(lane NATIVE BE)
  file(GLOB members RELATIVE "${${lane}}" "${${lane}}/*")
  list(SORT members)
  if(NOT members STREQUAL "commit.txt;hashes.txt;identity.txt")
    message(FATAL_ERROR "lane_equality: members of ${lane}: ${members}")
  endif()
  foreach(member commit hashes identity)
    file(READ "${${lane}}/${member}.txt" ${lane}_${member})
    string(STRIP "${${lane}_${member}}" content)
    if(content STREQUAL "")
      message(FATAL_ERROR "lane_equality: empty ${lane}/${member}")
    endif()
  endforeach()
  string(STRIP "${${lane}_commit}" commit)
  if(NOT commit STREQUAL EXPECTED_SHA)
    message(FATAL_ERROR "lane_equality: commit mismatch in ${lane}")
  endif()
endforeach()
if(NOT NATIVE_identity STREQUAL BE_identity)
  message(FATAL_ERROR "lane_equality: configuration/fixture mismatch")
endif()
set(FILES "${NATIVE}/hashes.txt" "${BE}/hashes.txt")
set(COUNT 2)
set(MODE compare)
include("${CMAKE_CURRENT_LIST_DIR}/hashes.cmake")
