cmake_minimum_required(VERSION 3.25)
foreach(arg ROOT OLD_SOURCE OLD_BUILD NEW_BUILD WORK)
  if(NOT DEFINED ${arg} OR "${${arg}}" STREQUAL "")
    message(FATAL_ERROR "state_compat: missing ${arg}")
  endif()
endforeach()
file(REAL_PATH "${ROOT}" ROOT)
foreach(arg OLD_SOURCE OLD_BUILD NEW_BUILD WORK)
  get_filename_component(${arg} "${${arg}}" ABSOLUTE BASE_DIR "${ROOT}")
endforeach()
include("${ROOT}/tests/emscripten/bundle.cmake")
_muhtari_bundle_normalize("${ROOT}" "${ROOT}/build" "${WORK}" ROOT BUILD_ROOT WORK)
foreach(protected OLD_SOURCE OLD_BUILD NEW_BUILD)
  cmake_path(IS_PREFIX ${protected} "${WORK}" NORMALIZE inside)
  if(inside)
    message(FATAL_ERROR "state_compat: scratch overlaps a protected source/build")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
_muhtari_bundle_reject_tree_symlinks("${WORK}" "compatibility scratch")
set(kickoff fef56919cc145eb09fdb0a0939dfbd7f17012104)
execute_process(COMMAND git -C "${OLD_SOURCE}" rev-parse HEAD
  OUTPUT_VARIABLE old_head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${OLD_SOURCE}" status --porcelain
  OUTPUT_VARIABLE old_dirt COMMAND_ERROR_IS_FATAL ANY)
if(NOT old_head STREQUAL kickoff OR NOT old_dirt STREQUAL "")
  message(FATAL_ERROR "state_compat: genuine clean kickoff source required")
endif()
file(READ "${ROOT}/build/v6-state-baseline-receipt.json" baseline)
string(JSON recorded GET "${baseline}" source)
if(NOT recorded STREQUAL kickoff)
  message(FATAL_ERROR "state_compat: wrong baseline receipt")
endif()
file(READ "${OLD_BUILD}/CMakeCache.txt" old_cache)
string(FIND "${old_cache}" "CMAKE_HOME_DIRECTORY:INTERNAL=${OLD_SOURCE}\n" home)
if(home EQUAL -1)
  message(FATAL_ERROR "state_compat: old build source origin mismatch")
endif()
set(library libmuhtari.a)
if(WIN32)
  set(library muhtari.lib)
endif()
if(NOT DEFINED OLD_LIBRARY)
  set(OLD_LIBRARY "${OLD_BUILD}/${library}")
endif()
if(NOT DEFINED OLD_INCLUDE)
  set(OLD_INCLUDE "${OLD_SOURCE}/include")
endif()
get_filename_component(OLD_LIBRARY "${OLD_LIBRARY}" ABSOLUTE BASE_DIR "${ROOT}")
get_filename_component(OLD_INCLUDE "${OLD_INCLUDE}" ABSOLUTE BASE_DIR "${ROOT}")
string(JSON expected_old GET "${baseline}" artifact_sha256 "build/v6-state-baseline/${library}")
file(SHA256 "${OLD_LIBRARY}" actual_old)
if(NOT actual_old STREQUAL expected_old)
  message(FATAL_ERROR "state_compat: frozen old library origin mismatch")
endif()
execute_process(COMMAND git -C "${OLD_SOURCE}" show "${kickoff}:include/muhtari.h"
  OUTPUT_FILE "${WORK}/kickoff-header.h" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${WORK}/kickoff-header.h" expected_header)
file(SHA256 "${OLD_INCLUDE}/muhtari.h" actual_header)
if(NOT actual_header STREQUAL expected_header)
  message(FATAL_ERROR "state_compat: old header origin mismatch")
endif()
if(MODE STREQUAL origins)
  message(STATUS "state_compat: frozen source/header/library origins qualified")
  return()
endif()
file(REMOVE "${WORK}/result.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${ROOT}/tests/state-compat" -B "${WORK}/drivers"
  "-DROOT=${ROOT}" "-Dold_SOURCE=${OLD_SOURCE}" "-Dold_INCLUDE=${OLD_INCLUDE}" "-Dold_LIBRARY=${OLD_LIBRARY}"
  -Dold_BEHAVIOUR=6 "-Dnew_SOURCE=${ROOT}" "-Dnew_INCLUDE=${ROOT}/include" "-Dnew_LIBRARY=${NEW_BUILD}/${library}"
  -Dnew_BEHAVIOUR=7 -DCMAKE_BUILD_TYPE=Release
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "state_compat: driver configure: ${out}${err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/drivers" --config Release --parallel 2
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "state_compat: driver build: ${out}${err}")
endif()
set(exe "")
if(WIN32)
  set(exe .exe)
endif()
foreach(side old new)
  set(${side} "${WORK}/drivers/compat-${side}${exe}")
  if(NOT EXISTS "${${side}}")
    set(${side} "${WORK}/drivers/Release/compat-${side}${exe}")
  endif()
endforeach()
function(run side)
  execute_process(COMMAND "${${side}}" ${ARGN} RESULT_VARIABLE rc
    OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "state_compat: ${side} ${ARGN}: ${rc} ${out}${err}")
  endif()
endfunction()
function(same first second)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${first}" "${second}" RESULT_VARIABLE rc)
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "state_compat: independent bytes/continuation differ: ${first} ${second}")
  endif()
endfunction()
foreach(scenario linear supergame xboard xm savekey)
  foreach(region ntsc pal)
    set(prefix "${WORK}/${scenario}-${region}")
    run(old produce ${scenario} ${region} "${prefix}-old")
    run(new produce ${scenario} ${region} "${prefix}-new")
    foreach(suffix .state .txt .after.state)
      same("${prefix}-old${suffix}" "${prefix}-new${suffix}")
    endforeach()
    run(new resume ${scenario} ${region} "${prefix}-old.state" "${prefix}-old-to-new")
    run(old resume ${scenario} ${region} "${prefix}-new.state" "${prefix}-new-to-old")
    foreach(suffix .txt .after.state)
      same("${prefix}-old${suffix}" "${prefix}-old-to-new${suffix}")
      same("${prefix}-new${suffix}" "${prefix}-new-to-old${suffix}")
    endforeach()
    message(STATUS "state_compat: ${scenario}/${region} identical bytes and both continuation directions")
  endforeach()
endforeach()
# Genuine new-format input and actual old-core YM content refusal.
foreach(region ntsc pal)
  run(new produce ym ${region} "${WORK}/ym-${region}")
  run(old refuse-ym xm ${region} "${WORK}/old-content-refusal-${region}")
  run(old refuse xm ${region} "${WORK}/ym-${region}.state" "${WORK}/old-state-refusal-${region}")
  run(new refuse xm ${region} "${WORK}/ym-${region}.state" "${WORK}/new-topology-refusal-${region}")
  run(new refuse ym ${region} "${WORK}/linear-${region}-old.state" "${WORK}/new-legacy-refusal-${region}")
  foreach(suffix .txt .after.state)
    same("${WORK}/xm-${region}-old${suffix}" "${WORK}/old-content-refusal-${region}${suffix}")
    same("${WORK}/xm-${region}-old${suffix}" "${WORK}/old-state-refusal-${region}${suffix}")
    same("${WORK}/xm-${region}-new${suffix}" "${WORK}/new-topology-refusal-${region}${suffix}")
    same("${WORK}/ym-${region}${suffix}" "${WORK}/new-legacy-refusal-${region}${suffix}")
  endforeach()
endforeach()
if(MODE STREQUAL controls)
  run(new corrupt "${WORK}/linear-ntsc-new.state" "${WORK}/repaired-crc.state")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
    "${WORK}/linear-ntsc-new.state" "${WORK}/repaired-crc.state" RESULT_VARIABLE changed)
  if(changed STREQUAL "0")
    message(FATAL_ERROR "state_compat: changed-byte judge accepted repaired-CRC fault")
  endif()
  run(new refuse linear ntsc "${WORK}/repaired-crc.state" "${WORK}/semantic-refusal")
  foreach(suffix .txt .after.state)
    same("${WORK}/linear-ntsc-new${suffix}" "${WORK}/semantic-refusal${suffix}")
  endforeach()
  foreach(fault source library header)
    set(source "${OLD_SOURCE}")
    set(lib "${OLD_LIBRARY}")
    set(headers "${OLD_INCLUDE}")
    if(fault STREQUAL source)
      set(source "${ROOT}")
      set(reason "genuine clean kickoff source required")
    elseif(fault STREQUAL header)
      set(headers "${ROOT}/include")
      set(reason "old header origin mismatch")
    else()
      set(lib "${NEW_BUILD}/${library}")
      set(reason "frozen old library origin mismatch")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" "-DOLD_SOURCE=${source}"
      "-DOLD_BUILD=${OLD_BUILD}" "-DOLD_LIBRARY=${lib}" "-DOLD_INCLUDE=${headers}"
      "-DNEW_BUILD=${NEW_BUILD}" "-DWORK=${WORK}/origin-${fault}"
      -DMODE=origins -P "${CMAKE_CURRENT_LIST_FILE}"
      RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc STREQUAL "1" OR NOT "${out}${err}" MATCHES "${reason}")
      message(FATAL_ERROR "state_compat: wrong ${fault} origin control did not reject: ${out}${err}")
    endif()
  endforeach()
endif()
file(SHA256 "${NEW_BUILD}/${library}" current_library)
file(SHA256 "${ROOT}/include/muhtari.h" current_header)
file(SHA256 "${old}" old_driver)
file(SHA256 "${new}" new_driver)
execute_process(COMMAND git -C "${ROOT}" rev-parse HEAD OUTPUT_VARIABLE head
  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${WORK}/result.json"
  "{\"schema\":1,\"kickoff\":\"${kickoff}\",\"current\":\"${head}\",\"old_library\":\"${actual_old}\",\"new_library\":\"${current_library}\",\"old_header\":\"${actual_header}\",\"new_header\":\"${current_header}\",\"old_driver\":\"${old_driver}\",\"new_driver\":\"${new_driver}\",\"cases\":10,\"continuation_directions\":2,\"regions\":2,\"ym_content_and_state_refusals\":true,\"controls\":\"${MODE}\",\"exit\":0,\"run_url\":\"N/A-local\"}\n")
message(STATUS "state_compat: genuine ten-case bidirectional matrix and safe refusals passed")
