# Run as cmake -DLEDGER=<ledger.csv> -DID=<ledger id> -DREPORT=<runner output> -P ledger_crc.cmake
# Fault prevented: a hand-edited or stale ledger CRC standing as evidence while
# the diagnostic still passes. The runner's "diagnostic" line holds the 256-byte
# mailbox as hex; its CRC is the two bytes at $2208-$2209, low byte first
# (docs/emulation-tests.md, diag). The ledger writes that CRC as four hex
# digits, high byte first, in its evidence field (the 14th).
cmake_minimum_required(VERSION 3.25)
set(have FALSE)
file(READ "${LEDGER}" text)
string(REPLACE ";" "<semicolon>" text "${text}")
string(REPLACE "\n" ";" rows "${text}")
foreach(row IN LISTS rows)
  string(REPLACE "," ";" f "${row}")
  list(LENGTH f count)
  if(count EQUAL 16)
    list(GET f 0 13 pair)
    list(POP_FRONT pair found evidence)
    if(found STREQUAL "${ID}")
      set(have TRUE)
      set(want "${evidence}")
    endif()
  endif()
endforeach()
if(NOT have)
  message(FATAL_ERROR "ledger_crc: ${ID}: no ledger row")
endif()
file(READ "${REPORT}" text)
if(NOT text MATCHES "(^|\n)diagnostic ([0-9a-f]+)\n")
  message(FATAL_ERROR "ledger_crc: ${ID}: no diagnostic line in ${REPORT}")
endif()
set(digits "${CMAKE_MATCH_2}")
string(LENGTH "${digits}" length)
if(length LESS 20)
  message(FATAL_ERROR "ledger_crc: ${ID}: diagnostic line holds ${length} digits, fewer than 20")
endif()
string(SUBSTRING "${digits}" 16 2 low)
string(SUBSTRING "${digits}" 18 2 high)
if(NOT want STREQUAL "${high}${low}")
  message(FATAL_ERROR "ledger_crc: ${ID}: ledger evidence ${want}, mailbox CRC ${high}${low}")
endif()
message(STATUS "ledger_crc: ${ID}: ledger evidence ${want} equals the mailbox CRC")
