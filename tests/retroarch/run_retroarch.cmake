# Isolated bounded frontend launch; shared save storage must survive launch cleanup.
cmake_minimum_required(VERSION 3.25)
set(RA_DIR_REQUESTED "${RA_DIR}")
set(SHOT_REQUESTED "${SHOT}")
set(SAVE_DIR_REQUESTED "${SAVE_DIR}")
foreach(var RETROARCH CORE INFO TEMPLATE RA_DIR FRAMES SHOT)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "run_retroarch: -D${var} is required")
  endif()
endforeach()
if(NOT MODE)
  set(MODE "legacy")
endif()
if(NOT MODE STREQUAL "legacy" AND NOT MODE STREQUAL "states")
  message(FATAL_ERROR "run_retroarch: unsupported MODE ${MODE}")
endif()
foreach(var RA_DIR SHOT SAVE_DIR HSC_ROM)
  if(NOT "${${var}}" STREQUAL "")
    get_filename_component(${var} "${${var}}" REALPATH)
  endif()
endforeach()
if(NOT SAVE_DIR)
  message(FATAL_ERROR "run_retroarch: external -DSAVE_DIR is required")
endif()
cmake_path(IS_PREFIX RA_DIR "${SAVE_DIR}" NORMALIZE nested)
cmake_path(IS_PREFIX SAVE_DIR "${RA_DIR}" NORMALIZE parent)
cmake_path(IS_PREFIX SAVE_DIR "${SHOT}" NORMALIZE shot_in_save)
cmake_path(GET RA_DIR ROOT_PATH root)
if(nested OR parent OR shot_in_save OR RA_DIR STREQUAL root)
  message(FATAL_ERROR "run_retroarch: unsafe save/run overlap")
endif()
if(HSC_ROM)
  cmake_path(IS_PREFIX RA_DIR "${HSC_ROM}" NORMALIZE inside)
  if(inside OR NOT EXISTS "${HSC_ROM}" OR IS_DIRECTORY "${HSC_ROM}")
    message(FATAL_ERROR "run_retroarch: unsafe or absent HSC_ROM")
  endif()
endif()

if(MODE STREQUAL "states")
  foreach(var STATE_DRIVER COMPARE STATE_OUT)
    if("${${var}}" STREQUAL "")
      message(FATAL_ERROR "run_retroarch states: -D${var} is required")
    endif()
  endforeach()
  set(STATE_OUT_REQUESTED "${STATE_OUT}")
  file(REAL_PATH "${STATE_OUT}" STATE_OUT)
  file(REAL_PATH "${RA_DIR_REQUESTED}" RA_DIR_CHECKED)
  file(REAL_PATH "${SAVE_DIR_REQUESTED}" SAVE_DIR_CHECKED)
  file(REAL_PATH "${SHOT_REQUESTED}" SHOT_CHECKED)
  cmake_path(NORMAL_PATH STATE_OUT_REQUESTED)
  cmake_path(NORMAL_PATH RA_DIR_REQUESTED)
  cmake_path(NORMAL_PATH SAVE_DIR_REQUESTED)
  cmake_path(NORMAL_PATH SHOT_REQUESTED)
  set(HOST_RECEIPT "${STATE_OUT}/host-receipt.txt")
  cmake_path(IS_PREFIX STATE_OUT "${HOST_RECEIPT}" NORMALIZE receipt_in_output)
  if(NOT STATE_OUT STREQUAL STATE_OUT_REQUESTED OR
     NOT RA_DIR_REQUESTED STREQUAL RA_DIR_CHECKED OR
     NOT SAVE_DIR_REQUESTED STREQUAL SAVE_DIR_CHECKED OR
     NOT SHOT_REQUESTED STREQUAL SHOT_CHECKED)
    message(FATAL_ERROR "run_retroarch states: symlink or path alias rejected before cleanup")
  endif()
  cmake_path(GET STATE_OUT ROOT_PATH state_root)
  if(STATE_OUT STREQUAL state_root OR RA_DIR STREQUAL state_root OR SAVE_DIR STREQUAL state_root)
    message(FATAL_ERROR "run_retroarch states: filesystem root is not a valid output path")
  endif()
  cmake_path(IS_PREFIX CMAKE_CURRENT_BINARY_DIR "${STATE_OUT}" NORMALIZE output_in_build)
  cmake_path(IS_PREFIX STATE_OUT "${RA_DIR}" NORMALIZE ra_in_output)
  cmake_path(IS_PREFIX STATE_OUT "${SAVE_DIR}" NORMALIZE save_in_output)
  cmake_path(IS_PREFIX STATE_OUT "${SHOT}" NORMALIZE shot_in_output)
  cmake_path(IS_PREFIX RA_DIR "${SAVE_DIR}" NORMALIZE save_in_ra)
  cmake_path(IS_PREFIX SAVE_DIR "${RA_DIR}" NORMALIZE ra_in_save)
  cmake_path(IS_PREFIX RA_DIR "${SHOT}" NORMALIZE shot_in_ra)
  cmake_path(IS_PREFIX SAVE_DIR "${SHOT}" NORMALIZE shot_in_save)
  if(NOT output_in_build OR NOT ra_in_output OR NOT save_in_output OR NOT shot_in_output OR
     NOT receipt_in_output OR save_in_ra OR ra_in_save OR shot_in_ra OR shot_in_save OR
     EXISTS "${SHOT}" OR IS_SYMLINK "${SHOT}" OR IS_SYMLINK "${HOST_RECEIPT}")
    message(FATAL_ERROR "run_retroarch states: unsafe output root, alias, or state/screenshot/save overlap")
  endif()
  if(EXISTS "${SAVE_DIR}" OR IS_SYMLINK "${SAVE_DIR}")
    message(FATAL_ERROR "run_retroarch states: save directory must be fresh and absent")
  endif()
  file(REAL_PATH "${STATE_DRIVER}" STATE_DRIVER)
  file(REAL_PATH "${COMPARE}" COMPARE)
  if(NOT INFO_NAME)
    get_filename_component(INFO_NAME "${INFO}" NAME)
  endif()
  if(NOT EXISTS "${STATE_DRIVER}" OR IS_DIRECTORY "${STATE_DRIVER}" OR
     NOT EXISTS "${COMPARE}" OR IS_DIRECTORY "${COMPARE}" OR
     NOT INFO_NAME STREQUAL "muhtari_libretro.info")
    message(FATAL_ERROR "run_retroarch states: owned driver or independent comparator is absent")
  endif()
  foreach(var SOURCE_SHA RUN_ID RUN_ATTEMPT WORKFLOW_EVENT RUN_URL HOST_VERSION
      CORE_ARTIFACT_SHA RUNNER_ARTIFACT_SHA LIBRARY_ARTIFACT_SHA)
    if("${${var}}" STREQUAL "")
      message(FATAL_ERROR "run_retroarch states: -D${var} is required for a source-bound receipt")
    endif()
  endforeach()
  string(LENGTH "${SOURCE_SHA}" source_sha_length)
  if(NOT source_sha_length EQUAL 40 OR NOT SOURCE_SHA MATCHES "^[0-9a-fA-F]+$" OR
     NOT RUN_ID MATCHES "^[0-9]+$" OR NOT RUN_ATTEMPT MATCHES "^[0-9]+$" OR
     NOT WORKFLOW_EVENT STREQUAL "workflow_dispatch" OR
     NOT RUN_URL MATCHES "^https://github\\.com/.+/actions/runs/[0-9]+$" OR
     NOT HOST_VERSION STREQUAL "1.22.2")
    message(FATAL_ERROR "run_retroarch states: workflow source, event, URL, or pinned host identity is invalid")
  endif()
  foreach(var CORE_ARTIFACT_SHA RUNNER_ARTIFACT_SHA LIBRARY_ARTIFACT_SHA)
    string(LENGTH "${${var}}" artifact_sha_length)
    if(NOT artifact_sha_length EQUAL 64 OR NOT "${${var}}" MATCHES "^[0-9a-fA-F]+$")
      message(FATAL_ERROR "run_retroarch states: -D${var} must be a SHA-256 digest")
    endif()
  endforeach()
endif()

file(REMOVE_RECURSE "${RA_DIR}")
foreach(sub home assets cache cores info logs playlists saves shots states system)
  file(MAKE_DIRECTORY "${RA_DIR}/${sub}")
endforeach()
file(MAKE_DIRECTORY "${SAVE_DIR}")
if(HSC_ROM)
  file(COPY_FILE "${HSC_ROM}" "${RA_DIR}/system/highscre.bin")
endif()
set(STATES_CONFIG "")
if(MODE STREQUAL "states")
  set(STATES_CONFIG
    "network_cmd_enable = \"true\"\nnetwork_cmd_port = \"0\"\nstate_slot = \"0\"\nsavestate_auto_index = \"false\"\nsavestate_auto_save = \"false\"\nsavestate_auto_load = \"false\"\nautosave_interval = \"0\"\nrewind_enable = \"true\"\nrewind_granularity = \"1\"\nscreenshot_format = \"bmp\"\n")
endif()
configure_file("${TEMPLATE}" "${RA_DIR}/test.cfg" @ONLY)
file(COPY "${INFO}" DESTINATION "${RA_DIR}/info")
file(REAL_PATH "${CORE}" core)
file(REAL_PATH "${RETROARCH}" retroarch)
get_filename_component(shot_dir "${SHOT}" DIRECTORY)
file(MAKE_DIRECTORY "${shot_dir}")
file(REMOVE "${SHOT}")
set(content "")
if(NOT "${ROM}" STREQUAL "")
  file(REAL_PATH "${ROM}" content)
endif()

if(MODE STREQUAL "states")
  file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/../../tests/diag/frontend-states.a78" expected_fixture)
  if(NOT FRAMES STREQUAL "120" OR NOT content STREQUAL expected_fixture)
    message(FATAL_ERROR "run_retroarch states: only the admitted frontend fixture and 120-frame cap are allowed")
  endif()
  file(SHA256 "${core}" core_sha256)
  file(SHA256 "${content}" fixture_sha256)
  set(receipt_metadata
    "receipt_version=1\nsource_sha256=${SOURCE_SHA}\nrun_id=${RUN_ID}\nrun_attempt=${RUN_ATTEMPT}\nworkflow_event=${WORKFLOW_EVENT}\nrun_url=${RUN_URL}\nhost_runner=macos-15\nhost_version=${HOST_VERSION}\nstate_mode=states\nhost_mode=RetroArch-1.22.2-Metal;run_ahead=one-frame;instance=single;audio=disabled\ncore_artifact_sha256=${CORE_ARTIFACT_SHA}\nrunner_artifact_sha256=${RUNNER_ARTIFACT_SHA}\nlibrary_artifact_sha256=${LIBRARY_ARTIFACT_SHA}\ncore_sha256=${core_sha256}\nfixture_sha256=${fixture_sha256}\nprocess_timeout_seconds=50\nwork_deadline_ms=45000\nowned_cleanup_ms=5000\npresented_frame_cap=120\nexplicit_forward_action_cap=64\n")
  if(EXISTS "${HOST_RECEIPT}")
    file(READ "${HOST_RECEIPT}" prior_receipt)
    foreach(required IN ITEMS "source_sha256=${SOURCE_SHA}" "run_id=${RUN_ID}"
        "run_attempt=${RUN_ATTEMPT}" "workflow_event=${WORKFLOW_EVENT}" "run_url=${RUN_URL}"
        "host_version=${HOST_VERSION}" "state_mode=states"
        "core_artifact_sha256=${CORE_ARTIFACT_SHA}"
        "runner_artifact_sha256=${RUNNER_ARTIFACT_SHA}"
        "library_artifact_sha256=${LIBRARY_ARTIFACT_SHA}")
      string(FIND "${prior_receipt}" "${required}" found)
      if(found EQUAL -1)
        message(FATAL_ERROR "run_retroarch states: prelaunch receipt identity mismatch for ${required}")
      endif()
    endforeach()
  else()
    file(WRITE "${HOST_RECEIPT}" "${receipt_metadata}")
  endif()
  file(APPEND "${HOST_RECEIPT}" "host_process_command=${STATE_DRIVER} --host ${retroarch} ${core} ${core_sha256} ${INFO} ${content} ${RA_DIR} ${SAVE_DIR} ${STATE_OUT} ${COMPARE} ${SHOT} ${FRAMES}\nhost_process_started=true\n")
  file(MAKE_DIRECTORY "${SAVE_DIR}")
  execute_process(
    COMMAND "${STATE_DRIVER}" --host "${retroarch}" "${core}" "${core_sha256}"
      "${RA_DIR}/info/${INFO_NAME}" "${content}" "${RA_DIR}" "${SAVE_DIR}"
      "${STATE_OUT}" "${COMPARE}" "${SHOT}" "${FRAMES}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 50)
  file(SHA256 "${core}" core_sha256_after)
  file(APPEND "${HOST_RECEIPT}"
    "driver_result=${result}\ndriver_stdout_begin\n${output}\ndriver_stderr_begin\n${error}\ndriver_output_end\ncore_sha256_after=${core_sha256_after}\n")
  if(NOT core_sha256 STREQUAL core_sha256_after)
    file(APPEND "${HOST_RECEIPT}" "host_outcome=failed\nreason=core_changed_during_host_process\n")
    message(FATAL_ERROR "run_retroarch states: same-run core artifact changed during host process")
  endif()
  if(NOT result STREQUAL "0")
    file(APPEND "${HOST_RECEIPT}" "host_outcome=failed\n")
    set(states_log "")
    if(EXISTS "${RA_DIR}/retroarch.log")
      file(READ "${RA_DIR}/retroarch.log" states_log LIMIT 16384)
    endif()
    message(FATAL_ERROR "run_retroarch states exited '${result}'. Receipt: ${HOST_RECEIPT}\nOutput:\n${output}${error}\nRetroArch log:\n${states_log}")
  endif()
  if(NOT EXISTS "${SHOT}")
    file(APPEND "${HOST_RECEIPT}" "host_outcome=failed\nreason=final_screenshot_missing\n")
    message(FATAL_ERROR "run_retroarch states wrote no final independently judged screenshot at ${SHOT}; receipt: ${HOST_RECEIPT}")
  endif()
  file(SIZE "${SHOT}" size)
  file(SHA256 "${SHOT}" shot_sha256)
  if(size LESS 1)
    file(APPEND "${HOST_RECEIPT}" "host_outcome=failed\nreason=final_screenshot_empty\n")
    message(FATAL_ERROR "run_retroarch states wrote an empty final screenshot at ${SHOT}; receipt: ${HOST_RECEIPT}")
  endif()
  file(APPEND "${HOST_RECEIPT}" "screenshot_sha256=${shot_sha256}\nscreenshot_bytes=${size}\n")
  if(NOT EXISTS "${SAVE_DIR}/frontend-states.srm" OR IS_DIRECTORY "${SAVE_DIR}/frontend-states.srm")
    file(APPEND "${HOST_RECEIPT}" "raw_save_status=missing\nhost_outcome=failed\nreason=committed_raw_save_missing\n")
    message(FATAL_ERROR "run_retroarch states produced no committed raw save; receipt: ${HOST_RECEIPT}")
  endif()
  file(SIZE "${SAVE_DIR}/frontend-states.srm" save_size)
  file(SHA256 "${SAVE_DIR}/frontend-states.srm" save_sha256)
  if(NOT save_size EQUAL 2048)
    file(APPEND "${HOST_RECEIPT}" "raw_save_status=invalid_size\nraw_save_sha256=${save_sha256}\nraw_save_bytes=${save_size}\nhost_outcome=failed\nreason=committed_raw_save_wrong_size\n")
    message(FATAL_ERROR "run_retroarch states committed raw save has ${save_size} bytes; expected 2048; receipt: ${HOST_RECEIPT}")
  endif()
  file(APPEND "${HOST_RECEIPT}" "raw_save_status=present\nraw_save_sha256=${save_sha256}\nraw_save_bytes=${save_size}\nhost_outcome=pass\n")
  message(STATUS "RetroArch states ran ${FRAMES} maximum frames with explicit save/load; core sha256=${core_sha256}, screenshot=${SHOT} (${size} bytes), raw save=${save_size} bytes, receipt=${HOST_RECEIPT}")
  message(STATUS "${output}${error}")
  return()
endif()

execute_process(
  COMMAND "${CMAKE_COMMAND}" -E env "HOME=${RA_DIR}/home" "CFFIXED_USER_HOME=${RA_DIR}/home"
    "${retroarch}" --verbose --config "${RA_DIR}/test.cfg" -L "${core}"
    "--max-frames=${FRAMES}" --max-frames-ss "--max-frames-ss-path=${SHOT}" ${content}
  RESULT_VARIABLE result
  OUTPUT_VARIABLE log
  ERROR_VARIABLE log
  TIMEOUT 50)
file(WRITE "${RA_DIR}/retroarch.log" "${log}")
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "RetroArch exited with '${result}'. Its log:\n${log}")
endif()
if(NOT EXISTS "${SHOT}")
  message(FATAL_ERROR "RetroArch wrote no screenshot at ${SHOT}. Its log:\n${log}")
endif()
file(SIZE "${SHOT}" size)
message(STATUS "RetroArch ran ${FRAMES} frames and wrote ${SHOT} (${size} bytes)")
