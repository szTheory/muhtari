# Isolated bounded frontend launch; shared save storage must survive launch cleanup.
cmake_minimum_required(VERSION 3.25)
foreach(var RETROARCH CORE INFO TEMPLATE RA_DIR FRAMES SHOT)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "run_retroarch: -D${var} is required")
  endif()
endforeach()
foreach(var RA_DIR SHOT SAVE_DIR HSC_ROM RAW_SHOTS)
  if(NOT "${${var}}" STREQUAL "")
    get_filename_component(${var} "${${var}}" REALPATH)
  endif()
endforeach()
set(INPUT_JOYPAD_CONFIG "")
set(launcher "")
if(INPUT_MODE STREQUAL "probe" AND "${KEYBOARD}" STREQUAL "")
  message(FATAL_ERROR "run_retroarch: probe requires KEYBOARD")
endif()
if(NOT "${KEYBOARD}" STREQUAL "")
  if(NOT EXISTS "${KEYBOARD}" OR IS_DIRECTORY "${KEYBOARD}")
    message(FATAL_ERROR "run_retroarch: absent or directory KEYBOARD")
  endif()
  get_filename_component(input_argument "${KEYBOARD}" ABSOLUTE)
  file(REAL_PATH "${KEYBOARD}" input_script)
  cmake_path(IS_PREFIX RA_DIR "${input_argument}" NORMALIZE argument_inside)
  cmake_path(IS_PREFIX RA_DIR "${input_script}" NORMALIZE input_inside)
  execute_process(COMMAND /bin/sh -c "test -f \"$1\"" _ "${input_script}"
    RESULT_VARIABLE input_regular)
  if(argument_inside OR input_inside OR NOT input_regular STREQUAL "0")
    message(FATAL_ERROR "run_retroarch: KEYBOARD must be a regular file outside disposable RA_DIR")
  endif()
  if(NOT INPUT_MODE MATCHES "^(held|released|probe)$")
    message(FATAL_ERROR "run_retroarch: KEYBOARD requires held/released/probe INPUT_MODE")
  endif()
  set(launcher "${input_script}" "--${INPUT_MODE}")
  if(INPUT_MODE STREQUAL "probe")
    if(NOT RAW_SHOTS STREQUAL "${RA_DIR}/shots")
      message(FATAL_ERROR "run_retroarch: probe RAW_SHOTS must be the isolated RA_DIR/shots")
    endif()
    cmake_path(IS_PREFIX RAW_SHOTS "${SHOT}" NORMALIZE terminal_in_raw)
    if(terminal_in_raw)
      message(FATAL_ERROR "run_retroarch: terminal SHOT must stay outside RAW_SHOTS")
    endif()
    list(APPEND launcher "${RAW_SHOTS}")
  endif()
  set(INPUT_JOYPAD_CONFIG
    "input_player1_up = \"up\"\ninput_player1_b = \"z\"\ninput_screenshot = \"f8\"\nvideo_vsync = \"true\"\nvideo_swap_interval = \"1\"")
endif()
if(NOT SAVE_DIR)
  message(FATAL_ERROR "run_retroarch: external -DSAVE_DIR is required")
endif()
cmake_path(IS_PREFIX RA_DIR "${SAVE_DIR}" NORMALIZE nested)
cmake_path(IS_PREFIX SAVE_DIR "${RA_DIR}" NORMALIZE parent)
cmake_path(IS_PREFIX SAVE_DIR "${SHOT}" NORMALIZE shot_in_save)
cmake_path(GET RA_DIR ROOT_PATH root)
if(nested OR parent OR shot_in_save OR RA_DIR STREQUAL root)
  message(FATAL_ERROR "run_retroarch: unsafe save/run overlap")
endif()
if(HSC_ROM)
  cmake_path(IS_PREFIX RA_DIR "${HSC_ROM}" NORMALIZE inside)
  if(inside OR NOT EXISTS "${HSC_ROM}" OR IS_DIRECTORY "${HSC_ROM}")
    message(FATAL_ERROR "run_retroarch: unsafe or absent HSC_ROM")
  endif()
endif()

file(REMOVE_RECURSE "${RA_DIR}")
foreach(sub home assets cache cores info logs playlists saves shots states system)
  file(MAKE_DIRECTORY "${RA_DIR}/${sub}")
endforeach()
file(MAKE_DIRECTORY "${SAVE_DIR}")
if(HSC_ROM)
  file(COPY_FILE "${HSC_ROM}" "${RA_DIR}/system/highscre.bin")
endif()
configure_file("${TEMPLATE}" "${RA_DIR}/test.cfg" @ONLY)
file(COPY "${INFO}" DESTINATION "${RA_DIR}/info")
file(REAL_PATH "${CORE}" core)
file(REAL_PATH "${RETROARCH}" retroarch)
get_filename_component(shot_dir "${SHOT}" DIRECTORY)
file(MAKE_DIRECTORY "${shot_dir}")
file(REMOVE "${SHOT}")
set(content "")
if(NOT "${ROM}" STREQUAL "")
  file(REAL_PATH "${ROM}" content)
endif()

execute_process(
  COMMAND "${CMAKE_COMMAND}" -E env "HOME=${RA_DIR}/home" "CFFIXED_USER_HOME=${RA_DIR}/home"
    ${launcher} "${retroarch}" --verbose --config "${RA_DIR}/test.cfg" -L "${core}"
    "--max-frames=${FRAMES}" --max-frames-ss "--max-frames-ss-path=${SHOT}" ${content}
  RESULT_VARIABLE result
  OUTPUT_VARIABLE log
  ERROR_VARIABLE log
  TIMEOUT 50)
file(WRITE "${RA_DIR}/retroarch.log" "${log}")
if(NOT result STREQUAL "0")
  message(FATAL_ERROR "RetroArch exited with '${result}'. Its log:\n${log}")
endif()
if(NOT EXISTS "${SHOT}")
  message(FATAL_ERROR "RetroArch wrote no screenshot at ${SHOT}. Its log:\n${log}")
endif()
file(SIZE "${SHOT}" size)
message(STATUS "RetroArch ran ${FRAMES} frames and wrote ${SHOT} (${size} bytes)")
