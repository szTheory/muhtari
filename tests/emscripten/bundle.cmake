# Source-bound Emscripten archive creation and validation. Including this file
# defines helpers only; direct -P execution is the sole dispatch path.

set(_muhtari_bundle_image
  "emscripten/emsdk@sha256:6bd7aef93408b10bf7b36642cb7c91119b302f720b9ec2d20439f73cf07fe894")
set(_muhtari_bundle_leaf
  "sha256:3803e37bf748ddee14d31cf712fcab09ca367fca83bbefeb78ce4c1f284e6f3f")
set(_muhtari_bundle_platform "linux/amd64")
set(_muhtari_bundle_emcc "7.0.0 (777e6e5db7b4990bcaeb1b9998ed642cc84e6629)")

# The measured 14-member release is 321,034 uncompressed bytes (the Wasm is
# 191,040 bytes; all five pinned notice texts total 58,270 bytes). Keep one
# validation extraction at or below 16 MiB, with an 8 MiB ceiling per member.
# This allows over 50x aggregate growth while bounding scratch-disk use; it is
# an uncompressed expansion defense, not a compressed archive quota.
set(_muhtari_bundle_member_limit 8388608)
set(_muhtari_bundle_total_limit 16777216)

function(muhtari_bundle_qualified_notice_digests output)
  set(qualified
    "licenses/emscripten/LICENSE=620a78084fc7ca97c0b5dea9abf891f3ffcadfdbf305276f099c9c4e12fc1d86"
    "licenses/emscripten/AUTHORS=3fb38cc87b2b57a2a1aae3ad2e984c3bc23cf7441d20e6897739fbc3f96414c4"
    "licenses/musl/COPYRIGHT=b870108ec5e7790e9f9919064f1b9421d62d5f9b0e6c230c6adf7ea2da62e97b"
    "licenses/compiler-rt/LICENSE.TXT=1a8f1058753f1ba890de984e48f0242a3a5c29a6a8f2ed9fd813f36985387e8d"
    "licenses/compiler-rt/CREDITS.TXT=a9901f47a089da41e4690682d00ce4cedaa2baf41fedbe79beee366d43ac2461")
  set(${output} "${qualified}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_fail text)
  message(FATAL_ERROR "emscripten.bundle: ${text}")
endfunction()

function(_muhtari_bundle_reject_symlink_components path stop label)
  set(candidate "${path}")
  while(NOT candidate STREQUAL stop)
    if(IS_SYMLINK "${candidate}")
      _muhtari_bundle_fail("${label} path contains a symlink: ${candidate}")
    endif()
    get_filename_component(parent "${candidate}" DIRECTORY)
    if(parent STREQUAL candidate)
      break()
    endif()
    set(candidate "${parent}")
  endwhile()
endfunction()

function(_muhtari_bundle_reject_tree_symlinks directory label)
  file(GLOB_RECURSE children LIST_DIRECTORIES true
    "${directory}/*" "${directory}/.[!.]*" "${directory}/..?*")
  foreach(child IN LISTS children)
    if(IS_SYMLINK "${child}")
      _muhtari_bundle_fail("${label} contains a symlink: ${child}")
    endif()
  endforeach()
endfunction()

function(_muhtari_bundle_normalize root build work root_out build_out work_out)
  if("${root}" STREQUAL "" OR "${build}" STREQUAL "" OR "${work}" STREQUAL "")
    _muhtari_bundle_fail("-DROOT, -DBUILD and -DWORK are required")
  endif()
  get_filename_component(root_abs "${root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
  get_filename_component(build_abs "${build}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(work_abs "${work}" ABSOLUTE BASE_DIR "${root_abs}")
  if(NOT IS_DIRECTORY "${root_abs}")
    _muhtari_bundle_fail("repository root is not a directory: ${root_abs}")
  endif()
  if(NOT IS_DIRECTORY "${build_abs}")
    _muhtari_bundle_fail("BUILD is not an existing directory: ${build_abs}")
  endif()
  set(build_parent "${build_abs}")
  cmake_path(IS_PREFIX build_parent "${work_abs}" NORMALIZE work_below_build)
  if(NOT work_below_build OR work_abs STREQUAL build_abs)
    _muhtari_bundle_fail("WORK must be a dedicated child of BUILD")
  endif()
  _muhtari_bundle_reject_symlink_components("${work_abs}" "${build_abs}" "WORK")
  file(REAL_PATH "${root_abs}" root_real)
  file(REAL_PATH "${build_abs}" build_real)
  get_filename_component(work_parent "${work_abs}" DIRECTORY)
  if(NOT IS_DIRECTORY "${work_parent}")
    _muhtari_bundle_fail("WORK parent must exist: ${work_parent}")
  endif()
  file(REAL_PATH "${work_parent}" work_parent_real)
  cmake_path(IS_PREFIX build_real "${work_parent_real}" NORMALIZE parent_below_build)
  if(NOT parent_below_build AND NOT work_parent_real STREQUAL build_real)
    _muhtari_bundle_fail("WORK parent resolves outside BUILD: ${work_parent_real}")
  endif()
  if(EXISTS "${work_abs}" AND NOT IS_DIRECTORY "${work_abs}")
    _muhtari_bundle_fail("WORK is not a directory: ${work_abs}")
  endif()
  if(EXISTS "${work_abs}")
    file(REAL_PATH "${work_abs}" work_real)
  else()
    get_filename_component(work_leaf "${work_abs}" NAME)
    set(work_real "${work_parent_real}/${work_leaf}")
  endif()
  cmake_path(IS_PREFIX build_real "${work_real}" NORMALIZE work_physically_below_build)
  if(NOT work_physically_below_build OR work_real STREQUAL build_real)
    _muhtari_bundle_fail("WORK resolves outside BUILD: ${work_real}")
  endif()
  set(${root_out} "${root_real}" PARENT_SCOPE)
  set(${build_out} "${build_real}" PARENT_SCOPE)
  set(${work_out} "${work_abs}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_members root output)
  set(manifest "${root}/tests/emscripten/bundle-members.txt")
  if(NOT EXISTS "${manifest}" OR IS_DIRECTORY "${manifest}")
    _muhtari_bundle_fail("member manifest is missing: ${manifest}")
  endif()
  file(STRINGS "${manifest}" members)
  set(sorted ${members})
  list(SORT sorted)
  list(LENGTH members member_count)
  if(NOT member_count EQUAL 14 OR NOT members STREQUAL sorted)
    _muhtari_bundle_fail("member manifest must contain exactly fourteen sorted paths (count=${member_count}; listed=${members}; sorted=${sorted})")
  endif()
  foreach(member IN LISTS members)
    if(NOT member MATCHES "^[A-Za-z0-9._/-]+$"
       OR member MATCHES "(^/|^[A-Za-z]:|(^|/)\.\.?(/|$)|\\\\)")
      _muhtari_bundle_fail("unsafe path in member manifest: ${member}")
    endif()
  endforeach()
  set(${output} "${members}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_notice_source member sdk_root output)
  if(member STREQUAL "licenses/emscripten/LICENSE")
    set(path "${sdk_root}/LICENSE")
  elseif(member STREQUAL "licenses/emscripten/AUTHORS")
    set(path "${sdk_root}/AUTHORS")
  elseif(member STREQUAL "licenses/musl/COPYRIGHT")
    set(path "${sdk_root}/system/lib/libc/musl/COPYRIGHT")
  elseif(member STREQUAL "licenses/compiler-rt/LICENSE.TXT")
    set(path "${sdk_root}/system/lib/compiler-rt/LICENSE.TXT")
  elseif(member STREQUAL "licenses/compiler-rt/CREDITS.TXT")
    set(path "${sdk_root}/system/lib/compiler-rt/CREDITS.TXT")
  else()
    _muhtari_bundle_fail("unqualified SDK notice member: ${member}")
  endif()
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_check_sdk_notices sdk_root notice_digests)
  get_filename_component(sdk_abs "${sdk_root}" ABSOLUTE)
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    if(separator LESS 1)
      _muhtari_bundle_fail("invalid qualified notice table entry")
    endif()
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    _muhtari_bundle_notice_source("${member}" "${sdk_abs}" source)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
      _muhtari_bundle_fail("qualified SDK notice is missing: ${source}")
    endif()
    file(SIZE "${source}" size)
    if(size LESS 1)
      _muhtari_bundle_fail("qualified SDK notice is empty: ${source}")
    endif()
    file(SHA256 "${source}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("qualified SDK notice digest changed: ${member}")
    endif()
  endforeach()
endfunction()

function(_muhtari_bundle_require_file path description)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    _muhtari_bundle_fail("${description} is missing or not a regular file: ${path}")
  endif()
  file(SIZE "${path}" size)
  if(size LESS 1)
    _muhtari_bundle_fail("${description} is empty: ${path}")
  endif()
endfunction()

function(_muhtari_bundle_hash_equal left right description)
  _muhtari_bundle_require_file("${left}" "${description} source")
  _muhtari_bundle_require_file("${right}" "${description} archive member")
  file(SHA256 "${left}" left_hash)
  file(SHA256 "${right}" right_hash)
  if(NOT left_hash STREQUAL right_hash)
    _muhtari_bundle_fail("${description} differs from the current source")
  endif()
endfunction()

function(_muhtari_bundle_metadata path expected_sha metadata_source archive_sidecar native_json)
  file(READ "${path}" raw_metadata)
  if(raw_metadata MATCHES "\r" OR NOT raw_metadata MATCHES "\n$"
     OR raw_metadata MATCHES "\n\n")
    _muhtari_bundle_fail("muhtari-bundle.txt must be nonempty LF-terminated key/value lines")
  endif()
  string(REGEX REPLACE "\n$" "" raw_metadata "${raw_metadata}")
  string(REPLACE "\n" ";" lines "${raw_metadata}")
  set(expected_keys schema commit core_source_sha256 sdk_image sdk_leaf_sha256 sdk_platform emcc)
  set(seen_keys)
  foreach(line IN LISTS lines)
    if(NOT "${line}" MATCHES "^([a-z0-9_]+)=(.+)$")
      _muhtari_bundle_fail("malformed manifest value in muhtari-bundle.txt: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    if(line MATCHES ";")
      _muhtari_bundle_fail("malformed manifest value in muhtari-bundle.txt: ${line}")
    endif()
    if(NOT key IN_LIST expected_keys)
      _muhtari_bundle_fail("unknown manifest key: ${key}")
    endif()
    if(key IN_LIST seen_keys)
      _muhtari_bundle_fail("repeated manifest key: ${key}")
    endif()
    list(APPEND seen_keys "${key}")
    set(meta_${key} "${value}")
  endforeach()
  list(LENGTH seen_keys key_count)
  if(NOT key_count EQUAL 7)
    _muhtari_bundle_fail("muhtari-bundle.txt must contain each of seven keys exactly once")
  endif()
  foreach(key IN LISTS expected_keys)
    if(NOT key IN_LIST seen_keys)
      _muhtari_bundle_fail("missing manifest key: ${key}")
    endif()
  endforeach()
  if(NOT meta_schema STREQUAL "1")
    _muhtari_bundle_fail("unsupported bundle schema")
  endif()
  string(LENGTH "${expected_sha}" commit_length)
  if(NOT commit_length EQUAL 40 OR NOT expected_sha MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("EXPECTED_SHA must be the full lowercase checkout commit")
  endif()
  if(NOT meta_commit STREQUAL expected_sha)
    _muhtari_bundle_fail("bundle commit does not match EXPECTED_SHA")
  endif()
  if(NOT meta_sdk_image STREQUAL _muhtari_bundle_image
     OR NOT meta_sdk_leaf_sha256 STREQUAL _muhtari_bundle_leaf
     OR NOT meta_sdk_platform STREQUAL _muhtari_bundle_platform
     OR NOT meta_emcc STREQUAL _muhtari_bundle_emcc)
    _muhtari_bundle_fail("bundle SDK identity does not match the pinned producer")
  endif()
  string(LENGTH "${meta_core_source_sha256}" source_length)
  if(NOT source_length EQUAL 64 OR NOT meta_core_source_sha256 MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("core_source_sha256 is malformed")
  endif()
  _muhtari_bundle_require_file("${metadata_source}" "current source identity")
  file(STRINGS "${metadata_source}" source_lines)
  list(LENGTH source_lines source_line_count)
  if(NOT source_line_count EQUAL 1)
    _muhtari_bundle_fail("current source identity must be one line")
  endif()
  list(GET source_lines 0 source_id)
  if(NOT source_id STREQUAL meta_core_source_sha256)
    _muhtari_bundle_fail("bundle source identity does not match the built sidecar")
  endif()
  _muhtari_bundle_hash_equal("${metadata_source}" "${archive_sidecar}" "source identity sidecar")
  if(NOT EXISTS "${native_json}" OR IS_DIRECTORY "${native_json}")
    _muhtari_bundle_fail("independent native observer receipt is missing")
  endif()
  file(READ "${native_json}" native_text)
  string(JSON native_source ERROR_VARIABLE native_json_error GET "${native_text}" source_identity)
  if(NOT native_json_error STREQUAL "NOTFOUND")
    _muhtari_bundle_fail("independent native receipt has no source_identity")
  endif()
  if(NOT native_source STREQUAL meta_core_source_sha256)
    _muhtari_bundle_fail("bundle source identity does not match the independent native receipt")
  endif()
  set(MUHTARI_BUNDLE_SOURCE_ID "${meta_core_source_sha256}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_pair_sums path output_paths output_hashes)
  file(READ "${path}" raw_sums)
  if(raw_sums MATCHES "\r" OR NOT raw_sums MATCHES "\n$"
     OR raw_sums MATCHES "\n\n")
    _muhtari_bundle_fail("SHA256SUMS must be nonempty LF-terminated entries")
  endif()
  string(REGEX REPLACE "\n$" "" raw_sums "${raw_sums}")
  string(REPLACE "\n" ";" lines "${raw_sums}")
  list(LENGTH lines line_count)
  if(NOT line_count EQUAL 2)
    _muhtari_bundle_fail("SHA256SUMS must contain exactly two loader/Wasm entries")
  endif()
  set(expected_paths cores/muhtari_libretro.mjs cores/muhtari_libretro.wasm)
  set(paths)
  set(hashes)
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._/-]+)$")
      _muhtari_bundle_fail("malformed SHA256SUMS entry")
    endif()
    set(hash "${CMAKE_MATCH_1}")
    set(path_name "${CMAKE_MATCH_2}")
    string(LENGTH "${hash}" hash_length)
    if(NOT hash_length EQUAL 64)
      _muhtari_bundle_fail("SHA256SUMS digest must be 64 lowercase hex digits")
    endif()
    list(APPEND paths "${path_name}")
    list(APPEND hashes "${hash}")
  endforeach()
  if(NOT paths STREQUAL expected_paths)
    _muhtari_bundle_fail("SHA256SUMS paths must be the two sorted loader/Wasm members")
  endif()
  set(${output_paths} "${paths}" PARENT_SCOPE)
  set(${output_hashes} "${hashes}" PARENT_SCOPE)
endfunction()

function(muhtari_bundle_validate archive root build work expected_sha notice_digests native_json)
  _muhtari_bundle_normalize("${root}" "${build}" "${work}"
    root_abs build_abs work_abs)
  set(root "${root_abs}")
  set(build "${build_abs}")
  set(work "${work_abs}")
  file(MAKE_DIRECTORY "${work_abs}")
  _muhtari_bundle_members("${root}" expected_members)
  _muhtari_bundle_require_file("${archive}" "bundle archive")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    RESULT_VARIABLE list_rc OUTPUT_VARIABLE list_output ERROR_VARIABLE list_error)
  if(NOT list_rc STREQUAL "0")
    _muhtari_bundle_fail("cannot list archive members: ${list_error}")
  endif()
  string(REPLACE "\r\n" "\n" list_output "${list_output}")
  string(REGEX REPLACE "\n+$" "" list_output "${list_output}")
  if(list_output STREQUAL "")
    _muhtari_bundle_fail("archive has no members")
  endif()
  string(REPLACE "\n" ";" actual_members "${list_output}")
  foreach(member IN LISTS actual_members)
    if(NOT member MATCHES "^[A-Za-z0-9._/-]+$"
       OR member MATCHES "(^/|^[A-Za-z]:|(^|/)\.\.?(/|$)|\\\\)")
      _muhtari_bundle_fail("unsafe archive member path: ${member}")
    endif()
  endforeach()
  set(unique_members ${actual_members})
  list(REMOVE_DUPLICATES unique_members)
  list(LENGTH actual_members actual_count)
  list(LENGTH unique_members unique_count)
  if(NOT actual_count EQUAL unique_count)
    _muhtari_bundle_fail("archive contains duplicate members")
  endif()
  set(sorted_actual ${actual_members})
  list(SORT sorted_actual)
  if(NOT sorted_actual STREQUAL expected_members)
    _muhtari_bundle_fail("archive member set differs from bundle-members.txt")
  endif()

  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${archive}"
    RESULT_VARIABLE detail_rc OUTPUT_VARIABLE detail_output ERROR_VARIABLE detail_error)
  if(NOT detail_rc STREQUAL "0")
    _muhtari_bundle_fail("cannot inspect archive member types: ${detail_error}")
  endif()
  string(REPLACE "\r\n" "\n" detail_output "${detail_output}")
  string(REGEX REPLACE "\n+$" "" detail_output "${detail_output}")
  string(REPLACE "\n" ";" detail_lines "${detail_output}")
  set(detail_members)
  set(total_uncompressed 0)
  foreach(line IN LISTS detail_lines)
    string(REGEX MATCH "^([^ ]+)" mode "${line}")
    if(NOT mode MATCHES "^-[-rwxStT]+$")
      _muhtari_bundle_fail("archive member is not a regular file: ${line}")
    endif()
    string(REGEX REPLACE "[ \t]+" ";" columns "${line}")
    list(LENGTH columns column_count)
    if(column_count LESS 6)
      _muhtari_bundle_fail("cannot read uncompressed member size: ${line}")
    endif()
    list(GET columns 4 member_size)
    math(EXPR member_name_index "${column_count} - 1")
    list(GET columns ${member_name_index} detail_member)
    if(NOT member_size MATCHES "^[0-9]+$")
      _muhtari_bundle_fail("cannot read uncompressed member size: ${line}")
    endif()
    list(APPEND detail_members "${detail_member}")
    if(member_size GREATER _muhtari_bundle_member_limit)
      _muhtari_bundle_fail("uncompressed member exceeds ${_muhtari_bundle_member_limit}-byte limit: ${detail_member} (${member_size} bytes)")
    endif()
    math(EXPR total_uncompressed "${total_uncompressed} + ${member_size}")
  endforeach()
  if(NOT detail_members STREQUAL actual_members)
    _muhtari_bundle_fail("archive member size listing differs from its member listing")
  endif()
  if(total_uncompressed GREATER _muhtari_bundle_total_limit)
    _muhtari_bundle_fail("aggregate uncompressed bundle exceeds ${_muhtari_bundle_total_limit}-byte limit (${total_uncompressed} bytes)")
  endif()

  set(extract "${work}/extract")
  if(IS_SYMLINK "${extract}")
    _muhtari_bundle_fail("WORK extract path is a symlink: ${extract}")
  endif()
  if(EXISTS "${extract}")
    if(NOT IS_DIRECTORY "${extract}")
      _muhtari_bundle_fail("WORK extract path is not a directory: ${extract}")
    endif()
    file(REAL_PATH "${extract}" extract_real)
    file(REAL_PATH "${work_abs}" work_real)
    cmake_path(IS_PREFIX work_real "${extract_real}" NORMALIZE extract_below_work)
    if(NOT extract_below_work OR extract_real STREQUAL work_real)
      _muhtari_bundle_fail("WORK extract path resolves outside WORK: ${extract_real}")
    endif()
    _muhtari_bundle_reject_tree_symlinks("${extract}" "WORK extract path")
  endif()
  file(REMOVE_RECURSE "${extract}")
  file(MAKE_DIRECTORY "${extract}")
  if(IS_SYMLINK "${extract}")
    _muhtari_bundle_fail("WORK extract path became a symlink: ${extract}")
  endif()
  file(REAL_PATH "${extract}" extract_real)
  file(REAL_PATH "${build_abs}" build_real)
  cmake_path(IS_PREFIX build_real "${extract_real}" NORMALIZE extract_below_build)
  if(NOT extract_below_build)
    _muhtari_bundle_fail("WORK extract path resolves outside BUILD: ${extract_real}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
  file(GLOB_RECURSE extracted_members LIST_DIRECTORIES false RELATIVE "${extract}" "${extract}/*")
  set(sorted_extracted ${extracted_members})
  list(SORT sorted_extracted)
  if(NOT sorted_extracted STREQUAL expected_members)
    _muhtari_bundle_fail("clean extraction does not contain the exact manifest member set")
  endif()
  foreach(member IN LISTS expected_members)
    _muhtari_bundle_require_file("${extract}/${member}" "archive member ${member}")
  endforeach()

  _muhtari_bundle_metadata("${extract}/muhtari-bundle.txt" "${expected_sha}"
    "${build}/libretro/muhtari-source-id.txt"
    "${extract}/cores/muhtari-source-id.txt" "${native_json}")
  foreach(member IN ITEMS LICENSE THIRD-PARTY-NOTICES.md HOSTING.md info/muhtari_libretro.info)
    if(member STREQUAL "LICENSE")
      set(source "${root}/LICENSE")
    elseif(member STREQUAL "THIRD-PARTY-NOTICES.md")
      set(source "${root}/THIRD-PARTY-NOTICES.md")
    elseif(member STREQUAL "HOSTING.md")
      set(source "${root}/docs/emscripten-hosting.md")
    else()
      set(source "${build}/libretro/muhtari_libretro.info")
    endif()
    _muhtari_bundle_hash_equal("${source}" "${extract}/${member}" "${member}")
  endforeach()

  set(expected_notice_members
    licenses/emscripten/LICENSE
    licenses/emscripten/AUTHORS
    licenses/musl/COPYRIGHT
    licenses/compiler-rt/LICENSE.TXT
    licenses/compiler-rt/CREDITS.TXT)
  set(actual_notice_members)
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    if(separator LESS 1)
      _muhtari_bundle_fail("invalid notice digest table entry")
    endif()
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    string(LENGTH "${expected}" digest_length)
    if(NOT digest_length EQUAL 64 OR NOT expected MATCHES "^[0-9a-f]+$")
      _muhtari_bundle_fail("notice digest is malformed: ${member}")
    endif()
    list(APPEND actual_notice_members "${member}")
  endforeach()
  set(sorted_notice_members ${actual_notice_members})
  list(SORT sorted_notice_members)
  set(sorted_expected_notice_members ${expected_notice_members})
  list(SORT sorted_expected_notice_members)
  if(NOT sorted_notice_members STREQUAL sorted_expected_notice_members)
    _muhtari_bundle_fail("notice digest table must name each of the five runtime texts exactly once")
  endif()
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    file(SHA256 "${extract}/${member}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("runtime notice digest mismatch: ${member}")
    endif()
  endforeach()

  _muhtari_bundle_pair_sums("${extract}/SHA256SUMS" pair_paths pair_hashes)
  foreach(index RANGE 0 1)
    list(GET pair_paths ${index} member)
    list(GET pair_hashes ${index} expected)
    file(SHA256 "${extract}/${member}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("SHA256SUMS mismatch for ${member}")
    endif()
    string(REPLACE "cores/" "" build_member "${member}")
    _muhtari_bundle_hash_equal("${build}/libretro/${build_member}" "${extract}/${member}" "${member}")
  endforeach()
  set(MUHTARI_BUNDLE_EXTRACTED "${extract}" PARENT_SCOPE)
endfunction()

function(muhtari_bundle_verify_consumer root extracted native_json fixture node)
  foreach(required IN ITEMS "${native_json}" "${fixture}" "${node}")
    if("${required}" STREQUAL "")
      _muhtari_bundle_fail("NODE, native receipt and fixture are required for extracted consumer verification")
    endif()
  endforeach()
  _muhtari_bundle_require_file("${native_json}" "independent native observer receipt")
  _muhtari_bundle_require_file("${fixture}" "native observer fixture")
  _muhtari_bundle_require_file("${node}" "pinned Node executable")
  execute_process(COMMAND "${node}" "${root}/tests/emscripten/host.mjs"
    --module "${extracted}/cores/muhtari_libretro.mjs"
    --fixture "${fixture}" --native "${native_json}" --mode verify
    RESULT_VARIABLE consumer_rc OUTPUT_VARIABLE consumer_out ERROR_VARIABLE consumer_err
    WORKING_DIRECTORY "${root}")
  if(NOT consumer_rc STREQUAL "0")
    _muhtari_bundle_fail("clean-extracted Node/native consumer failed (${consumer_rc}): ${consumer_out}${consumer_err}")
  endif()
  message(STATUS "emscripten.bundle: clean-extracted Node/native consumer passed")
endfunction()

function(_muhtari_bundle_create root build work expected_sha notice_digests sdk_root native_json fixture node)
  string(LENGTH "${expected_sha}" commit_length)
  if(NOT commit_length EQUAL 40 OR NOT expected_sha MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("EXPECTED_SHA must be the full lowercase checkout commit")
  endif()
  _muhtari_bundle_check_sdk_notices("${sdk_root}" "${notice_digests}")
  set(libretro "${build}/libretro")
  foreach(path IN ITEMS
      "${libretro}/muhtari_libretro.mjs" "${libretro}/muhtari_libretro.wasm"
      "${libretro}/muhtari-source-id.txt" "${libretro}/muhtari_libretro.info")
    _muhtari_bundle_require_file("${path}" "built Emscripten input")
  endforeach()

  file(MAKE_DIRECTORY "${work}")
  set(stage "${work}/stage")
  if(IS_SYMLINK "${stage}")
    _muhtari_bundle_fail("WORK stage path is a symlink: ${stage}")
  endif()
  if(EXISTS "${stage}")
    if(NOT IS_DIRECTORY "${stage}")
      _muhtari_bundle_fail("WORK stage path is not a directory: ${stage}")
    endif()
    file(REAL_PATH "${stage}" stage_real)
    file(REAL_PATH "${work}" work_real)
    cmake_path(IS_PREFIX work_real "${stage_real}" NORMALIZE stage_below_work)
    if(NOT stage_below_work OR stage_real STREQUAL work_real)
      _muhtari_bundle_fail("WORK stage path resolves outside WORK: ${stage_real}")
    endif()
    _muhtari_bundle_reject_tree_symlinks("${stage}" "WORK stage path")
    file(REMOVE_RECURSE "${stage}")
  endif()
  file(MAKE_DIRECTORY "${stage}/cores" "${stage}/info"
    "${stage}/licenses/emscripten" "${stage}/licenses/musl" "${stage}/licenses/compiler-rt")
  file(COPY_FILE "${root}/LICENSE" "${stage}/LICENSE")
  file(COPY_FILE "${root}/THIRD-PARTY-NOTICES.md" "${stage}/THIRD-PARTY-NOTICES.md")
  file(COPY_FILE "${root}/docs/emscripten-hosting.md" "${stage}/HOSTING.md")
  file(COPY_FILE "${libretro}/muhtari_libretro.mjs" "${stage}/cores/muhtari_libretro.mjs")
  file(COPY_FILE "${libretro}/muhtari_libretro.wasm" "${stage}/cores/muhtari_libretro.wasm")
  file(COPY_FILE "${libretro}/muhtari-source-id.txt" "${stage}/cores/muhtari-source-id.txt")
  file(COPY_FILE "${libretro}/muhtari_libretro.info" "${stage}/info/muhtari_libretro.info")
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    _muhtari_bundle_notice_source("${member}" "${sdk_root}" source)
    file(COPY_FILE "${source}" "${stage}/${member}")
    file(SHA256 "${stage}/${member}" copied_hash)
    if(NOT copied_hash STREQUAL expected)
      _muhtari_bundle_fail("copied SDK notice failed its qualified digest: ${member}")
    endif()
  endforeach()
  file(STRINGS "${libretro}/muhtari-source-id.txt" source_lines)
  list(LENGTH source_lines source_line_count)
  if(NOT source_line_count EQUAL 1 OR NOT source_lines MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("built source identity is malformed")
  endif()
  list(GET source_lines 0 source_id)
  file(WRITE "${stage}/muhtari-bundle.txt"
    "schema=1\ncommit=${expected_sha}\ncore_source_sha256=${source_id}\n"
    "sdk_image=${_muhtari_bundle_image}\nsdk_leaf_sha256=${_muhtari_bundle_leaf}\n"
    "sdk_platform=${_muhtari_bundle_platform}\nemcc=${_muhtari_bundle_emcc}\n")
  set(pair_paths cores/muhtari_libretro.mjs cores/muhtari_libretro.wasm)
  foreach(member IN LISTS pair_paths)
    file(SHA256 "${stage}/${member}" pair_hash)
    file(APPEND "${stage}/SHA256SUMS" "${pair_hash}  ${member}\n")
  endforeach()

  _muhtari_bundle_members("${root}" members)
  set(archive "${build}/muhtari-libretro-emscripten.zip")
  file(REMOVE "${archive}")
  file(ARCHIVE_CREATE OUTPUT "${archive}" PATHS ${members}
    FORMAT zip WORKING_DIRECTORY "${stage}")
  muhtari_bundle_validate("${archive}" "${root}" "${build}" "${work}"
    "${expected_sha}" "${notice_digests}" "${native_json}")
  muhtari_bundle_verify_consumer("${root}" "${work}/extract" "${native_json}" "${fixture}" "${node}")
  message(STATUS "emscripten.bundle: created ${archive}")
endfunction()

function(_muhtari_bundle_control_metadata path commit source_id emcc)
  file(WRITE "${path}"
    "schema=1\ncommit=${commit}\ncore_source_sha256=${source_id}\n"
    "sdk_image=${_muhtari_bundle_image}\nsdk_leaf_sha256=${_muhtari_bundle_leaf}\n"
    "sdk_platform=${_muhtari_bundle_platform}\nemcc=${emcc}\n")
endfunction()

function(_muhtari_bundle_pack_control_archive stage archive members)
  set(paths)
  foreach(member IN LISTS members)
    if(EXISTS "${stage}/${member}")
      list(APPEND paths "${member}")
    endif()
  endforeach()
  file(REMOVE "${archive}")
  file(ARCHIVE_CREATE OUTPUT "${archive}" PATHS ${paths}
    FORMAT zip WORKING_DIRECTORY "${stage}")
endfunction()

function(_muhtari_bundle_expect_internal_failure root build work expected_sha notice_digests native_json archive expected_text)
  set(driver "${work}-driver.cmake")
  file(WRITE "${driver}"
    "include(\"${root}/tests/emscripten/bundle.cmake\")\n"
    "muhtari_bundle_validate(\"${archive}\" \"${root}\" \"${build}\" \"${work}\" \"${expected_sha}\" \"${notice_digests}\" \"${native_json}\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${driver}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(output "${out}${err}")
  string(REGEX REPLACE "[ \t\r\n]+" " " normalized_output "${output}")
  string(FIND "${normalized_output}" "${expected_text}" match_at)
  if(NOT rc STREQUAL "1" OR match_at EQUAL -1)
    _muhtari_bundle_fail("control expected exit 1 and '${expected_text}', got exit ${rc}: ${output}")
  endif()
  message(STATUS "emscripten.bundle.controls: rejected ${expected_text}")
endfunction()

function(_muhtari_bundle_expect_cli_failure root build work expected_sha notice_native fixture archive expected_text)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DROOT=${root}" "-DBUILD=${build}" "-DWORK=${work}"
    "-DMODE=validate" "-DEXPECTED_SHA=${expected_sha}"
    "-DNATIVE=${notice_native}" "-DFIXTURE=${fixture}" "-DARCHIVE=${archive}"
    -P "${root}/tests/emscripten/bundle.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(output "${out}${err}")
  string(REGEX REPLACE "[ \t\r\n]+" " " normalized_output "${output}")
  string(FIND "${normalized_output}" "${expected_text}" match_at)
  if(NOT rc STREQUAL "1" OR match_at EQUAL -1)
    _muhtari_bundle_fail("production control expected exit 1 and '${expected_text}', got exit ${rc}: ${output}")
  endif()
  message(STATUS "emscripten.bundle.controls: production path rejected ${expected_text}")
endfunction()

function(_muhtari_bundle_expect_cli_success root build work expected_sha native fixture archive)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DROOT=${root}" "-DBUILD=${build}" "-DWORK=${work}"
    "-DMODE=validate" "-DEXPECTED_SHA=${expected_sha}"
    "-DNATIVE=${native}" "-DFIXTURE=${fixture}" "-DARCHIVE=${archive}"
    -P "${root}/tests/emscripten/bundle.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc STREQUAL "0" OR NOT out MATCHES "validated")
    _muhtari_bundle_fail("production path did not validate the SDK archive: ${out}${err}")
  endif()
  message(STATUS "emscripten.bundle.controls: strict production validation passed")
endfunction()

function(_muhtari_bundle_expect_consumer_failure root node fixture native module expected_text)
  execute_process(COMMAND "${node}" "${root}/tests/emscripten/host.mjs"
    --module "${module}" --fixture "${fixture}" --native "${native}" --mode verify
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(output "${out}${err}")
  string(REGEX REPLACE "[ \t\r\n]+" " " normalized_output "${output}")
  string(FIND "${normalized_output}" "${expected_text}" match_at)
  if(rc STREQUAL "0" OR match_at EQUAL -1)
    _muhtari_bundle_fail("damaged extraction consumer did not refuse '${expected_text}': ${output}")
  endif()
  message(STATUS "emscripten.bundle.controls: extracted consumer refused ${expected_text}")
endfunction()

function(_muhtari_bundle_control_copy_members source destination members)
  file(MAKE_DIRECTORY "${destination}")
  foreach(member IN LISTS members)
    get_filename_component(parent "${destination}/${member}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(COPY_FILE "${source}/${member}" "${destination}/${member}")
  endforeach()
endfunction()

function(_muhtari_bundle_synthetic_inputs root work output_build output_archive output_commit output_table output_native output_fixture)
  set(build "${work}/synthetic-build")
  set(stage "${work}/synthetic-stage")
  set(archive "${work}/synthetic.zip")
  set(validate_work "${work}/synthetic-validate")
  string(REPEAT "b" 40 commit)
  string(REPEAT "a" 64 source_id)
  file(MAKE_DIRECTORY "${build}/libretro" "${stage}/cores" "${stage}/info"
    "${stage}/licenses/emscripten" "${stage}/licenses/musl" "${stage}/licenses/compiler-rt")
  file(COPY_FILE "${root}/LICENSE" "${stage}/LICENSE")
  file(COPY_FILE "${root}/THIRD-PARTY-NOTICES.md" "${stage}/THIRD-PARTY-NOTICES.md")
  file(COPY_FILE "${root}/docs/emscripten-hosting.md" "${stage}/HOSTING.md")
  file(WRITE "${build}/libretro/muhtari_libretro.mjs" "export default async function () { return {}; }\n")
  file(WRITE "${build}/libretro/muhtari_libretro.wasm" "synthetic wasm bytes\n")
  file(WRITE "${build}/libretro/muhtari-source-id.txt" "${source_id}\n")
  file(WRITE "${build}/libretro/muhtari_libretro.info" "synthetic libretro metadata\n")
  file(COPY_FILE "${build}/libretro/muhtari_libretro.mjs" "${stage}/cores/muhtari_libretro.mjs")
  file(COPY_FILE "${build}/libretro/muhtari_libretro.wasm" "${stage}/cores/muhtari_libretro.wasm")
  file(COPY_FILE "${build}/libretro/muhtari-source-id.txt" "${stage}/cores/muhtari-source-id.txt")
  file(COPY_FILE "${build}/libretro/muhtari_libretro.info" "${stage}/info/muhtari_libretro.info")
  set(notice_members
    licenses/emscripten/LICENSE
    licenses/emscripten/AUTHORS
    licenses/musl/COPYRIGHT
    licenses/compiler-rt/LICENSE.TXT
    licenses/compiler-rt/CREDITS.TXT)
  set(notice_table)
  foreach(member IN LISTS notice_members)
    set(notice_text "Synthetic control bytes for ${member}\n")
    file(WRITE "${stage}/${member}" "${notice_text}")
    string(SHA256 notice_hash "${notice_text}")
    list(APPEND notice_table "${member}=${notice_hash}")
  endforeach()
  _muhtari_bundle_control_metadata("${stage}/muhtari-bundle.txt" "${commit}" "${source_id}" "${_muhtari_bundle_emcc}")
  foreach(member IN ITEMS cores/muhtari_libretro.mjs cores/muhtari_libretro.wasm)
    file(SHA256 "${stage}/${member}" pair_hash)
    file(APPEND "${stage}/SHA256SUMS" "${pair_hash}  ${member}\n")
  endforeach()
  file(WRITE "${work}/synthetic-native.json" "{\"source_identity\":\"${source_id}\"}\n")
  file(WRITE "${work}/synthetic-fixture.a78" "synthetic fixture bytes\n")
  _muhtari_bundle_members("${root}" members)
  file(ARCHIVE_CREATE OUTPUT "${archive}" PATHS ${members} FORMAT zip WORKING_DIRECTORY "${stage}")
  set(${output_build} "${build}" PARENT_SCOPE)
  set(${output_archive} "${archive}" PARENT_SCOPE)
  set(${output_commit} "${commit}" PARENT_SCOPE)
  set(${output_table} "${notice_table}" PARENT_SCOPE)
  set(${output_native} "${work}/synthetic-native.json" PARENT_SCOPE)
  set(${output_fixture} "${work}/synthetic-fixture.a78" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_run_synthetic_controls root work)
  set(synthetic_work "${work}/synthetic")
  _muhtari_bundle_synthetic_inputs("${root}" "${synthetic_work}"
    synthetic_build synthetic_archive synthetic_commit synthetic_notices synthetic_native synthetic_fixture)
  _muhtari_bundle_members("${root}" members)
  string(REPEAT "a" 64 source_id)
  muhtari_bundle_validate("${synthetic_archive}" "${root}" "${synthetic_build}"
    "${synthetic_build}/validate" "${synthetic_commit}" "${synthetic_notices}" "${synthetic_native}")
  message(STATUS "emscripten.bundle.controls: synthetic package pass")

  set(expansion_members "${synthetic_work}/fault-expansion-member")
  set(expansion_member_stage "${expansion_members}/stage")
  file(REMOVE_RECURSE "${expansion_members}")
  _muhtari_bundle_control_copy_members("${synthetic_work}/synthetic-stage"
    "${expansion_member_stage}" "${members}")
  math(EXPR oversized_member_size "${_muhtari_bundle_member_limit} + 1")
  string(REPEAT "x" ${oversized_member_size} oversized_member)
  file(WRITE "${expansion_member_stage}/cores/muhtari_libretro.wasm" "${oversized_member}")
  set(expansion_member_archive "${expansion_members}/package.zip")
  _muhtari_bundle_pack_control_archive("${expansion_member_stage}"
    "${expansion_member_archive}" "${members}")
  set(expansion_member_work "${synthetic_build}/fault-expansion-member-work")
  _muhtari_bundle_expect_internal_failure("${root}" "${synthetic_build}"
    "${expansion_member_work}" "${synthetic_commit}" "${synthetic_notices}"
    "${synthetic_native}" "${expansion_member_archive}"
    "uncompressed member exceeds ${_muhtari_bundle_member_limit}-byte limit: cores/muhtari_libretro.wasm")
  if(EXISTS "${expansion_member_work}/extract")
    _muhtari_bundle_fail("per-member expansion rejection happened after extraction began")
  endif()

  set(expansion_total "${synthetic_work}/fault-expansion-total")
  set(expansion_total_stage "${expansion_total}/stage")
  file(REMOVE_RECURSE "${expansion_total}")
  _muhtari_bundle_control_copy_members("${synthetic_work}/synthetic-stage"
    "${expansion_total_stage}" "${members}")
  string(REPEAT "y" 6291456 large_member)
  foreach(member IN ITEMS LICENSE THIRD-PARTY-NOTICES.md HOSTING.md)
    file(WRITE "${expansion_total_stage}/${member}" "${large_member}")
  endforeach()
  set(expansion_total_archive "${expansion_total}/package.zip")
  _muhtari_bundle_pack_control_archive("${expansion_total_stage}"
    "${expansion_total_archive}" "${members}")
  set(expansion_total_work "${synthetic_build}/fault-expansion-total-work")
  _muhtari_bundle_expect_internal_failure("${root}" "${synthetic_build}"
    "${expansion_total_work}" "${synthetic_commit}" "${synthetic_notices}"
    "${synthetic_native}" "${expansion_total_archive}"
    "aggregate uncompressed bundle exceeds ${_muhtari_bundle_total_limit}-byte limit")
  if(EXISTS "${expansion_total_work}/extract")
    _muhtari_bundle_fail("aggregate expansion rejection happened after extraction began")
  endif()
  message(STATUS "emscripten.bundle.controls: pre-extraction member and aggregate expansion bounds passed")

  _muhtari_bundle_expect_cli_failure("${root}" "${synthetic_build}"
    "${synthetic_build}/strict-synthetic" "${synthetic_commit}" "${synthetic_native}"
    "${synthetic_fixture}" "${synthetic_archive}" "runtime notice digest mismatch")

  string(REPEAT "c" 40 wrong_commit)
  set(faults missing_wasm missing_source empty_loader wrong_commit wrong_sdk tampered_wasm changed_notice
    extra_member bad_checksum duplicate_checksum missing_metadata duplicate_metadata)
  foreach(fault IN LISTS faults)
    set(case_root "${synthetic_work}/fault-${fault}")
    set(stage "${case_root}/stage")
    set(archive "${case_root}/package.zip")
    file(REMOVE_RECURSE "${case_root}")
    _muhtari_bundle_control_copy_members("${synthetic_work}/synthetic-stage" "${stage}" "${members}")
    if(fault STREQUAL "missing_wasm")
      file(REMOVE "${stage}/cores/muhtari_libretro.wasm")
      set(expected_text "archive member set differs from bundle-members.txt")
    elseif(fault STREQUAL "missing_source")
      file(REMOVE "${stage}/cores/muhtari-source-id.txt")
      set(expected_text "archive member set differs from bundle-members.txt")
    elseif(fault STREQUAL "empty_loader")
      file(WRITE "${stage}/cores/muhtari_libretro.mjs" "")
      set(expected_text "archive member cores/muhtari_libretro.mjs is empty")
    elseif(fault STREQUAL "wrong_commit")
      _muhtari_bundle_control_metadata("${stage}/muhtari-bundle.txt" "${wrong_commit}" "${source_id}" "${_muhtari_bundle_emcc}")
      set(expected_text "bundle commit does not match EXPECTED_SHA")
    elseif(fault STREQUAL "wrong_sdk")
      _muhtari_bundle_control_metadata("${stage}/muhtari-bundle.txt" "${synthetic_commit}" "${source_id}" "7.1.0")
      set(expected_text "bundle SDK identity does not match the pinned producer")
    elseif(fault STREQUAL "tampered_wasm")
      file(APPEND "${stage}/cores/muhtari_libretro.wasm" "tamper\n")
      set(expected_text "SHA256SUMS mismatch for cores/muhtari_libretro.wasm")
    elseif(fault STREQUAL "changed_notice")
      file(APPEND "${stage}/licenses/emscripten/LICENSE" "changed\n")
      set(expected_text "runtime notice digest mismatch: licenses/emscripten/LICENSE")
    elseif(fault STREQUAL "extra_member")
      file(WRITE "${stage}/extra.bin" "unexpected member\n")
      set(expected_text "archive member set differs from bundle-members.txt")
    elseif(fault STREQUAL "bad_checksum")
      file(WRITE "${stage}/SHA256SUMS" "malformed\n")
      set(expected_text "SHA256SUMS must contain exactly two loader/Wasm entries")
    elseif(fault STREQUAL "duplicate_checksum")
      file(STRINGS "${stage}/SHA256SUMS" checksum_lines)
      list(GET checksum_lines 0 first_checksum)
      file(WRITE "${stage}/SHA256SUMS" "${first_checksum}\n${first_checksum}\n")
      set(expected_text "SHA256SUMS paths must be the two sorted loader/Wasm members")
    elseif(fault STREQUAL "missing_metadata")
      file(WRITE "${stage}/muhtari-bundle.txt"
        "schema=1\ncommit=${synthetic_commit}\ncore_source_sha256=${source_id}\nsdk_image=${_muhtari_bundle_image}\nsdk_leaf_sha256=${_muhtari_bundle_leaf}\nsdk_platform=${_muhtari_bundle_platform}\n")
      set(expected_text "must contain each of seven keys exactly once")
    elseif(fault STREQUAL "duplicate_metadata")
      file(APPEND "${stage}/muhtari-bundle.txt" "commit=${synthetic_commit}\n")
      set(expected_text "repeated manifest key: commit")
    endif()
    _muhtari_bundle_members("${root}" members)
    if(fault STREQUAL "extra_member")
      file(ARCHIVE_CREATE OUTPUT "${archive}" PATHS ${members} extra.bin
        FORMAT zip WORKING_DIRECTORY "${stage}")
    else()
      _muhtari_bundle_pack_control_archive("${stage}" "${archive}" "${members}")
    endif()
    _muhtari_bundle_expect_internal_failure("${root}" "${synthetic_build}"
      "${synthetic_build}/fault-${fault}-work" "${synthetic_commit}" "${synthetic_notices}"
      "${synthetic_native}" "${archive}" "${expected_text}")
  endforeach()

  foreach(fault IN ITEMS path_escape duplicate_member)
    set(case_root "${synthetic_work}/fault-${fault}")
    set(stage "${case_root}/stage")
    set(archive "${case_root}/package.zip")
    file(REMOVE_RECURSE "${case_root}")
    _muhtari_bundle_control_copy_members("${synthetic_work}/synthetic-stage" "${stage}" "${members}")
    if(fault STREQUAL "path_escape")
      file(WRITE "${case_root}/outside.bin" "outside archive root\n")
      execute_process(COMMAND "${CMAKE_COMMAND}" -E chdir "${stage}"
        "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip ${members} ../outside.bin
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
      set(expected_text "unsafe archive member path")
    else()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E chdir "${stage}"
        "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip ${members} LICENSE
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
      set(expected_text "archive contains duplicate members")
    endif()
    if(NOT rc STREQUAL "0")
      _muhtari_bundle_fail("could not construct ${fault} archive control: ${out}${err}")
    endif()
    _muhtari_bundle_expect_internal_failure("${root}" "${synthetic_build}"
      "${synthetic_build}/fault-${fault}-work" "${synthetic_commit}" "${synthetic_notices}"
      "${synthetic_native}" "${archive}" "${expected_text}")
  endforeach()

  set(outside_work "${synthetic_work}/outside-work")
  set(work_sentinel "${outside_work}/sentinel.txt")
  set(work_symlink "${synthetic_build}/work-symlink")
  file(MAKE_DIRECTORY "${outside_work}")
  file(WRITE "${work_sentinel}" "preserve outside work\n")
  file(CREATE_LINK "${outside_work}" "${work_symlink}" SYMBOLIC RESULT link_result)
  if(NOT link_result STREQUAL "0")
    _muhtari_bundle_fail("could not create WORK symlink control: ${link_result}")
  endif()
  _muhtari_bundle_expect_cli_failure("${root}" "${synthetic_build}" "${work_symlink}"
    "${synthetic_commit}" "${synthetic_native}" "${synthetic_fixture}"
    "${synthetic_archive}" "WORK path contains a symlink")
  file(READ "${work_sentinel}" sentinel_text)
  if(NOT sentinel_text STREQUAL "preserve outside work\n")
    _muhtari_bundle_fail("WORK symlink rejection changed outside sentinel")
  endif()
  file(REMOVE "${work_symlink}")

  set(extract_work "${synthetic_build}/fault-extract-symlink-work")
  set(outside_extract "${synthetic_work}/outside-extract")
  set(extract_sentinel "${outside_extract}/sentinel.txt")
  file(MAKE_DIRECTORY "${extract_work}" "${outside_extract}")
  file(WRITE "${extract_sentinel}" "preserve outside extract\n")
  file(CREATE_LINK "${outside_extract}" "${extract_work}/extract" SYMBOLIC RESULT link_result)
  if(NOT link_result STREQUAL "0")
    _muhtari_bundle_fail("could not create extraction symlink control: ${link_result}")
  endif()
  _muhtari_bundle_expect_cli_failure("${root}" "${synthetic_build}" "${extract_work}"
    "${synthetic_commit}" "${synthetic_native}" "${synthetic_fixture}"
    "${synthetic_archive}" "WORK extract path is a symlink")
  file(READ "${extract_sentinel}" sentinel_text)
  if(NOT sentinel_text STREQUAL "preserve outside extract\n")
    _muhtari_bundle_fail("extraction symlink rejection changed outside sentinel")
  endif()
  file(REMOVE "${extract_work}/extract")
  message(STATUS "emscripten.bundle.controls: WORK/extraction symlink escapes rejected with sentinels preserved")

  set(identity_case "${synthetic_work}/fault-independent-native")
  set(identity_stage "${identity_case}/stage")
  set(identity_build "${identity_case}/build")
  file(REMOVE_RECURSE "${identity_case}")
  _muhtari_bundle_control_copy_members("${synthetic_work}/synthetic-stage" "${identity_stage}" "${members}")
  file(MAKE_DIRECTORY "${identity_build}/libretro")
  file(COPY "${synthetic_build}/libretro/" DESTINATION "${identity_build}/libretro")
  string(REPEAT "d" 64 changed_source_id)
  file(WRITE "${identity_build}/libretro/muhtari-source-id.txt" "${changed_source_id}\n")
  file(WRITE "${identity_stage}/cores/muhtari-source-id.txt" "${changed_source_id}\n")
  _muhtari_bundle_control_metadata("${identity_stage}/muhtari-bundle.txt"
    "${synthetic_commit}" "${changed_source_id}" "${_muhtari_bundle_emcc}")
  _muhtari_bundle_members("${root}" members)
  set(identity_archive "${identity_case}/package.zip")
  _muhtari_bundle_pack_control_archive("${identity_stage}" "${identity_archive}" "${members}")
  _muhtari_bundle_expect_internal_failure("${root}" "${identity_build}"
    "${identity_build}/validate" "${synthetic_commit}" "${synthetic_notices}"
    "${synthetic_native}" "${identity_archive}"
    "bundle source identity does not match the independent native receipt")
endfunction()

function(_muhtari_bundle_run_production_controls root build work expected_sha archive native_json fixture node)
  foreach(path IN ITEMS "${archive}" "${native_json}" "${fixture}" "${node}"
      "${build}/libretro/muhtari_libretro.mjs" "${build}/libretro/muhtari_libretro.wasm")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
      _muhtari_bundle_fail("production controls input is missing: ${path}")
    endif()
  endforeach()
  get_filename_component(archive_abs "${archive}" ABSOLUTE BASE_DIR "${root}")
  set(production_control_dir "${build}/tests/phase18-bundle-controls")
  file(MAKE_DIRECTORY "${production_control_dir}")
  _muhtari_bundle_expect_cli_success("${root}" "${build}" "${production_control_dir}/production-validate"
    "${expected_sha}" "${native_json}" "${fixture}" "${archive_abs}")
  set(production_extract "${production_control_dir}/production-validate/extract")
  _muhtari_bundle_members("${root}" members)

  set(notice_members
    licenses/emscripten/LICENSE
    licenses/emscripten/AUTHORS
    licenses/musl/COPYRIGHT
    licenses/compiler-rt/LICENSE.TXT
    licenses/compiler-rt/CREDITS.TXT)
  foreach(member IN LISTS notice_members)
    set(case_name "notice-${member}")
    string(REPLACE "/" "-" work_case "${case_name}")
    set(case_root "${work}/${case_name}")
    set(stage "${case_root}/stage")
    file(REMOVE_RECURSE "${case_root}")
    _muhtari_bundle_control_copy_members("${production_extract}" "${stage}" "${members}")
    file(APPEND "${stage}/${member}" "changed notice bytes\n")
    set(mutated_archive "${case_root}/package.zip")
    _muhtari_bundle_pack_control_archive("${stage}" "${mutated_archive}" "${members}")
    _muhtari_bundle_expect_cli_failure("${root}" "${build}" "${production_control_dir}/${work_case}-validate"
      "${expected_sha}" "${native_json}" "${fixture}" "${mutated_archive}"
      "runtime notice digest mismatch: ${member}")
  endforeach()

  foreach(companion IN ITEMS wasm source-id)
    set(case_root "${work}/consumer-missing-${companion}")
    set(damaged_cores "${case_root}/cores")
    file(REMOVE_RECURSE "${case_root}")
    file(MAKE_DIRECTORY "${damaged_cores}")
    file(COPY "${production_extract}/cores/" DESTINATION "${damaged_cores}")
    if(companion STREQUAL "wasm")
      file(REMOVE "${damaged_cores}/muhtari_libretro.wasm")
      set(expected_text "ENOENT")
    else()
      file(REMOVE "${damaged_cores}/muhtari-source-id.txt")
      set(expected_text "muhtari-source-id.txt")
    endif()
    _muhtari_bundle_expect_consumer_failure("${root}" "${node}" "${fixture}" "${native_json}"
      "${damaged_cores}/muhtari_libretro.mjs" "${expected_text}")
  endforeach()

  set(identity_case "${work}/production-independent-native")
  set(identity_stage "${identity_case}/stage")
  set(identity_build "${production_control_dir}/identity-build")
  file(REMOVE_RECURSE "${identity_case}")
  _muhtari_bundle_control_copy_members("${production_extract}" "${identity_stage}" "${members}")
  file(MAKE_DIRECTORY "${identity_build}/libretro")
  file(COPY "${build}/libretro/" DESTINATION "${identity_build}/libretro")
  string(REPEAT "d" 64 changed_source_id)
  file(WRITE "${identity_build}/libretro/muhtari-source-id.txt" "${changed_source_id}\n")
  file(WRITE "${identity_stage}/cores/muhtari-source-id.txt" "${changed_source_id}\n")
  _muhtari_bundle_control_metadata("${identity_stage}/muhtari-bundle.txt"
    "${expected_sha}" "${changed_source_id}" "${_muhtari_bundle_emcc}")
  set(identity_archive "${identity_case}/package.zip")
  _muhtari_bundle_pack_control_archive("${identity_stage}" "${identity_archive}" "${members}")
  _muhtari_bundle_expect_cli_failure("${root}" "${identity_build}"
    "${identity_build}/validate" "${expected_sha}" "${native_json}" "${fixture}"
    "${identity_archive}" "bundle source identity does not match the independent native receipt")

  if(NOT EXISTS "${build}/libretro/muhtari_libretro.mjs"
     OR NOT EXISTS "${build}/libretro/muhtari_libretro.wasm"
     OR NOT EXISTS "${build}/libretro/muhtari-source-id.txt")
    _muhtari_bundle_fail("missing-companion controls modified the intact build outputs")
  endif()
endfunction()

function(_muhtari_bundle_controls root work build expected_sha archive native_json fixture node)
  if("${root}" STREQUAL "" OR "${work}" STREQUAL "")
    _muhtari_bundle_fail("MODE=controls requires -DROOT and -DWORK")
  endif()
  get_filename_component(root_abs "${root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
  get_filename_component(work_abs "${work}" ABSOLUTE BASE_DIR "${root_abs}")
  set(allowed_parent "${root_abs}/build")
  cmake_path(IS_PREFIX allowed_parent "${work_abs}" NORMALIZE work_is_owned)
  if(NOT work_is_owned OR work_abs STREQUAL allowed_parent)
    _muhtari_bundle_fail("control WORK must be a dedicated directory under repository build/")
  endif()
  file(REMOVE_RECURSE "${work_abs}")
  file(MAKE_DIRECTORY "${work_abs}")
  _muhtari_bundle_run_synthetic_controls("${root_abs}" "${work_abs}")
  if("${build}" STREQUAL "" AND "${expected_sha}" STREQUAL ""
     AND "${archive}" STREQUAL "" AND "${native_json}" STREQUAL ""
     AND "${fixture}" STREQUAL "" AND "${node}" STREQUAL "")
    message(STATUS "emscripten.bundle.controls: synthetic contract controls passed")
    return()
  endif()
  foreach(required IN ITEMS build expected_sha archive native_json fixture node)
    if("${${required}}" STREQUAL "")
      _muhtari_bundle_fail("production controls require BUILD, EXPECTED_SHA, ARCHIVE, NATIVE, FIXTURE and NODE")
    endif()
  endforeach()
  get_filename_component(build_abs "${build}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(archive_abs "${archive}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(native_abs "${native_json}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(fixture_abs "${fixture}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(node_abs "${node}" ABSOLUTE BASE_DIR "${root_abs}")
  _muhtari_bundle_run_production_controls("${root_abs}" "${build_abs}" "${work_abs}"
    "${expected_sha}" "${archive_abs}" "${native_abs}" "${fixture_abs}" "${node_abs}")
  message(STATUS "emscripten.bundle.controls: production package controls passed")
endfunction()

if(DEFINED CMAKE_SCRIPT_MODE_FILE AND NOT CMAKE_SCRIPT_MODE_FILE STREQUAL "")
  get_filename_component(_muhtari_bundle_self "${CMAKE_CURRENT_LIST_FILE}" REALPATH)
  get_filename_component(_muhtari_bundle_script "${CMAKE_SCRIPT_MODE_FILE}" REALPATH)
else()
  set(_muhtari_bundle_self "")
  set(_muhtari_bundle_script "")
endif()
if(NOT _muhtari_bundle_self STREQUAL "" AND _muhtari_bundle_self STREQUAL _muhtari_bundle_script)
  if(NOT DEFINED MODE OR MODE STREQUAL "")
    _muhtari_bundle_fail("-DMODE=create|validate|licenses is required")
  endif()
  if(MODE STREQUAL "controls")
    _muhtari_bundle_controls("${ROOT}" "${WORK}" "${BUILD}" "${EXPECTED_SHA}"
      "${ARCHIVE}" "${NATIVE}" "${FIXTURE}" "${NODE}")
  elseif(MODE STREQUAL "licenses")
    _muhtari_bundle_normalize("${ROOT}" "${BUILD}" "${WORK}"
      root_abs build_abs work_abs)
    muhtari_bundle_qualified_notice_digests(notice_digests)
    _muhtari_bundle_check_sdk_notices("${SDK_ROOT}" "${notice_digests}")
    message(STATUS "emscripten.bundle: all five pinned SDK notice digests match")
  elseif(MODE STREQUAL "create" OR MODE STREQUAL "validate")
    _muhtari_bundle_normalize("${ROOT}" "${BUILD}" "${WORK}"
      root_abs build_abs work_abs)
    foreach(required IN ITEMS EXPECTED_SHA NATIVE FIXTURE)
      if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        _muhtari_bundle_fail("-D${required} is required for ${MODE}")
      endif()
    endforeach()
    muhtari_bundle_qualified_notice_digests(notice_digests)
    if(MODE STREQUAL "create")
      foreach(required IN ITEMS SDK_ROOT NODE)
        if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
          _muhtari_bundle_fail("-D${required} is required for create")
        endif()
      endforeach()
      _muhtari_bundle_create("${root_abs}" "${build_abs}" "${work_abs}"
        "${EXPECTED_SHA}" "${notice_digests}" "${SDK_ROOT}" "${NATIVE}" "${FIXTURE}" "${NODE}")
    else()
      if(NOT DEFINED ARCHIVE OR ARCHIVE STREQUAL "")
        _muhtari_bundle_fail("-DARCHIVE is required for validate")
      endif()
      get_filename_component(archive_abs "${ARCHIVE}" ABSOLUTE BASE_DIR "${root_abs}")
      muhtari_bundle_validate("${archive_abs}" "${root_abs}" "${build_abs}" "${work_abs}"
        "${EXPECTED_SHA}" "${notice_digests}" "${NATIVE}")
      if(DEFINED NODE AND NOT NODE STREQUAL "")
        muhtari_bundle_verify_consumer("${root_abs}" "${work_abs}/extract"
          "${NATIVE}" "${FIXTURE}" "${NODE}")
      endif()
      message(STATUS "emscripten.bundle: validated ${archive_abs}")
    endif()
  else()
    _muhtari_bundle_fail("unsupported MODE=${MODE}")
  endif()
endif()
