# Source-bound Emscripten archive creation and validation. Including this file
# defines helpers only; direct -P execution is the sole dispatch path.

set(_muhtari_bundle_image
  "emscripten/emsdk@sha256:6bd7aef93408b10bf7b36642cb7c91119b302f720b9ec2d20439f73cf07fe894")
set(_muhtari_bundle_leaf
  "sha256:3803e37bf748ddee14d31cf712fcab09ca367fca83bbefeb78ce4c1f284e6f3f")
set(_muhtari_bundle_platform "linux/amd64")
set(_muhtari_bundle_emcc "7.0.0 (777e6e5db7b4990bcaeb1b9998ed642cc84e6629)")

function(muhtari_bundle_qualified_notice_digests output)
  set(qualified
    "licenses/emscripten/LICENSE=620a78084fc7ca97c0b5dea9abf891f3ffcadfdbf305276f099c9c4e12fc1d86"
    "licenses/emscripten/AUTHORS=3fb38cc87b2b57a2a1aae3ad2e984c3bc23cf7441d20e6897739fbc3f96414c4"
    "licenses/musl/COPYRIGHT=b870108ec5e7790e9f9919064f1b9421d62d5f9b0e6c230c6adf7ea2da62e97b"
    "licenses/compiler-rt/LICENSE.TXT=1a8f1058753f1ba890de984e48f0242a3a5c29a6a8f2ed9fd813f36985387e8d"
    "licenses/compiler-rt/CREDITS.TXT=a9901f47a089da41e4690682d00ce4cedaa2baf41fedbe79beee366d43ac2461")
  set(${output} "${qualified}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_fail text)
  message(FATAL_ERROR "emscripten.bundle: ${text}")
endfunction()

function(_muhtari_bundle_normalize root build work root_out build_out work_out)
  if("${root}" STREQUAL "" OR "${build}" STREQUAL "" OR "${work}" STREQUAL "")
    _muhtari_bundle_fail("-DROOT, -DBUILD and -DWORK are required")
  endif()
  get_filename_component(root_abs "${root}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
  get_filename_component(build_abs "${build}" ABSOLUTE BASE_DIR "${root_abs}")
  get_filename_component(work_abs "${work}" ABSOLUTE BASE_DIR "${root_abs}")
  if(NOT IS_DIRECTORY "${root_abs}")
    _muhtari_bundle_fail("repository root is not a directory: ${root_abs}")
  endif()
  set(build_parent "${build_abs}")
  cmake_path(IS_PREFIX build_parent "${work_abs}" NORMALIZE work_below_build)
  if(NOT work_below_build OR work_abs STREQUAL build_abs)
    _muhtari_bundle_fail("WORK must be a dedicated child of BUILD")
  endif()
  set(${root_out} "${root_abs}" PARENT_SCOPE)
  set(${build_out} "${build_abs}" PARENT_SCOPE)
  set(${work_out} "${work_abs}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_members root output)
  set(manifest "${root}/tests/emscripten/bundle-members.txt")
  if(NOT EXISTS "${manifest}" OR IS_DIRECTORY "${manifest}")
    _muhtari_bundle_fail("member manifest is missing: ${manifest}")
  endif()
  file(STRINGS "${manifest}" members)
  set(sorted ${members})
  list(SORT sorted)
  list(LENGTH members member_count)
  if(NOT member_count EQUAL 14 OR NOT members STREQUAL sorted)
    _muhtari_bundle_fail("member manifest must contain exactly fourteen sorted paths (count=${member_count}; listed=${members}; sorted=${sorted})")
  endif()
  foreach(member IN LISTS members)
    if(NOT member MATCHES "^[A-Za-z0-9._/-]+$"
       OR member MATCHES "(^/|^[A-Za-z]:|(^|/)\.\.?(/|$)|\\\\)")
      _muhtari_bundle_fail("unsafe path in member manifest: ${member}")
    endif()
  endforeach()
  set(${output} "${members}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_notice_source member sdk_root output)
  if(member STREQUAL "licenses/emscripten/LICENSE")
    set(path "${sdk_root}/LICENSE")
  elseif(member STREQUAL "licenses/emscripten/AUTHORS")
    set(path "${sdk_root}/AUTHORS")
  elseif(member STREQUAL "licenses/musl/COPYRIGHT")
    set(path "${sdk_root}/system/lib/libc/musl/COPYRIGHT")
  elseif(member STREQUAL "licenses/compiler-rt/LICENSE.TXT")
    set(path "${sdk_root}/system/lib/compiler-rt/LICENSE.TXT")
  elseif(member STREQUAL "licenses/compiler-rt/CREDITS.TXT")
    set(path "${sdk_root}/system/lib/compiler-rt/CREDITS.TXT")
  else()
    _muhtari_bundle_fail("unqualified SDK notice member: ${member}")
  endif()
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_check_sdk_notices sdk_root notice_digests)
  get_filename_component(sdk_abs "${sdk_root}" ABSOLUTE)
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    if(separator LESS 1)
      _muhtari_bundle_fail("invalid qualified notice table entry")
    endif()
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    _muhtari_bundle_notice_source("${member}" "${sdk_abs}" source)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
      _muhtari_bundle_fail("qualified SDK notice is missing: ${source}")
    endif()
    file(SIZE "${source}" size)
    if(size LESS 1)
      _muhtari_bundle_fail("qualified SDK notice is empty: ${source}")
    endif()
    file(SHA256 "${source}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("qualified SDK notice digest changed: ${member}")
    endif()
  endforeach()
endfunction()

function(_muhtari_bundle_require_file path description)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
    _muhtari_bundle_fail("${description} is missing or not a regular file: ${path}")
  endif()
  file(SIZE "${path}" size)
  if(size LESS 1)
    _muhtari_bundle_fail("${description} is empty: ${path}")
  endif()
endfunction()

function(_muhtari_bundle_hash_equal left right description)
  _muhtari_bundle_require_file("${left}" "${description} source")
  _muhtari_bundle_require_file("${right}" "${description} archive member")
  file(SHA256 "${left}" left_hash)
  file(SHA256 "${right}" right_hash)
  if(NOT left_hash STREQUAL right_hash)
    _muhtari_bundle_fail("${description} differs from the current source")
  endif()
endfunction()

function(_muhtari_bundle_metadata path expected_sha metadata_source native_json)
  file(STRINGS "${path}" lines)
  set(expected_keys schema commit core_source_sha256 sdk_image sdk_leaf_sha256 sdk_platform emcc)
  set(seen_keys)
  foreach(line IN LISTS lines)
    if(NOT "${line}" MATCHES "^([a-z0-9_]+)=(.+)$")
      _muhtari_bundle_fail("malformed manifest value in muhtari-bundle.txt: ${line}")
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    if(line MATCHES ";")
      _muhtari_bundle_fail("malformed manifest value in muhtari-bundle.txt: ${line}")
    endif()
    if(NOT key IN_LIST expected_keys)
      _muhtari_bundle_fail("unknown manifest key: ${key}")
    endif()
    if(key IN_LIST seen_keys)
      _muhtari_bundle_fail("repeated manifest key: ${key}")
    endif()
    list(APPEND seen_keys "${key}")
    set(meta_${key} "${value}")
  endforeach()
  list(LENGTH seen_keys key_count)
  if(NOT key_count EQUAL 7)
    _muhtari_bundle_fail("muhtari-bundle.txt must contain each of seven keys exactly once")
  endif()
  foreach(key IN LISTS expected_keys)
    if(NOT key IN_LIST seen_keys)
      _muhtari_bundle_fail("missing manifest key: ${key}")
    endif()
  endforeach()
  if(NOT meta_schema STREQUAL "1")
    _muhtari_bundle_fail("unsupported bundle schema")
  endif()
  string(LENGTH "${expected_sha}" commit_length)
  if(NOT commit_length EQUAL 40 OR NOT expected_sha MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("EXPECTED_SHA must be the full lowercase checkout commit")
  endif()
  if(NOT meta_commit STREQUAL expected_sha)
    _muhtari_bundle_fail("bundle commit does not match EXPECTED_SHA")
  endif()
  if(NOT meta_sdk_image STREQUAL _muhtari_bundle_image
     OR NOT meta_sdk_leaf_sha256 STREQUAL _muhtari_bundle_leaf
     OR NOT meta_sdk_platform STREQUAL _muhtari_bundle_platform
     OR NOT meta_emcc STREQUAL _muhtari_bundle_emcc)
    _muhtari_bundle_fail("bundle SDK identity does not match the pinned producer")
  endif()
  string(LENGTH "${meta_core_source_sha256}" source_length)
  if(NOT source_length EQUAL 64 OR NOT meta_core_source_sha256 MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("core_source_sha256 is malformed")
  endif()
  _muhtari_bundle_require_file("${metadata_source}" "current source identity")
  file(STRINGS "${metadata_source}" source_lines)
  list(LENGTH source_lines source_line_count)
  if(NOT source_line_count EQUAL 1)
    _muhtari_bundle_fail("current source identity must be one line")
  endif()
  list(GET source_lines 0 source_id)
  if(NOT source_id STREQUAL meta_core_source_sha256)
    _muhtari_bundle_fail("bundle source identity does not match the built sidecar")
  endif()
  if(NOT EXISTS "${native_json}" OR IS_DIRECTORY "${native_json}")
    _muhtari_bundle_fail("independent native observer receipt is missing")
  endif()
  file(READ "${native_json}" native_text)
  string(JSON native_source ERROR_VARIABLE native_json_error GET "${native_text}" source_identity)
  if(NOT native_json_error STREQUAL "NOTFOUND")
    _muhtari_bundle_fail("independent native receipt has no source_identity")
  endif()
  if(NOT native_source STREQUAL meta_core_source_sha256)
    _muhtari_bundle_fail("bundle source identity does not match the independent native receipt")
  endif()
  set(MUHTARI_BUNDLE_SOURCE_ID "${meta_core_source_sha256}" PARENT_SCOPE)
endfunction()

function(_muhtari_bundle_pair_sums path output_paths output_hashes)
  file(STRINGS "${path}" lines)
  list(LENGTH lines line_count)
  if(NOT line_count EQUAL 2)
    _muhtari_bundle_fail("SHA256SUMS must contain exactly two loader/Wasm entries")
  endif()
  set(expected_paths cores/muhtari_libretro.mjs cores/muhtari_libretro.wasm)
  set(paths)
  set(hashes)
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([0-9a-f]+)  ([A-Za-z0-9._/-]+)$")
      _muhtari_bundle_fail("malformed SHA256SUMS entry")
    endif()
    set(hash "${CMAKE_MATCH_1}")
    set(path_name "${CMAKE_MATCH_2}")
    string(LENGTH "${hash}" hash_length)
    if(NOT hash_length EQUAL 64)
      _muhtari_bundle_fail("SHA256SUMS digest must be 64 lowercase hex digits")
    endif()
    list(APPEND paths "${path_name}")
    list(APPEND hashes "${hash}")
  endforeach()
  if(NOT paths STREQUAL expected_paths)
    _muhtari_bundle_fail("SHA256SUMS paths must be the two sorted loader/Wasm members")
  endif()
  set(${output_paths} "${paths}" PARENT_SCOPE)
  set(${output_hashes} "${hashes}" PARENT_SCOPE)
endfunction()

function(muhtari_bundle_validate archive root build work expected_sha notice_digests native_json)
  _muhtari_bundle_members("${root}" expected_members)
  _muhtari_bundle_require_file("${archive}" "bundle archive")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${archive}"
    RESULT_VARIABLE list_rc OUTPUT_VARIABLE list_output ERROR_VARIABLE list_error)
  if(NOT list_rc STREQUAL "0")
    _muhtari_bundle_fail("cannot list archive members: ${list_error}")
  endif()
  string(REPLACE "\r\n" "\n" list_output "${list_output}")
  string(REGEX REPLACE "\n+$" "" list_output "${list_output}")
  if(list_output STREQUAL "")
    _muhtari_bundle_fail("archive has no members")
  endif()
  string(REPLACE "\n" ";" actual_members "${list_output}")
  foreach(member IN LISTS actual_members)
    if(NOT member MATCHES "^[A-Za-z0-9._/-]+$"
       OR member MATCHES "(^/|^[A-Za-z]:|(^|/)\.\.?(/|$)|\\\\)")
      _muhtari_bundle_fail("unsafe archive member path: ${member}")
    endif()
  endforeach()
  set(unique_members ${actual_members})
  list(REMOVE_DUPLICATES unique_members)
  list(LENGTH actual_members actual_count)
  list(LENGTH unique_members unique_count)
  if(NOT actual_count EQUAL unique_count)
    _muhtari_bundle_fail("archive contains duplicate members")
  endif()
  set(sorted_actual ${actual_members})
  list(SORT sorted_actual)
  if(NOT sorted_actual STREQUAL expected_members)
    _muhtari_bundle_fail("archive member set differs from bundle-members.txt")
  endif()

  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tvf "${archive}"
    RESULT_VARIABLE detail_rc OUTPUT_VARIABLE detail_output ERROR_VARIABLE detail_error)
  if(NOT detail_rc STREQUAL "0")
    _muhtari_bundle_fail("cannot inspect archive member types: ${detail_error}")
  endif()
  string(REPLACE "\r\n" "\n" detail_output "${detail_output}")
  string(REGEX REPLACE "\n+$" "" detail_output "${detail_output}")
  string(REPLACE "\n" ";" detail_lines "${detail_output}")
  foreach(line IN LISTS detail_lines)
    string(REGEX MATCH "^([^ ]+)" mode "${line}")
    if(NOT mode MATCHES "^-[-rwxStT]+$")
      _muhtari_bundle_fail("archive member is not a regular file: ${line}")
    endif()
  endforeach()

  set(extract "${work}/extract")
  file(REMOVE_RECURSE "${extract}")
  file(MAKE_DIRECTORY "${extract}")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extract}")
  file(GLOB_RECURSE extracted_members LIST_DIRECTORIES false RELATIVE "${extract}" "${extract}/*")
  set(sorted_extracted ${extracted_members})
  list(SORT sorted_extracted)
  if(NOT sorted_extracted STREQUAL expected_members)
    _muhtari_bundle_fail("clean extraction does not contain the exact manifest member set")
  endif()
  foreach(member IN LISTS expected_members)
    _muhtari_bundle_require_file("${extract}/${member}" "archive member ${member}")
  endforeach()

  _muhtari_bundle_metadata("${extract}/muhtari-bundle.txt" "${expected_sha}"
    "${build}/libretro/muhtari-source-id.txt" "${native_json}")
  foreach(member IN ITEMS LICENSE THIRD-PARTY-NOTICES.md HOSTING.md info/muhtari_libretro.info)
    if(member STREQUAL "LICENSE")
      set(source "${root}/LICENSE")
    elseif(member STREQUAL "THIRD-PARTY-NOTICES.md")
      set(source "${root}/THIRD-PARTY-NOTICES.md")
    elseif(member STREQUAL "HOSTING.md")
      set(source "${root}/docs/emscripten-hosting.md")
    else()
      set(source "${build}/libretro/muhtari_libretro.info")
    endif()
    _muhtari_bundle_hash_equal("${source}" "${extract}/${member}" "${member}")
  endforeach()

  list(LENGTH notice_digests notice_count)
  if(NOT notice_count EQUAL 5)
    _muhtari_bundle_fail("notice digest table must contain the five qualified runtime texts")
  endif()
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    if(separator LESS 1)
      _muhtari_bundle_fail("invalid notice digest table entry")
    endif()
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    if(NOT member IN_LIST expected_members)
      _muhtari_bundle_fail("notice digest names a non-member: ${member}")
    endif()
    file(SHA256 "${extract}/${member}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("qualified runtime notice digest mismatch: ${member}")
    endif()
  endforeach()

  _muhtari_bundle_pair_sums("${extract}/SHA256SUMS" pair_paths pair_hashes)
  foreach(index RANGE 0 1)
    list(GET pair_paths ${index} member)
    list(GET pair_hashes ${index} expected)
    file(SHA256 "${extract}/${member}" actual)
    if(NOT actual STREQUAL expected)
      _muhtari_bundle_fail("SHA256SUMS mismatch for ${member}")
    endif()
    string(REPLACE "cores/" "" build_member "${member}")
    _muhtari_bundle_hash_equal("${build}/libretro/${build_member}" "${extract}/${member}" "${member}")
  endforeach()
  set(MUHTARI_BUNDLE_EXTRACTED "${extract}" PARENT_SCOPE)
endfunction()

function(muhtari_bundle_verify_consumer root extracted native_json fixture node)
  foreach(required IN ITEMS "${native_json}" "${fixture}" "${node}")
    if("${required}" STREQUAL "")
      _muhtari_bundle_fail("NODE, native receipt and fixture are required for extracted consumer verification")
    endif()
  endforeach()
  _muhtari_bundle_require_file("${native_json}" "independent native observer receipt")
  _muhtari_bundle_require_file("${fixture}" "native observer fixture")
  _muhtari_bundle_require_file("${node}" "pinned Node executable")
  execute_process(COMMAND "${node}" "${root}/tests/emscripten/host.mjs"
    --module "${extracted}/cores/muhtari_libretro.mjs"
    --fixture "${fixture}" --native "${native_json}" --mode verify
    RESULT_VARIABLE consumer_rc OUTPUT_VARIABLE consumer_out ERROR_VARIABLE consumer_err
    WORKING_DIRECTORY "${root}")
  if(NOT consumer_rc STREQUAL "0")
    _muhtari_bundle_fail("clean-extracted Node/native consumer failed (${consumer_rc}): ${consumer_out}${consumer_err}")
  endif()
  message(STATUS "emscripten.bundle: clean-extracted Node/native consumer passed")
endfunction()

function(_muhtari_bundle_create root build work expected_sha notice_digests sdk_root native_json fixture node)
  string(LENGTH "${expected_sha}" commit_length)
  if(NOT commit_length EQUAL 40 OR NOT expected_sha MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("EXPECTED_SHA must be the full lowercase checkout commit")
  endif()
  _muhtari_bundle_check_sdk_notices("${sdk_root}" "${notice_digests}")
  set(libretro "${build}/libretro")
  foreach(path IN ITEMS
      "${libretro}/muhtari_libretro.mjs" "${libretro}/muhtari_libretro.wasm"
      "${libretro}/muhtari-source-id.txt" "${libretro}/muhtari_libretro.info")
    _muhtari_bundle_require_file("${path}" "built Emscripten input")
  endforeach()

  file(REMOVE_RECURSE "${work}")
  set(stage "${work}/stage")
  file(MAKE_DIRECTORY "${stage}/cores" "${stage}/info"
    "${stage}/licenses/emscripten" "${stage}/licenses/musl" "${stage}/licenses/compiler-rt")
  file(COPY_FILE "${root}/LICENSE" "${stage}/LICENSE")
  file(COPY_FILE "${root}/THIRD-PARTY-NOTICES.md" "${stage}/THIRD-PARTY-NOTICES.md")
  file(COPY_FILE "${root}/docs/emscripten-hosting.md" "${stage}/HOSTING.md")
  file(COPY_FILE "${libretro}/muhtari_libretro.mjs" "${stage}/cores/muhtari_libretro.mjs")
  file(COPY_FILE "${libretro}/muhtari_libretro.wasm" "${stage}/cores/muhtari_libretro.wasm")
  file(COPY_FILE "${libretro}/muhtari-source-id.txt" "${stage}/cores/muhtari-source-id.txt")
  file(COPY_FILE "${libretro}/muhtari_libretro.info" "${stage}/info/muhtari_libretro.info")
  foreach(record IN LISTS notice_digests)
    string(FIND "${record}" "=" separator)
    string(SUBSTRING "${record}" 0 ${separator} member)
    math(EXPR digest_start "${separator} + 1")
    string(SUBSTRING "${record}" ${digest_start} -1 expected)
    _muhtari_bundle_notice_source("${member}" "${sdk_root}" source)
    file(COPY_FILE "${source}" "${stage}/${member}")
    file(SHA256 "${stage}/${member}" copied_hash)
    if(NOT copied_hash STREQUAL expected)
      _muhtari_bundle_fail("copied SDK notice failed its qualified digest: ${member}")
    endif()
  endforeach()
  file(STRINGS "${libretro}/muhtari-source-id.txt" source_lines)
  list(LENGTH source_lines source_line_count)
  if(NOT source_line_count EQUAL 1 OR NOT source_lines MATCHES "^[0-9a-f]+$")
    _muhtari_bundle_fail("built source identity is malformed")
  endif()
  list(GET source_lines 0 source_id)
  file(WRITE "${stage}/muhtari-bundle.txt"
    "schema=1\ncommit=${expected_sha}\ncore_source_sha256=${source_id}\n"
    "sdk_image=${_muhtari_bundle_image}\nsdk_leaf_sha256=${_muhtari_bundle_leaf}\n"
    "sdk_platform=${_muhtari_bundle_platform}\nemcc=${_muhtari_bundle_emcc}\n")
  set(pair_paths cores/muhtari_libretro.mjs cores/muhtari_libretro.wasm)
  foreach(member IN LISTS pair_paths)
    file(SHA256 "${stage}/${member}" pair_hash)
    file(APPEND "${stage}/SHA256SUMS" "${pair_hash}  ${member}\n")
  endforeach()

  _muhtari_bundle_members("${root}" members)
  set(archive "${build}/muhtari-libretro-emscripten.zip")
  file(REMOVE "${archive}")
  file(ARCHIVE_CREATE OUTPUT "${archive}" PATHS ${members}
    FORMAT zip WORKING_DIRECTORY "${stage}")
  muhtari_bundle_validate("${archive}" "${root}" "${build}" "${work}"
    "${expected_sha}" "${notice_digests}" "${native_json}")
  muhtari_bundle_verify_consumer("${root}" "${work}/extract" "${native_json}" "${fixture}" "${node}")
  message(STATUS "emscripten.bundle: created ${archive}")
endfunction()

get_filename_component(_muhtari_bundle_self "${CMAKE_CURRENT_LIST_FILE}" REALPATH)
get_filename_component(_muhtari_bundle_script "${CMAKE_SCRIPT_MODE_FILE}" REALPATH)
if(_muhtari_bundle_self STREQUAL _muhtari_bundle_script)
  if(NOT DEFINED MODE OR MODE STREQUAL "")
    _muhtari_bundle_fail("-DMODE=create|validate|licenses is required")
  endif()
  _muhtari_bundle_normalize("${ROOT}" "${BUILD}" "${WORK}"
    root_abs build_abs work_abs)
  if(MODE STREQUAL "licenses")
    muhtari_bundle_qualified_notice_digests(notice_digests)
    _muhtari_bundle_check_sdk_notices("${SDK_ROOT}" "${notice_digests}")
    message(STATUS "emscripten.bundle: all five pinned SDK notice digests match")
  elseif(MODE STREQUAL "create" OR MODE STREQUAL "validate")
    foreach(required IN ITEMS EXPECTED_SHA NATIVE FIXTURE)
      if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        _muhtari_bundle_fail("-D${required} is required for ${MODE}")
      endif()
    endforeach()
    muhtari_bundle_qualified_notice_digests(notice_digests)
    if(MODE STREQUAL "create")
      foreach(required IN ITEMS SDK_ROOT NODE)
        if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
          _muhtari_bundle_fail("-D${required} is required for create")
        endif()
      endforeach()
      _muhtari_bundle_create("${root_abs}" "${build_abs}" "${work_abs}"
        "${EXPECTED_SHA}" "${notice_digests}" "${SDK_ROOT}" "${NATIVE}" "${FIXTURE}" "${NODE}")
    else()
      if(NOT DEFINED ARCHIVE OR ARCHIVE STREQUAL "")
        _muhtari_bundle_fail("-DARCHIVE is required for validate")
      endif()
      get_filename_component(archive_abs "${ARCHIVE}" ABSOLUTE BASE_DIR "${root_abs}")
      muhtari_bundle_validate("${archive_abs}" "${root_abs}" "${build_abs}" "${work_abs}"
        "${EXPECTED_SHA}" "${notice_digests}" "${NATIVE}")
      if(DEFINED NODE AND NOT NODE STREQUAL "")
        muhtari_bundle_verify_consumer("${root_abs}" "${work_abs}/extract"
          "${NATIVE}" "${FIXTURE}" "${NODE}")
      endif()
      message(STATUS "emscripten.bundle: validated ${archive_abs}")
    endif()
  else()
    _muhtari_bundle_fail("unsupported MODE=${MODE}")
  endif()
endif()
