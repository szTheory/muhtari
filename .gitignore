# Game, BIOS and save images never enter this repository. Licensed test
# fixtures are the one exception: they live under tests/roms/ (and the assembled
# decimal mode test under tests/cpu/decimal/ and our own diagnostics under
# tests/diag/), each is listed in
# tests/roms/manifest.txt, and scripts/hygiene.sh rejects any image not listed.
*.a78
*.a26
*.bin
*.rom
*.sav
*.srm
*.state
*.hsc
*.eeprom
!/tests/roms/**
!/tests/cpu/decimal/*.bin
!/tests/diag/*.a78
/roms/
/bios/
/private/

# Local configuration and secrets: local values are passed inline on the command line, not kept in a dotenv file
.env
.env.*

# Build output
/build/
/out/
/CMakeUserPresets.json
compile_commands.json

# GSD and agent state that is local to one machine
/.planning/state.json
/.planning/milestone.lock
/.planning/research/.cache/
/.gsd/
/.claude/worktrees/
/.claude/settings.local.json

# OS noise
.DS_Store
