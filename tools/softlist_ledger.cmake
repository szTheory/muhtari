# Ledger rows for the pinned software list, run as
#   cmake -DXML=<a7800.xml> -DLEDGER=<ledger.csv> -DCARTDB=<src/cartdb.c> -DOUT=<file>
#     [-DCHECK=<committed ledger>] -P softlist_ledger.cmake
# Fault prevented: a ledger whose pinned-list rows are edited by hand, out of
# date with the pin, or claim a pass that only metadata supports. A row whose
# id has no "/" is this script's output for one <software> entry; a row whose
# id has one is owned and copied verbatim. With CHECK, the output must equal
# that file, a pinned-list row must be unknown, skipped or unsupported with no
# evidence, an entry added, removed or renamed by a pin bump is named, and
# the board, options, sound, light-gun and TV columns must agree with the same
# entry of src/cartdb.c, so the two slot tables cannot drift apart. An
# unknown slot or feature, or a description holding a character that would
# split a ledger field or a CMake list, stops the run naming the entry.
# Rows are sorted with the key tests/compat/pin.cmake sorts by (id, space,
# predicate), and a ";" in a field is held as <semicolon>, so running the pin
# recipe afterwards changes nothing. Multi-chip entries join their chip
# SHA-1s with "+" in XML order, which is the part order src/cartdb.c keys.
cmake_minimum_required(VERSION 3.25)

foreach(var XML LEDGER CARTDB OUT)
  if("${${var}}" STREQUAL "")
    message(FATAL_ERROR "softlist_ledger: -D${var} is required")
  endif()
endforeach()

# Slot value: board, peripherals, kind, then the numbers tools/cartdb.cmake
# gives it (board, board options, sound, not a cartridge) and
# src/cartdb.h's entry flags (NTSC 1, PAL 2, light gun 4, not a cartridge 8).
# Boards: linear 1, SuperGame 2, Activision 3, Absolute 4, Fractalus 5.
# Options bit 0: ROM at $4000. Sound bit 0: POKEY at $4000, bit 1: POKEY at
# $0450. Kind device is an expansion, not a cartridge.
set(slot_a78_rom linear - cart 1 0 0 0)
set(slot_a78_pokey linear pokey4000 cart 1 0 1 0)
set(slot_a78_sg supergame - cart 2 0 0 0)
set(slot_a78_sg_ram supergame+ram - cart 2 0 0 0)
set(slot_a78_sg9 supergame+rom_at_4000 - cart 2 1 0 0)
set(slot_a78_sg_pokey supergame pokey4000 cart 2 0 1 0)
set(slot_a78_p450_ta supergame+rom_at_4000 pokey450 cart 2 1 2 0)
set(slot_a78_act activision - cart 3 0 0 0)
set(slot_a78_abs absolute - cart 4 0 0 0)
set(slot_a78_mram fractalus - cart 5 0 0 0)
set(slot_a78_hsc - hsc device 0 0 0 1)
set(slot_a78_xboard - xboard device 0 0 0 1)
set(slot_a78_xm - xm device 0 0 0 1)

# The value of attribute NAME in TAG, or empty.
function(softlist_attr tag name var)
  if(tag MATCHES " ${name}=\"([^\"]*)\"")
    set(${var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  else()
    set(${var} "" PARENT_SCOPE)
  endif()
endfunction()

# Stops when the description holds the character CH.
function(softlist_forbid entry desc ch)
  string(FIND "${desc}" "${ch}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "softlist_ledger: ${entry}: description holds '${ch}'")
  endif()
endfunction()

# Stops when GOT and WANT differ, naming the entry and the column.
function(softlist_same entry column got want)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "softlist_ledger: ${entry}: ${column} is ${got} in ${CARTDB} "
      "and ${want} in the list")
  endif()
endfunction()

# The ledger's fields hold no comma, quote or newline; a ";" is held as a
# placeholder, as tests/compat/pin.cmake does.
function(softlist_rows file var)
  file(READ "${file}" text)
  string(REPLACE ";" "<semicolon>" text "${text}")
  string(REGEX REPLACE "\n$" "" text "${text}")
  string(REPLACE "\n" ";" lines "${text}")
  list(POP_FRONT lines header)
  set(${var} "${lines}" PARENT_SCOPE)
  set(${var}_header "${header}" PARENT_SCOPE)
endfunction()

softlist_rows("${LEDGER}" ledger_lines)
set(rows "")
foreach(line IN LISTS ledger_lines)
  string(REPLACE "," ";" f "${line}")
  list(LENGTH f n)
  list(GET f 0 id)
  if(NOT n EQUAL 16)
    message(FATAL_ERROR "softlist_ledger: ${id}: ${n} fields, not 16")
  endif()
  if(id MATCHES "/")
    list(GET f 9 predicate)
    list(APPEND rows "${id} ${predicate}\t${line}")
  endif()
endforeach()

file(READ "${XML}" xml)
string(REGEX MATCHALL "<software " listed "${xml}")
list(LENGTH listed entry_count)
if(entry_count EQUAL 0)
  message(FATAL_ERROR "softlist_ledger: ${XML} has no <software> entry")
endif()

file(READ "${CARTDB}" cartdb_text)
string(REGEX MATCHALL "\n[{][0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+, [0-9]+}," cart_entries
  "${cartdb_text}")
list(LENGTH cart_entries cart_count)
if(NOT cart_count EQUAL entry_count)
  message(FATAL_ERROR "softlist_ledger: ${CARTDB} has ${cart_count} entries, the list has "
    "${entry_count}")
endif()

# One block per <software> entry, cut without list splitting so a stray ";"
# in the XML is still seen.
string(FIND "${xml}" "<software " at)
string(SUBSTRING "${xml}" ${at} -1 rest)
set(ids "")
set(entry 0)
while(NOT "${rest}" STREQUAL "")
  string(SUBSTRING "${rest}" 1 -1 tail)
  string(FIND "${tail}" "<software " next)
  if(next EQUAL -1)
    set(block "${rest}")
    set(rest "")
  else()
    math(EXPR next "${next} + 1")
    string(SUBSTRING "${rest}" 0 ${next} block)
    string(SUBSTRING "${rest}" ${next} -1 rest)
  endif()

  string(REGEX MATCH "^<software [^>]*>" software "${block}")
  softlist_attr("${software}" name id)
  if(NOT id MATCHES "^[a-z0-9_]+$")
    message(FATAL_ERROR "softlist_ledger: entry ${entry}: name '${id}' is not a short name")
  endif()
  list(FIND ids "${id}" seen)
  if(NOT seen EQUAL -1)
    message(FATAL_ERROR "softlist_ledger: ${id}: two entries share this name")
  endif()
  list(APPEND ids "${id}")

  if(NOT block MATCHES "<description>([^<]*)</description>")
    message(FATAL_ERROR "softlist_ledger: ${id}: no description")
  endif()
  set(desc "${CMAKE_MATCH_1}")
  string(STRIP "${desc}" desc)
  if(desc STREQUAL "")
    message(FATAL_ERROR "softlist_ledger: ${id}: empty description")
  endif()
  foreach(ch IN ITEMS "&" "\"" "@" "[" "]" "|" "\\")
    softlist_forbid("${id}" "${desc}" "${ch}")
  endforeach()
  softlist_forbid("${id}" "${desc}" ";")
  string(REGEX MATCH "[^ -~]" odd "${desc}")
  if(NOT odd STREQUAL "")
    message(FATAL_ERROR "softlist_ledger: ${id}: description holds a byte outside printable ASCII")
  endif()
  string(REPLACE "," " / " title "${desc}")

  # Features: one slot, and optionally the light gun.
  string(REGEX MATCHALL "<feature [^>]*>" features "${block}")
  set(slot "")
  set(gun 0)
  foreach(tag IN LISTS features)
    softlist_attr("${tag}" name name)
    softlist_attr("${tag}" value value)
    if(name STREQUAL "slot" AND slot STREQUAL "")
      if(NOT DEFINED slot_${value})
        message(FATAL_ERROR "softlist_ledger: ${id}: unknown slot '${value}'")
      endif()
      set(slot ${value})
    elseif(name STREQUAL "peripheral" AND value STREQUAL "lightgun")
      set(gun 1)
    else()
      message(FATAL_ERROR "softlist_ledger: ${id}: unknown feature ${name}='${value}'")
    endif()
  endforeach()
  if(slot STREQUAL "")
    message(FATAL_ERROR "softlist_ledger: ${id}: no slot feature")
  endif()
  list(GET slot_${slot} 0 board)
  list(GET slot_${slot} 1 peripherals)
  list(GET slot_${slot} 2 kind)
  list(GET slot_${slot} 3 want_board)
  list(GET slot_${slot} 4 want_options)
  list(GET slot_${slot} 5 want_sound)
  list(GET slot_${slot} 6 want_device)
  if(gun)
    if(peripherals STREQUAL "-")
      set(peripherals lightgun)
    else()
      set(peripherals "${peripherals}+lightgun")
    endif()
  endif()

  # TV systems: one tag, or both, or none, which the ledger calls any.
  string(REGEX MATCHALL "<sharedfeat [^>]*>" shared "${block}")
  set(tv 0)
  foreach(tag IN LISTS shared)
    softlist_attr("${tag}" name name)
    softlist_attr("${tag}" value value)
    if(NOT name STREQUAL "compatibility")
      message(FATAL_ERROR "softlist_ledger: ${id}: unknown shared feature '${name}'")
    endif()
    string(REPLACE "," ";" systems "${value}")
    foreach(system IN LISTS systems)
      if(system STREQUAL "NTSC")
        math(EXPR tv "${tv} | 1")
      elseif(system STREQUAL "PAL")
        math(EXPR tv "${tv} | 2")
      else()
        message(FATAL_ERROR "softlist_ledger: ${id}: unknown compatibility '${system}'")
      endif()
    endforeach()
  endforeach()
  if(tv EQUAL 1)
    set(region NTSC)
  elseif(tv EQUAL 2)
    set(region PAL)
  else()
    set(region any)
  endif()

  # Chip SHA-1s in XML order.
  string(REGEX MATCHALL "<rom [^>]*>" roms "${block}")
  set(sha1s "")
  foreach(tag IN LISTS roms)
    softlist_attr("${tag}" sha1 sha1)
    if(sha1 STREQUAL "")
      continue()
    endif()
    string(LENGTH "${sha1}" sha1_len)
    if(NOT sha1_len EQUAL 40 OR NOT sha1 MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "softlist_ledger: ${id}: '${sha1}' is not a SHA-1")
    endif()
    list(APPEND sha1s ${sha1})
  endforeach()
  if(sha1s)
    list(JOIN sha1s "+" sha1_raw)
  else()
    set(sha1_raw -)
  endif()

  # The entry's line in src/cartdb.c: ram_kib, board, options, sound, flags.
  list(GET cart_entries ${entry} cart_line)
  string(REGEX MATCHALL "[0-9]+" cart_nums "${cart_line}")
  list(GET cart_nums 1 got_board)
  list(GET cart_nums 2 got_options)
  list(GET cart_nums 3 got_sound)
  list(GET cart_nums 4 got_flags)
  softlist_same("${id}" board "${got_board}" "${want_board}")
  softlist_same("${id}" options "${got_options}" "${want_options}")
  softlist_same("${id}" sound "${got_sound}" "${want_sound}")
  math(EXPR got "(${got_flags} >> 3) & 1")
  softlist_same("${id}" "not-a-cartridge flag" "${got}" "${want_device}")
  math(EXPR got "(${got_flags} >> 2) & 1")
  softlist_same("${id}" "light-gun flag" "${got}" "${gun}")
  math(EXPR got "${got_flags} & 3")
  if(tv EQUAL 3)
    set(tv 0)
  endif()
  if(got EQUAL 3)
    set(got 0)
  endif()
  softlist_same("${id}" "TV flags" "${got}" "${tv}")

  if(kind STREQUAL "device")
    set(predicate "boots@120<semicolon>why=expansion-device")
    set(status skipped)
  else()
    set(predicate "boots@120")
    set(status unknown)
  endif()
  set(row "${id},${title},${sha1_raw},-,-,-,${board},${region},${peripherals},${predicate},${status},local,-,-,-,-")
  list(APPEND rows "${id} ${predicate}\t${row}")
  math(EXPR entry "${entry} + 1")
endwhile()
if(NOT entry EQUAL entry_count)
  message(FATAL_ERROR "softlist_ledger: ${entry} blocks were cut for ${entry_count} entries")
endif()

# A space sorts before every character of an id, so "a b" precedes "ab".
list(SORT rows)
list(TRANSFORM rows REPLACE "^[^\t]*\t" "")
list(JOIN rows "\n" text)
string(REPLACE "<semicolon>" ";" text "${ledger_lines_header}\n${text}\n")
file(WRITE "${OUT}" "${text}")

if(NOT DEFINED CHECK)
  message(STATUS "softlist_ledger: wrote ${entry_count} pinned-list rows to ${OUT}")
  return()
endif()

# A pinned-list row of the committed ledger is metadata, never a result.
softlist_rows("${CHECK}" check_lines)
set(check_ids "")
foreach(line IN LISTS check_lines)
  string(REPLACE "," ";" f "${line}")
  list(LENGTH f n)
  list(GET f 0 id)
  if(NOT n EQUAL 16)
    message(FATAL_ERROR "softlist_ledger: ${id}: ${n} fields, not 16")
  endif()
  if(id MATCHES "/")
    continue()
  endif()
  list(APPEND check_ids "${id}")
  list(GET f 10 status)
  if(NOT status MATCHES "^(unknown|skipped|unsupported)$")
    message(FATAL_ERROR "softlist_ledger: ${id}: a pinned-list row is ${status}; "
      "metadata is never a pass")
  endif()
  set(column 12)
  foreach(name evidence_commit evidence oracle checked)
    list(GET f ${column} value)
    if(NOT value STREQUAL "-")
      message(FATAL_ERROR "softlist_ledger: ${id}: a pinned-list row has ${name} '${value}'; "
        "metadata is never a pass")
    endif()
    math(EXPR column "${column} + 1")
  endforeach()
endforeach()

# Every id the pin gained or lost is named, not only the first.
set(problems "")
foreach(id IN LISTS ids)
  list(FIND check_ids "${id}" at)
  if(at EQUAL -1)
    string(APPEND problems "\nsoftlist_ledger: ${id}: entry has no row in ${CHECK}")
  endif()
endforeach()
foreach(id IN LISTS check_ids)
  list(FIND ids "${id}" at)
  if(at EQUAL -1)
    string(APPEND problems "\nsoftlist_ledger: ${id}: row has no entry in the pinned list")
  endif()
endforeach()
list(LENGTH check_ids check_count)
if(NOT check_count EQUAL entry_count)
  string(APPEND problems "\nsoftlist_ledger: ${CHECK} has ${check_count} pinned-list rows, "
    "the list has ${entry_count} entries")
endif()
if(NOT problems STREQUAL "")
  message(FATAL_ERROR "${problems}")
endif()

file(READ "${OUT}" written)
file(READ "${CHECK}" expected)
if(NOT written STREQUAL expected)
  message(FATAL_ERROR "softlist_ledger: ${CHECK} differs from the generator output; regenerate it with\n"
    "  cmake -DXML=${XML} -DLEDGER=${LEDGER} -DCARTDB=${CARTDB} -DOUT=${CHECK} "
    "-P tools/softlist_ledger.cmake")
endif()
message(STATUS "softlist_ledger: ${entry_count} pinned-list rows equal the generator output")
