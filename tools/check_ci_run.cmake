# Inspect a saved `gh run view --json attempt,status,conclusion,headSha,url,jobs` response.
# Fault prevented: reporting one failed check as the run's only failure, or
# accepting another source, incomplete run or missing required aggregate.
cmake_minimum_required(VERSION 3.25)
foreach(var INPUT EXPECTED_SHA)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "ci_run: -D${var} is required")
  endif()
endforeach()
string(LENGTH "${EXPECTED_SHA}" length)
if(NOT length EQUAL 40 OR NOT EXPECTED_SHA MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "ci_run: EXPECTED_SHA must be a full commit SHA")
endif()
file(READ "${INPUT}" run)
set(faults "")

function(ci_run_get out expected)
  string(JSON kind ERROR_VARIABLE error TYPE "${run}" ${ARGN})
  if(error OR NOT kind MATCHES "^(${expected})$")
    list(JOIN ARGN "." field)
    list(APPEND faults "${field} must be ${expected}")
    set(faults "${faults}" PARENT_SCOPE)
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  string(JSON value GET "${run}" ${ARGN})
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

ci_run_get(head STRING headSha)
ci_run_get(attempt NUMBER attempt)
ci_run_get(url STRING url)
ci_run_get(status STRING status)
ci_run_get(conclusion "STRING|NULL" conclusion)
ci_run_get(jobs ARRAY jobs)
message(STATUS "ci_run: source ${head}; attempt ${attempt}; status ${status}/${conclusion}; ${url}")
if(NOT attempt MATCHES "^[1-9][0-9]*$")
  list(APPEND faults "attempt must be a positive integer")
endif()
if(NOT head STREQUAL EXPECTED_SHA)
  list(APPEND faults "source mismatch: expected ${EXPECTED_SHA}, got ${head}")
endif()
if(NOT url MATCHES "^https://[^/]+/[^/]+/[^/]+/actions/runs/[0-9]+$")
  list(APPEND faults "invalid run URL")
endif()
if(NOT status STREQUAL "completed")
  list(APPEND faults "run is not completed")
elseif(conclusion STREQUAL "")
  list(APPEND faults "completed run has no conclusion")
endif()
set(required_count 0)
if(NOT jobs STREQUAL "")
  string(JSON count LENGTH "${jobs}")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(i RANGE 0 ${last})
      ci_run_get(name STRING jobs ${i} name)
      ci_run_get(job_status STRING jobs ${i} status)
      ci_run_get(result "STRING|NULL" jobs ${i} conclusion)
      # Collect every non-success before deciding. The aggregate owns the
      # required/advisory distinction; a failed report-only job stays visible.
      if(NOT job_status STREQUAL "completed" OR NOT result STREQUAL "success")
        message(STATUS "ci_run: job ${name}: ${job_status}/${result}")
      endif()
      if(name STREQUAL "" OR name MATCHES "[\r\n]")
        list(APPEND faults "invalid job name at index ${i}")
      endif()
      if(NOT job_status MATCHES "^(queued|in_progress|completed|waiting|pending|requested)$")
        list(APPEND faults "invalid job status for ${name}")
      elseif(NOT job_status STREQUAL "completed")
        list(APPEND faults "nonterminal job ${name}")
      elseif(result STREQUAL "")
        list(APPEND faults "completed job ${name} has no conclusion")
      endif()
      if(name STREQUAL "CI required")
        math(EXPR required_count "${required_count}+1")
        if(NOT job_status STREQUAL "completed" OR NOT result STREQUAL "success")
          list(APPEND faults "required aggregate is not completed/success")
        endif()
      endif()
    endforeach()
  endif()
endif()
if(NOT required_count EQUAL 1)
  list(APPEND faults "expected exactly one CI required job, got ${required_count}")
endif()
if(faults)
  list(JOIN faults "\n  " faults)
  message(FATAL_ERROR "ci_run:\n  ${faults}")
endif()
message(STATUS "ci_run: required checks passed; other job outcomes are reported above")
