# Copy to .env.local (gitignored). Local-only values that never leave this
# machine; CI uses GitHub Actions variables and secrets instead.

# Folder of your own cartridge dumps for the local-only `library` test preset.
MUHTARI_ROM_DIR=

# Folder holding your own Atari BIOS dump, for `--boot bios` with the real BIOS.
# Optional: the default boot needs no BIOS, and CI uses the CC0 OpenBIOS.
MUHTARI_BIOS_DIR=

